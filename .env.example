# Copy this file to .env and set local values. Never commit the real .env.
PORT=3000
NODE_ENV=development
PGHOST=localhost
PGPORT=5432
PGDATABASE=nuclea_erp
PGUSER=postgres
PGPASSWORD=CHANGE_ME_TO_YOUR_LOCAL_POSTGRES_PASSWORD
SESSION_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
# Optional if using a hosted database instead of individual PG* values:
# DATABASE_URL=postgresql://user:password@host:5432/database
# PGSSLMODE=require
TRUST_PROXY=false
