<%- include('../partials/header', { title: 'Customer CRM | Nuclea ERP' }) %>
<%- include('../partials/sidebar', { page: 'customer' }) %>

<div class="app-wrapper">
    <%- include('../partials/headbar') %>

    <main class="app-main">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold text-dark mb-1">Customer Database & SLA</h4>
                <span class="text-muted small">Based on IMS.SC.007 Appendix 1: Customer Database.</span>
            </div>
            <button class="btn btn-dark fw-bold shadow-sm hover-elevate">
                <i class="bi bi-hospital me-2 text-warning"></i> Register Client
            </button>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="card shadow-sm border-0 border-start border-primary border-4 hover-elevate h-100">
                    <div class="card-body p-4 d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 text-primary rounded p-3 me-3"><i class="bi bi-hospital fs-3"></i></div>
                        <div>
                            <span class="d-block text-muted fw-bold small text-uppercase mb-1">Total Active Clients</span>
                            <h3 class="fw-bolder text-dark mb-0">8 <span class="fs-6 text-muted fw-normal">Hospitals</span></h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 border-start border-success border-4 hover-elevate">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-enterprise mb-0" id="crmTable">
                        <thead>
                            <tr>
                                <th class="ps-4">Client Name & ID</th>
                                <th>Routing Area</th>
                                <th>Contact PIC</th>
                                <th class="text-end">Contract Price (mCi)</th>
                                <th class="text-center">Status</th>
                                <th class="pe-4 text-end">360° View</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="ps-4">
                                    <span class="d-block fw-bold text-dark fs-6">RS Mitra Plumbon</span>
                                    <span class="badge bg-light text-muted border mt-1">C-RSMP-01</span>
                                </td>
                                <td>
                                    <span class="d-block small text-dark fw-bold"><i class="bi bi-geo-alt text-danger me-1"></i> Rute 3 (Jabar)</span>
                                    <span class="small text-muted">Cirebon</span>
                                </td>
                                <td><span class="small text-dark fw-medium"><i class="bi bi-person me-1"></i> Dr. Andi (Kedokteran Nuklir)</span></td>
                                <td class="text-end fw-bolder text-primary fs-6">Rp 800.000</td>
                                <td class="text-center"><span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2">ACTIVE</span></td>
                                <td class="pe-4 text-end">
                                    <button class="btn btn-sm btn-dark fw-bold hover-elevate"><i class="bi bi-eye text-warning"></i> Detail</button>
                                </td>
                            </tr>
                            <tr>
                                <td class="ps-4">
                                    <span class="d-block fw-bold text-dark fs-6">RS Kariadi Semarang</span>
                                    <span class="badge bg-light text-muted border mt-1">C-RSK-02</span>
                                </td>
                                <td>
                                    <span class="d-block small text-dark fw-bold"><i class="bi bi-geo-alt text-info me-1"></i> Rute 1 (Jateng)</span>
                                    <span class="small text-muted">Semarang</span>
                                </td>
                                <td><span class="small text-dark fw-medium"><i class="bi bi-person me-1"></i> Bpk. Budi (Farmasi)</span></td>
                                <td class="text-end fw-bolder text-primary fs-6">Rp 750.000</td>
                                <td class="text-center"><span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2">ACTIVE</span></td>
                                <td class="pe-4 text-end">
                                    <button class="btn btn-sm btn-dark fw-bold hover-elevate"><i class="bi bi-eye text-warning"></i> Detail</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</div>

<script>document.addEventListener('DOMContentLoaded', () => { const t = document.getElementById('crmTable'); if(t) new simpleDatatables.DataTable(t); });</script>
<%- include('../partials/footer') %>