<%- include('../partials/header', { title: 'Inventory Management & QA | Nuclea ERP' }) %>
<%- include('../partials/sidebar', { page: 'inventory' }) %>

<div class="app-wrapper">
    <%- include('../partials/headbar') %>

    <main class="app-main">
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card shadow-sm border-0 border-start border-primary border-4 hover-elevate h-100 bg-white">
                    <div class="card-body p-3 d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 text-primary rounded p-3 me-3"><i class="bi bi-cash-stack fs-4"></i></div>
                        <div>
                            <span class="d-block text-muted fw-bold small text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.5px;">Est. Inventory Value</span>
                            <h4 class="fw-bolder text-dark mb-0">Rp 4.2<span class="fs-6 text-muted fw-normal">B</span></h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 border-start border-danger border-4 hover-elevate h-100 bg-white">
                    <div class="card-body p-3 d-flex align-items-center">
                        <div class="bg-danger bg-opacity-10 text-danger rounded p-3 me-3"><i class="bi bi-exclamation-octagon fs-4"></i></div>
                        <div>
                            <span class="d-block text-muted fw-bold small text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.5px;">MRP: Below Min. Stock</span>
                            <h4 class="fw-bolder text-dark mb-0">2 <span class="fs-6 text-muted fw-normal">Items</span></h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 border-start border-warning border-4 hover-elevate h-100 bg-white">
                    <div class="card-body p-3 d-flex align-items-center">
                        <div class="bg-warning bg-opacity-10 text-warning rounded p-3 me-3"><i class="bi bi-shield-lock fs-4"></i></div>
                        <div>
                            <span class="d-block text-muted fw-bold small text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.5px;">QA Quarantine</span>
                            <h4 class="fw-bolder text-dark mb-0"><%= grBatches ? grBatches.filter(b => b.status === 'QUARANTINE').length : 0 %> <span class="fs-6 text-muted fw-normal">Batches</span></h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 border-start border-success border-4 hover-elevate h-100 bg-white">
                    <div class="card-body p-3 d-flex align-items-center">
                        <div class="bg-success bg-opacity-10 text-success rounded p-3 me-3"><i class="bi bi-arrow-repeat fs-4"></i></div>
                        <div>
                            <span class="d-block text-muted fw-bold small text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.5px;">Turnover Rate (YTD)</span>
                            <h4 class="fw-bolder text-dark mb-0">8.4<span class="fs-6 text-muted fw-normal">x</span></h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <ul class="nav nav-tabs nav-tabs-enterprise bg-white rounded-top border-bottom px-4 pt-2 shadow-sm" id="inventoryTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-bold" id="masterlist-tab" data-bs-toggle="tab" data-bs-target="#masterlist" type="button" role="tab" aria-controls="masterlist" aria-selected="true">
                    <i class="bi bi-boxes me-2"></i> 1. Material Masterlist
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold" id="quarantine-tab" data-bs-toggle="tab" data-bs-target="#quarantine" type="button" role="tab" aria-controls="quarantine" aria-selected="false">
                    <i class="bi bi-shield-exclamation me-2"></i> 2. QA Quarantine & Inspection Lots (IMS.SC.005)
                </button>
            </li>
        </ul>

        <div class="tab-content pt-3" id="inventoryTabContent">
            <!-- TAB 1: MASTERLIST -->
            <div class="tab-pane fade show active" id="masterlist" role="tabpanel" aria-labelledby="masterlist-tab">
                <div class="card shadow-sm border-0 rounded-0 rounded-bottom">
                    <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-list-columns-reverse text-primary me-2"></i> Master Data Overview & MIGO Trigger</h6>
                        <button type="button" class="btn btn-sm btn-dark fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addMaterialModal">
                            <i class="bi bi-plus-circle text-warning me-1"></i> Add Master Material
                        </button>
                    </div>
                    <div class="card-body p-4">
                        <div class="table-responsive">
                            <table class="table table-enterprise mb-0 align-middle" id="tableMaster">
                                <thead>
                                    <tr>
                                        <th class="ps-4">Material Code & Name</th>
                                        <th>Category</th>
                                        <th class="text-center">Min. Stock (MRP)</th>
                                        <th class="text-center">Unrestricted Stock</th>
                                        <th class="text-end pe-4">Goods Receipt (MIGO)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if(inventory && inventory.length > 0) { %>
                                        <% inventory.forEach(item => { %>
                                        <tr>
                                            <td class="ps-4">
                                                <span class="d-block fw-bold text-dark"><%= item.name %></span>
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary border mt-1"><%= item.material_code %></span>
                                            </td>
                                            <td><span class="small fw-medium text-muted"><%= item.category || 'General' %></span></td>
                                            <td class="text-center text-muted fw-medium"><%= item.min_stock || 0 %> <%= item.uom %></td>
                                            <td class="text-center">
                                                <% if(parseFloat(item.current_stock) <= parseFloat(item.min_stock)) { %>
                                                    <span class="badge bg-danger text-white fs-6 px-3 py-2 shadow-sm pulse-danger"><%= item.current_stock %> <%= item.uom %></span>
                                                    <div class="small text-danger fw-bold mt-1" style="font-size: 0.7rem;"><i class="bi bi-graph-down-arrow"></i> Reorder Required</div>
                                                <% } else { %>
                                                    <span class="badge bg-success text-white fs-6 px-3 py-2 shadow-sm"><%= item.current_stock %> <%= item.uom %></span>
                                                <% } %>
                                            </td>
                                            <td class="text-end pe-4">
                                                <button type="button" class="btn btn-sm btn-outline-success fw-bold hover-elevate shadow-sm" data-bs-toggle="modal" data-bs-target="#grModal" onclick="setGrMaterial('<%= item.id %>', '<%= item.material_code %>', '<%= item.name %>')">
                                                    <i class="bi bi-box-arrow-in-down me-1"></i> MIGO (SOP IMS.SC.005)
                                                </button>
                                            </td>
                                        </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr><td colspan="5" class="text-center py-5 text-muted">No material master records yet. Add a record to begin.</td></tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 2: QUARANTINE & BATCHES -->
            <div class="tab-pane fade" id="quarantine" role="tabpanel" aria-labelledby="quarantine-tab">
                <div class="card shadow-sm border-0 rounded-0 rounded-bottom border-start border-warning border-4">
                    <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-shield-lock text-warning me-2"></i> Inspection Lots & Goods Receipt (IMS.SC.005)</h6>
                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning px-3 py-2">Mandatory QA Usage Decision</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="table-responsive">
                            <table class="table table-enterprise mb-0 align-middle" id="tableBatches">
                                <thead>
                                    <tr>
                                        <th class="ps-4">GR Date & Batch No.</th>
                                        <th>Material</th>
                                        <th>Qty & Gross Weight</th>
                                        <th>Attached SOP Documents</th>
                                        <th class="text-center">QA Status</th>
                                        <th class="text-end pe-4">Usage Decision (21 CFR Pt 11)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if(typeof grBatches !== 'undefined' && grBatches.length > 0) { %>
                                        <% grBatches.forEach(batch => { %>
                                        <tr>
                                            <td class="ps-4">
                                                <span class="d-block fw-bold text-primary"><%= batch.batch_number %></span>
                                                <span class="small text-muted"><i class="bi bi-calendar-event me-1"></i> <%= new Date(batch.created_at).toLocaleDateString('en-GB') %></span>
                                            </td>
                                            <td>
                                                <span class="d-block fw-bold text-dark"><%= batch.material_name %></span>
                                                <span class="small text-muted"><%= batch.material_code %></span>
                                            </td>
                                            <td class="fw-bolder fs-6 text-dark"><%= batch.qty %> <span class="fw-normal text-muted small"><%= batch.uom %></span></td>
                                            <td>
                                                <% if(batch.gr_document) { %>
                                                    <a href="<%= batch.gr_document %>" target="_blank" class="badge bg-light text-primary border text-decoration-none me-1 mb-1 shadow-sm"><i class="bi bi-file-earmark-text text-muted me-1"></i> GR Note</a>
                                                <% } %>
                                                <% if(batch.coa_document) { %>
                                                    <a href="<%= batch.coa_document %>" target="_blank" class="badge bg-light text-primary border text-decoration-none shadow-sm"><i class="bi bi-file-earmark-pdf text-danger me-1"></i> CoA (AVL)</a>
                                                <% } %>
                                            </td>
                                            <td class="text-center">
                                                <% if(batch.status === 'QUARANTINE') { %>
                                                    <span class="badge bg-warning text-dark px-3 py-2 fw-bold"><i class="bi bi-shield-lock me-1"></i> Karantina</span>
                                                <% } else { %>
                                                    <span class="badge bg-success text-white px-3 py-2 fw-bold"><i class="bi bi-check2-circle me-1"></i> Unrestricted</span>
                                                <% } %>
                                            </td>
                                            <td class="text-end pe-4">
                                                <% if(batch.status === 'QUARANTINE') { %>
                                                    <button type="button" class="btn btn-sm btn-dark fw-bold shadow-sm hover-elevate" onclick="openQaRelease('<%= batch.id %>', '<%= batch.batch_number %>')">
                                                        <i class="bi bi-shield-check text-warning me-1"></i> QA Release
                                                    </button>
                                                <% } else { %>
                                                    <span class="small text-muted fw-medium"><i class="bi bi-person-check me-1"></i> Rel: <%= batch.released_by %></span>
                                                <% } %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr><td colspan="6" class="text-center py-5 text-muted">No goods receipts recorded.</td></tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

<!-- MODAL ADD MASTER MATERIAL -->
<div class="modal fade" id="addMaterialModal" tabindex="-1" aria-labelledby="addMaterialModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="addMaterialModalLabel"><i class="bi bi-node-plus text-warning me-2"></i> Add Master Barang</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/scm/inventory/add-master" method="POST">
                <div class="modal-body p-4 bg-light">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Kode Material</label>
                        <input type="text" name="material_code" class="form-control border-secondary" placeholder="MAT-1.02..." required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Nama Barang</label>
                        <input type="text" name="name" class="form-control border-secondary" placeholder="e.g. Enriched Water 18O" required>
                    </div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">Category</label>
                            <select name="category" class="form-select border-secondary" required>
                                <option value="Raw Material">Raw Material</option>
                                <option value="Packaging Material">Packaging Material</option>
                                <option value="Gas Industri">Gas Industri (Nitrogen/Helium/Hydrogen)</option>
                                <option value="Precursor & Reagent">Precursor & Reagent</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Satuan (UoM)</label>
                            <input type="text" name="uom" class="form-control border-secondary" placeholder="Vial/Gram/ml" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Batas Stok Min. (MRP)</label>
                            <input type="number" name="min_stock" class="form-control border-secondary" placeholder="10" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-white">
                    <button type="submit" class="btn btn-dark w-100 fw-bold">SAVE MASTER DATA</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL GOODS RECEIPT (MIGO) SESUAI SOP IMS.SC.005 -->
<div class="modal fade" id="grModal" tabindex="-1" data-bs-backdrop="static" aria-labelledby="grModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-success text-white border-bottom">
                <h5 class="modal-title fw-bold" id="grModalLabel"><i class="bi bi-box-arrow-in-down me-2"></i> Goods Receipt & Receiving Inspection (SOP IMS.SC.005)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <form action="/scm/inventory/goods-receipt" method="POST" enctype="multipart/form-data">
                <div class="modal-body p-4 bg-light">
                    <div class="alert alert-warning small fw-bold d-flex align-items-center p-3 border-warning shadow-sm mb-4">
                        <i class="bi bi-info-circle-fill fs-4 me-3 text-warning"></i>
                        Barang diterima masuk dengan status <strong>KARANTINA</strong>. Pastikan verifikasi Approved Vendor List (AVL), kesesuaian CoA, dan masa kadaluarsa ($\ge 1$ tahun untuk Material Awal) terpenuhi.
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-muted">Received Materials</label>
                            <input type="hidden" name="material_id" id="grMaterialId">
                            <input type="text" id="grMaterialName" class="form-control border-secondary fw-bold bg-white text-primary" readonly>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">Batch / Lot</label>
                            <input type="text" name="batch_number" class="form-control border-secondary" placeholder="e.g. BATCH-2026-001" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">Received Quantity</label>
                            <input type="number" step="0.01" name="quantity" class="form-control border-secondary" placeholder="100" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">Expiry Date</label>
                            <input type="date" name="expiry_date" class="form-control border-secondary" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Upload Goods Receipt Document (GR Note)</label>
                            <input type="file" name="gr_doc" class="form-control border-secondary" accept=".pdf,.jpg,.png">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Upload Sertifikat Analisis (CoA - AVL)</label>
                            <input type="file" name="coa_doc" class="form-control border-secondary" accept=".pdf,.jpg,.png" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-white">
                    <button type="button" class="btn btn-outline-secondary fw-bold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success fw-bold px-4">SAVE GOODS RECEIPT</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function setGrMaterial(id, code, name) {
        document.getElementById('grMaterialId').value = id;
        document.getElementById('grMaterialName').value = code + ' - ' + name;
    }

    function openQaRelease(batchId, batchNumber) {
        Swal.fire({
            title: 'QA Usage Decision (21 CFR Pt 11)',
            html: `<p class="small text-muted mb-3">Enter your electronic-signature PIN to release the batch <b>${batchNumber}</b> dari Karantina ke Unrestricted Stock.</p>` +
                  `<input type="password" id="qaPinInput" class="swal2-input text-center tracking-widest fw-bold" placeholder="PIN (6-digit)" maxlength="6" autofocus>`,
            confirmButtonText: 'CONFIRM QA RELEASE',
            confirmButtonColor: '#181C32',
            showCancelButton: true,
            preConfirm: () => {
                const pin = document.getElementById('qaPinInput').value;
                if (!pin) {
                    Swal.showValidationMessage('PIN Tanda Tangan Elektronik wajib diisi!');
                }
                return { pin: pin };
            }
        }).then((result) => {
            if (result.isConfirmed) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/scm/inventory/qa-release/' + batchId;
                
                const pinInput = document.createElement('input');
                pinInput.type = 'hidden';
                pinInput.name = 'pin';
                pinInput.value = result.value.pin;
                
                form.appendChild(pinInput);
                document.body.appendChild(form);
                form.submit();
            }
        });
    }
</script>

<%- include('../partials/footer') %>