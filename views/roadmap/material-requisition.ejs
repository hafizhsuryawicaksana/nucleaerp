<%- include('../partials/header', { title: 'Material Requisition | NUCLEA ERP' }) %>
<%- include('../partials/sidebar', { page }) %>
<div class="app-wrapper"><%- include('../partials/headbar') %><main class="app-main">
<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between flex-wrap align-items-center mb-4"><div><h2 class="fw-bold mb-1">Material Requisition</h2><p class="text-muted mb-0">IMS.SC.006-F-01 · Purchasing and purchase orders remain in the external purchasing system.</p></div><span class="badge text-bg-light border">Requester → SCM Staff → SCM Supervisor → Plant Manager</span></div>
  <% if(query.success){ %><div class="alert alert-success"><%= query.success %></div><% } %><% if(query.error){ %><div class="alert alert-danger"><%= query.error %></div><% } %>
  <div class="card border-0 shadow-sm mb-4" data-modalize-title="Create Material Requisition" data-modalize-button="Create Request" data-modalize-size="xl"><div class="card-header bg-white fw-bold">Create Material Requisition</div><div class="card-body"><form method="post" action="/material-requisition" enctype="multipart/form-data" id="mrForm"><div class="row g-3"><div class="col-md-4"><label class="form-label">Requester Name</label><input class="form-control" value="<%= user.full_name %>" readonly></div><div class="col-md-4"><label class="form-label">Position</label><input class="form-control" name="position" value="<%= user.role||'' %>"></div><div class="col-md-4"><label class="form-label">Department *</label><input class="form-control" name="department" value="<%= user.department||'' %>" required></div><div class="col-md-4"><label class="form-label">Request Date</label><input type="date" class="form-control" name="request_date" value="<%= new Date().toISOString().slice(0,10) %>" required></div><div class="col-md-8"><label class="form-label">Photo / CoA / supporting technical documents</label><input type="file" name="supporting_documents" class="form-control" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.txt,.csv"><div class="form-text">Maximum 3 documents.</div></div></div><hr><div class="d-flex align-items-center justify-content-between mb-2"><h6 class="fw-bold mb-0">II. Request Detail</h6><button type="button" class="btn btn-sm btn-outline-primary" onclick="addMrLine()"><i class="bi bi-plus-lg me-1"></i>Add item</button></div><div class="table-responsive"><table class="table table-bordered align-middle" id="mrLines"><thead class="table-light"><tr><th style="min-width:150px">Item Code (completed by SCM)</th><th style="min-width:190px">Item Name *</th><th style="min-width:180px">Specification / Principle</th><th style="min-width:90px">Qty *</th><th style="min-width:100px">UoM *</th><th style="min-width:220px">Justification / Purposes *</th><th></th></tr></thead><tbody><tr><td><span class="badge text-bg-light border">Completed by SCM Staff</span></td><td><input class="form-control" name="item_name" list="materialNames" required></td><td><input class="form-control" name="specification"></td><td><input type="number" min="0.001" step="any" class="form-control" name="quantity" required></td><td><input class="form-control" name="uom" required></td><td><input class="form-control" name="purpose" required></td><td><button type="button" class="btn btn-outline-danger btn-sm" onclick="this.closest('tr').remove()">×</button></td></tr></tbody></table></div><datalist id="materialNames"><% materials.forEach(m=>{ %><option value="<%= m.name %>"><% }) %></datalist><div class="alert alert-info small mb-3"><b>Notes:</b> The ERP assigns a Material Requisition reference. SCM Staff completes item codes and stock verification; the SCM Supervisor selects Process PR or Rejected. PR reference and estimated arrival are recorded after processing in the external purchasing system.</div><button class="btn btn-primary"><i class="bi bi-send me-1"></i>Send to SCM</button></form></div></div>
  <div class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="card metric-card"><div class="card-body"><div class="metric-label">Total MR</div><div class="metric-value"><%= requisitions.length %></div></div></div></div><div class="col-6 col-xl-3"><div class="card metric-card"><div class="card-body"><div class="metric-label">Awaiting SCM</div><div class="metric-value"><%= requisitions.filter(r=>['SUBMITTED','SCM_VERIFIED'].includes(r.status)).length %></div></div></div></div><div class="col-6 col-xl-3"><div class="card metric-card"><div class="card-body"><div class="metric-label">Awaiting PR / Approval</div><div class="metric-value"><%= requisitions.filter(r=>['WAITING_EXTERNAL_PURCHASING'].includes(r.status)).length %></div></div></div></div><div class="col-6 col-xl-3"><div class="card metric-card"><div class="card-body"><div class="metric-label">Approved / Closed</div><div class="metric-value"><%= requisitions.filter(r=>['APPROVED','CLOSED'].includes(r.status)).length %></div></div></div></div></div><div class="card border-0 shadow-sm"><div class="card-header"><div><strong>Material Requisition List</strong><div class="small text-muted">Search requests, requesters, departments, PR references, or filter by status.</div></div></div><div class="card-body border-bottom"><div class="row g-2"><div class="col-md-8"><input id="mrSearch" class="form-control" placeholder="Search request, requester, or department…"></div><div class="col-md-4"><select id="mrStatus" class="form-select"><option value="">All statuses</option><% [...new Set(requisitions.map(r=>r.status))].sort().forEach(st=>{ %><option value="<%= st %>"><%= st %></option><% }) %></select></div></div></div><div class="table-responsive"><table id="mrList" class="table table-hover align-middle mb-0"><thead><tr><th>MR Reference</th><th>Date</th><th>Requester / Department</th><th>Items</th><th>Status</th><th>PR / Estimasi</th><th></th></tr></thead><tbody><% requisitions.forEach(r=>{ %><tr data-mr-search="<%= (r.request_no+' '+r.requester_name+' '+r.department+' '+(r.pr_number||'')).toLowerCase() %>" data-mr-status="<%= r.status %>"><td><b><%= r.request_no %></b></td><td><%= r.request_date?new Date(r.request_date).toLocaleDateString('en-GB'):'-' %></td><td><%= r.requester_name %><br><span class="text-muted small"><%= r.department %></span></td><td><%= r.item_count %></td><td><span class="badge <%= ['APPROVED','CLOSED'].includes(r.status)?'text-bg-success':['REJECTED'].includes(r.status)?'text-bg-danger':['SUBMITTED','SCM_VERIFIED'].includes(r.status)?'text-bg-warning':'text-bg-primary' %>"><%= r.status %></span></td><td><%= r.pr_number||'—' %><br><span class="small text-muted"><%= r.estimated_arrival?new Date(r.estimated_arrival).toLocaleDateString('en-GB'):'—' %></span></td><td><div class="d-flex gap-1 flex-wrap"><a class="btn btn-sm btn-outline-primary" href="/material-requisition/<%= r.id %>">Open</a><% if(!r.pr_number && !['WAITING_EXTERNAL_PURCHASING','APPROVED','CLOSED'].includes(String(r.status).toUpperCase())){ %><form method="post" action="/material-requisition/<%= r.id %>/delete" onsubmit="const reason=prompt('Reason for deleting trial MR:', 'Data cleanup');if(!reason)return false;this.querySelector('[name=reason]').value=reason;return confirm('Permanently delete MR <%= r.request_no %>? Tindakan ini tidak dapat dibatalkan.');"><input type="hidden" name="reason" value="Data cleanup"><input type="hidden" name="requester_user_id" value="<%= r.requester_user_id %>"><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</button></form><% } %></div></td></tr><% }) %><% if(!requisitions.length){ %><tr><td colspan="7" class="text-center text-muted py-4">No material requisitions recorded.</td></tr><% } %></tbody></table></div></div>
</main></div>
<script>document.addEventListener('DOMContentLoaded',()=>{const s=document.getElementById('mrSearch'),f=document.getElementById('mrStatus');function apply(){const q=(s?.value||'').toLowerCase().trim(),st=f?.value||'';document.querySelectorAll('#mrList tbody tr[data-mr-search]').forEach(r=>r.hidden=!(r.dataset.mrSearch.includes(q)&&(!st||r.dataset.mrStatus===st)));}s?.addEventListener('input',apply);f?.addEventListener('change',apply);});function addMrLine(){const tbody=document.querySelector('#mrLines tbody');const row=tbody.querySelector('tr').cloneNode(true);row.querySelectorAll('input').forEach(i=>i.value='');row.querySelectorAll('select').forEach(s=>s.selectedIndex=0);tbody.appendChild(row);}</script>
<%- include('../partials/footer') %>
