<%- include('../partials/header', { title: 'User Management | NUCLEA ERP' }) %>
<%- include('../partials/sidebar', { page: 'roadmap-users' }) %>
<div class="app-wrapper"><%- include('../partials/headbar') %><main class="app-main">
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><div class="text-primary small fw-bold text-uppercase">Security / Governance</div><h3 class="fw-bold mb-1">User Management</h3><p class="text-muted mb-0">Manage roles and account status. Deactivation preserves relationships and audit history.</p></div><span class="badge text-bg-warning">Administrator only</span></div>
<% if(query.success){ %><div class="alert alert-success"><i class="bi bi-check-circle me-2"></i><%= query.success %></div><% } %><% if(query.error){ %><div class="alert alert-danger"><i class="bi bi-exclamation-circle me-2"></i><%= query.error %></div><% } %>
<div class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Total Accounts</div><div class="fs-2 fw-bold"><%= users.length %></div></div></div></div><div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Active Account</div><div class="fs-2 fw-bold text-success"><%= users.filter(u=>u.account_status==='ACTIVE').length %></div></div></div></div><div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Inactive Account</div><div class="fs-2 fw-bold"><%= users.filter(u=>u.account_status!=='ACTIVE').length %></div></div></div></div><div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Tanda tangan terunggah</div><div class="fs-2 fw-bold"><%= users.filter(u=>!!u.digital_signature_file_id).length %></div></div></div></div></div>
<div class="card"><div class="card-header"><div><strong>User List</strong><div class="small text-muted">Select Manage to change role or status; changes are recorded in the audit trail.</div></div><input id="userSearch" class="form-control form-control-sm" style="max-width:300px" placeholder="Search name, email, or department..."></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>User</th><th>Departemen</th><th>Role</th><th>Status</th><th>Digital Signature</th><th>Aksi</th></tr></thead><tbody id="usersTableBody"><% users.forEach(u=>{ %><tr data-search="<%= (u.full_name+' '+u.email+' '+(u.department||'')+' '+u.role).toLowerCase() %>"><td><strong><%= u.full_name %></strong><div class="small text-muted"><%= u.email %> · #<%= u.id %></div></td><td><%= u.department||'-' %></td><td><span class="badge text-bg-light border"><%= u.role %></span></td><td><span class="badge <%= u.account_status==='ACTIVE'?'text-bg-success':'text-bg-secondary' %>"><%= u.account_status %></span></td><td><% if(u.digital_signature_file_id){ %><a href="/account/digital-signature/<%= u.id %>" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pen me-1"></i>View Signature</a><% }else{ %><span class="text-muted small">Not uploaded</span><% } %></td><td><button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#userEdit-<%= u.id %>"><i class="bi bi-person-gear me-1"></i>Kelola</button></td></tr><% }) %><% if(!users.length){ %><tr><td colspan="6" class="text-center text-muted py-4">No registered accounts.</td></tr><% } %></tbody></table></div></div>
<div class="alert alert-info small mt-3"><b>Kontrol keamanan:</b> An active account cannot change its own role or deactivate itself. Do not use shared accounts. Assign roles based on actual authorization for controlled documents.</div>
<% users.forEach(u=>{ %><div class="modal fade" id="userEdit-<%= u.id %>" tabindex="-1" aria-labelledby="userEditLabel-<%= u.id %>" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div><h5 class="modal-title fw-bold" id="userEditLabel-<%= u.id %>"><%= u.full_name %></h5><div class="small text-muted"><%= u.email %> · User #<%= u.id %></div></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="row g-4"><div class="col-md-6"><h6 class="fw-bold">Edit Role</h6><form method="post" action="/user-management/<%= u.id %>/role"><label class="form-label">Role Active *</label><select name="role" class="form-select mb-3" required <%= Number(user.id)===Number(u.id)?'disabled':'' %>><% ['Pending User','System Administrator','Plant Manager','SCM Supervisor','SCM Staff','Purchasing','Finance Leader','Production Supervisor','Production Operator','QC Analyst','QC Supervisor','QA Supervisor','PPR','PPR Kepala','Driver','Commercial Staff','Maintenance'].forEach(role=>{ %><option value="<%= role %>" <%= u.role===role?'selected':'' %>><%= role %></option><% }) %></select><button class="btn btn-primary w-100" <%= Number(user.id)===Number(u.id)?'disabled':'' %>>Save Role</button><% if(Number(user.id)===Number(u.id)){ %><div class="form-text">The current session cannot change its own account role.</div><% } %></form></div><div class="col-md-6"><h6 class="fw-bold">Account Status</h6><form method="post" action="/user-management/<%= u.id %>/status"><label class="form-label">Status *</label><select class="form-select mb-3" name="account_status" required <%= Number(user.id)===Number(u.id)?'disabled':'' %>><option value="ACTIVE" <%= u.account_status==='ACTIVE'?'selected':'' %>>ACTIVE</option><option value="INACTIVE" <%= u.account_status==='INACTIVE'?'selected':'' %>>INACTIVE</option></select><button class="btn btn-outline-secondary w-100" <%= Number(user.id)===Number(u.id)?'disabled':'' %>>Update Status</button><% if(Number(user.id)===Number(u.id)){ %><div class="form-text">An active session cannot deactivate its own account.</div><% } %></form></div></div><hr><div class="small text-muted">Registered: <%= u.created_at?new Date(u.created_at).toLocaleString('en-GB'):'-' %> · Digital signature: <%= u.digital_signature_file_id?'available':'belum available' %></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button></div></div></div></div><% }) %>
<script>document.addEventListener('DOMContentLoaded',()=>{const s=document.getElementById('userSearch');if(s)s.addEventListener('input',()=>{const q=s.value.toLowerCase().trim();document.querySelectorAll('#usersTableBody tr[data-search]').forEach(r=>r.hidden=!r.dataset.search.includes(q));});});</script>
</main></div><%- include('../partials/footer') %>
