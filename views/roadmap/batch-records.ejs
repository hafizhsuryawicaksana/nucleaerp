<%- include('../partials/header', { title: 'Manufacturing / Batch Record | NUCLEA ERP' }) %>
<%- include('../partials/sidebar', { page: 'roadmap-batch-records' }) %>
<div class="app-wrapper"><%- include('../partials/headbar') %><main class="app-main">
<div class="mb-4"><h3 class="fw-bold mb-1">Batch Record — Live Tracking</h3><div class="text-muted"></div></div>
<% if(query.error){ %><div class="alert alert-danger"><%= query.error %></div><% } %>
<div class="alert alert-info"><strong>Selectan template BMR:</strong> Citrate; Duo Citrate First Run; Duo Citrate Second Run. <strong>BPR:</strong> One IMS.QA-BPR.006 template for Citrate Cassette. QA must confirm the revision and effective copy before go-live.</div>
<div class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="card metric-card h-100"><div class="card-body"><div class="metric-label">Batch siap diisi</div><div class="metric-value"><%= batches.filter(b=>b.execution_status==='EXECUTED'&&!b.bmr_id).length %></div></div></div></div><div class="col-6 col-xl-3"><div class="card metric-card h-100"><div class="card-body"><div class="metric-label">BMR berjalan</div><div class="metric-value"><%= batches.filter(b=>b.bmr_id&&! ['SUBMITTED_FOR_REVIEW','COMPLETE'].includes(b.bmr_status)).length %></div></div></div></div><div class="col-6 col-xl-3"><div class="card metric-card h-100"><div class="card-body"><div class="metric-label">BPR berjalan</div><div class="metric-value"><%= batches.filter(b=>b.bpr_id&&! ['SUBMITTED_FOR_REVIEW','COMPLETE'].includes(b.bpr_status)).length %></div></div></div></div><div class="col-6 col-xl-3"><div class="card metric-card h-100"><div class="card-body"><div class="metric-label">Awaiting QA</div><div class="metric-value"><%= batches.filter(b=>b.bmr_status==='SUBMITTED_FOR_REVIEW'||b.bpr_status==='SUBMITTED_FOR_REVIEW').length %></div></div></div></div></div><div class="card"><div class="card-header"><div><strong>Executed Batch List</strong><div class="small text-muted"><%= batches.length %> batch</div></div></div><div class="card-body border-bottom"><input class="form-control" id="batchRecordSearch" placeholder="Search batch, Work Order, customer, produk…"></div><div class="table-responsive"><table id="batchRecordTable" class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Batch / Work Order</th><th>Customer</th><th>Ordered Activity</th><th>Calibration Time</th><th>Concentration</th><th>BMR Status</th><th>BPR Status</th><th>Action</th></tr></thead><tbody>
<% batches.forEach(b=>{ %><tr data-record-search="<%= (b.batch_id+' '+b.work_order_no+' '+b.product_name+' '+(b.customer_names||'')).toLowerCase() %>"><td><div class="fw-bold"><%= b.batch_id %></div><div class="small text-muted"><%= b.product_name %></div><div class="small text-muted"><%= b.production_date ? new Date(b.production_date).toLocaleDateString('en-GB') : '-' %></div></td><td><%= b.customer_names || '-' %></td><td><%= Number(b.ordered_activity||0).toLocaleString('en-GB') %> mCi</td><td><%= b.calibration_time ? new Date(b.calibration_time).toLocaleString('en-GB') : '-' %></td><td><%= b.concentration_mci_ml ?? '-' %> mCi/mL<br><%= b.concentration_mbq_ml ?? '-' %> MBq/mL</td><td><span class="badge <%= ['SUBMITTED_FOR_REVIEW','COMPLETE'].includes(b.bmr_status)?'text-bg-success':b.bmr_status?'text-bg-warning':'text-bg-secondary' %>"><%= b.bmr_status || 'NOT STARTED' %></span><% if(b.bmr_template){ %><div class="small text-muted"><%= b.bmr_template %></div><% } %></td><td><span class="badge <%= ['SUBMITTED_FOR_REVIEW','COMPLETE'].includes(b.bpr_status)?'text-bg-success':b.bpr_status?'text-bg-warning':'text-bg-secondary' %>"><%= b.bpr_status || 'NOT STARTED' %></span></td><td style="min-width:300px">
<% if(!b.bmr_id && canFill && b.execution_status==='EXECUTED'){ %><form method="POST" action="/manufacturing/batch-records/<%= encodeURIComponent(b.batch_id) %>/start" class="d-flex gap-2 mb-2" data-popup-form-title="Start BMR — <%= b.batch_id %>" data-popup-form-button="Fill BMR" data-popup-form-size="md"><input type="hidden" name="record_type" value="BMR"><select name="template_code" class="form-select form-select-sm" required><option value="">Select BMR</option><% templates.forEach(t=>{ %><option value="<%= t.code %>"><%= t.title %></option><% }) %></select><button class="btn btn-sm btn-primary text-nowrap">Fill BMR</button></form><% } else if(b.bmr_id && !['SUBMITTED_FOR_REVIEW','COMPLETE'].includes(b.bmr_status) && canFill){ %><a class="btn btn-sm btn-primary mb-2" href="/manufacturing/batch-records/<%= encodeURIComponent(b.batch_id) %>/fill/<%= b.bmr_id %>">Continue BMR</a><% } else if(b.bmr_id){ %><a class="btn btn-sm btn-outline-primary mb-2" href="/manufacturing/batch-records/<%= encodeURIComponent(b.batch_id) %>/print/<%= b.bmr_id %>" target="_blank">Print BMR</a><% } %>
<% if(!b.bpr_id && canFill && b.execution_status==='EXECUTED'){ %><form method="POST" action="/manufacturing/batch-records/<%= encodeURIComponent(b.batch_id) %>/start" data-popup-form-title="Start BPR — <%= b.batch_id %>" data-popup-form-button="Fill BPR (standard)" data-popup-form-size="md"><input type="hidden" name="record_type" value="BPR"><input type="hidden" name="template_code" value="BPR_CITRATE"><button class="btn btn-sm btn-outline-primary">Fill BPR (standard)</button></form><% } else if(b.bpr_id && !['SUBMITTED_FOR_REVIEW','COMPLETE'].includes(b.bpr_status) && canFill){ %><a class="btn btn-sm btn-outline-primary" href="/manufacturing/batch-records/<%= encodeURIComponent(b.batch_id) %>/fill/<%= b.bpr_id %>">Continue BPR</a><% } else if(b.bpr_id){ %><a class="btn btn-sm btn-outline-primary" href="/manufacturing/batch-records/<%= encodeURIComponent(b.batch_id) %>/print/<%= b.bpr_id %>" target="_blank">Print BPR</a><% } %>
</td></tr><% }) %>
<% if(!batches.length){ %><tr><td colspan="8" class="text-center text-muted py-5">No executed batches. Complete Production Execution first.</td></tr><% } %>
</tbody></table></div></div>
</main></div><script>document.addEventListener('DOMContentLoaded',()=>{const s=document.getElementById('batchRecordSearch');s?.addEventListener('input',()=>{const q=s.value.toLowerCase().trim();document.querySelectorAll('#batchRecordTable tbody tr[data-record-search]').forEach(r=>r.hidden=!r.dataset.recordSearch.includes(q));});});</script><%- include('../partials/footer') %>
