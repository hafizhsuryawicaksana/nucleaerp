<%- include('../partials/header', { title: 'Inventory & Goods Receipt | NUCLEA ERP' }) %>
<%- include('../partials/sidebar', { page: 'roadmap-inventory' }) %>
<div class="app-wrapper"><%- include('../partials/headbar') %><main class="app-main">
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><div class="text-primary small fw-bold text-uppercase">Supply Chain / Warehouse</div><h3 class="fw-bold mb-1">Inventory</h3><p class="text-muted mb-0">Materials, receipts, QC release, and lot-level stock.</p></div><div class="d-flex flex-wrap gap-2"><% if(canSCM){ %><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#materialsMasterModal"><i class="bi bi-plus-circle me-1"></i>Add Material</button><button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#goodsReceiptModal"><i class="bi bi-box-arrow-in-down me-1"></i>Goods Receipt</button><% } %></div></div>
<% if(query.error){ %><div class="alert alert-danger"><i class="bi bi-exclamation-circle me-2"></i><%= query.error %></div><% } %><% if(query.success){ %><div class="alert alert-success"><i class="bi bi-check-circle me-2"></i><%= query.success %></div><% } %>
<div class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Active Materials</div><div class="fs-2 fw-bold"><%= materials.filter(m=>m.is_active!==false).length %></div></div></div></div><div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Lots Awaiting QC Release</div><div class="fs-2 fw-bold"><%= lots.filter(l=>['QUARANTINE','QC_INSPECTED_PASS'].includes(l.status)).length %></div></div></div></div><div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Failed QC Lots</div><div class="fs-2 fw-bold text-danger"><%= lots.filter(l=>l.status==='QC_INSPECTED_FAIL').length %></div></div></div></div><div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Below Minimum Stock</div><div class="fs-2 fw-bold text-warning"><%= materials.filter(m=>m.is_active!==false && Number(m.released_stock||0)<Number(m.min_stock||0)).length %></div></div></div></div></div>
<div class="card mb-4"><div class="card-header"><div><strong>Material Masterlist</strong><div class="small text-muted">Select View Batch to review lots and record stock issues.</div></div><span class="small text-muted"><%= materials.length %> materials</span></div><div class="card-body border-bottom"><div class="row g-2"><div class="col-md-8"><input id="inventorySearch" class="form-control" placeholder="Search code, name, category, or location…"></div><div class="col-md-4"><select id="inventoryStatus" class="form-select"><option value="">All statuses</option><option value="ACTIVE">Active</option><option value="ARCHIVED">Archived</option><option value="LOW">Below minimum</option></select></div></div></div><div class="table-responsive"><table id="inventoryMasterTable" class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Material Code / Name</th><th>Category / Material</th><th>Available Stock</th><th>Minimum</th><th>Quarantine</th><th>Location</th><th>Status</th><th class="action-column">Actions</th></tr></thead><tbody>
<% materials.forEach(m=>{ const mlots=lots.filter(l=>Number(l.material_id)===Number(m.id)); %><tr data-inventory-search="<%= (m.material_code+' '+m.name+' '+(m.category||'')+' '+(m.storage_location||'')).toLowerCase() %>" data-inventory-status="<%= m.is_active===false?'ARCHIVED':(Number(m.released_stock||0)<Number(m.min_stock||0)?'LOW':'ACTIVE') %>"><td><strong><%= m.material_code %></strong><div><%= m.name %></div><div class="small text-muted"><%= m.uom||'-' %></div></td><td><%= m.category||'-' %><div class="small text-muted"><%= m.material_type||'-' %></div></td><td><strong class="<%= Number(m.released_stock||0)<Number(m.min_stock||0)?'text-danger':'text-success' %>"><%= Number(m.released_stock||0).toLocaleString('en-GB') %></strong></td><td><%= Number(m.min_stock||0).toLocaleString('en-GB') %></td><td><%= m.quarantine_lots||0 %></td><td><%= m.storage_location||'-' %></td><td><span class="badge <%= m.is_active===false?'text-bg-secondary':'text-bg-success' %>"><%= m.is_active===false?'ARCHIVED':'ACTIVE' %></span></td><td class="action-column"><button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#materialsLots-<%= m.id %>"><i class="bi bi-layers me-1"></i>View Batch (<%= mlots.length %>)</button><% if(canSCM){ %><form class="d-inline" method="post" action="/inventory/materials/<%= m.id %>/<%= m.is_active===false?'restore':'archive' %>" onsubmit="return confirm('<%= m.is_active===false?'Reactivate':'Deactivate this material? Data will be retained.' %>');"><button class="btn btn-sm <%= m.is_active===false?'btn-outline-success':'btn-outline-secondary' %> mt-1"><%= m.is_active===false?'Reactivate':'Deactivate' %></button></form><form class="d-inline" method="post" action="/inventory/materials/<%= m.id %>/delete" onsubmit="const reason=prompt('Reason for permanent permanent deletion:','Data cleanup');if(!reason)return false;this.querySelector('[name=reason]').value=reason;return confirm('PERMANENTLY DELETE material <%= m.material_code %> — <%= m.name %> and unreferenced trial lots? This cannot be undone.');"><input type="hidden" name="reason" value=""><button class="btn btn-sm btn-outline-danger mt-1"><i class="bi bi-trash me-1"></i>Delete</button></form><% } %></td></tr><% }) %>
<% if(!materials.length){ %><tr><td colspan="8" class="text-center text-muted py-4">No materials found.</td></tr><% } %></tbody></table></div></div>
<div class="card mb-4"><div class="card-header"><div><strong>Batch / Lot Register & QC</strong><div class="small text-muted"></div></div><span class="small text-muted"><%= lots.length %> latest lots</span></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Material / Lot</th><th>Received</th><th>Lot Balance</th><th>Expiry Date</th><th>Status</th><th>Documents</th><th style="min-width:250px">QC Actions</th></tr></thead><tbody>
<% lots.forEach(l=>{ const coa=files.find(f=>f.owner_type==='MATERIAL_BATCH'&&f.owner_id===String(l.id)&&f.document_type==='COA'); const gr=files.find(f=>f.owner_type==='MATERIAL_BATCH'&&f.owner_id===String(l.id)&&f.document_type==='GOODS_RECEIPT'); %><tr><td><strong><%= l.material_code %> — <%= l.material_name %></strong><div class="small text-muted">Lot <%= l.batch_number %> · Analysis <%= l.analysis_no||'-' %></div></td><td><%= Number(l.qty||0).toLocaleString('en-GB') %> <%= l.uom||'' %></td><td><strong><%= Number(l.qty_remaining??l.qty??0).toLocaleString('en-GB') %> <%= l.uom||'' %></strong></td><td><%= l.expiry_date?new Date(l.expiry_date).toLocaleDateString('en-GB'):'-' %></td><td><span class="badge <%= ['UNRESTRICTED','RELEASED'].includes(l.status)?'text-bg-success':l.status==='QC_INSPECTED_FAIL'?'text-bg-danger':'text-bg-warning' %>"><%= l.status %></span></td><td><% if(gr){ %><a class="d-block small" href="/roadmap/files/<%= gr.id %>" target="_blank" rel="noopener">Goods Receipt doc</a><% } %><% if(coa){ %><a class="d-block small" href="/roadmap/files/<%= coa.id %>" target="_blank" rel="noopener">CoA</a><% }else if(!l.coa_document){ %><span class="small text-danger">CoA missing</span><% } %></td><td>
<% if(canQC&&l.status==='QUARANTINE'){ %><form method="post" action="/inventory/quarantine/<%= l.id %>/inspect" class="border rounded p-2 mb-2"><label class="small fw-bold">QC Inspection</label><select class="form-select form-select-sm mb-2" name="inspection_result" required><option value="">Select result</option><option value="PASS">PASS / acceptable</option><option value="FAIL">FAIL / reject</option></select><input class="form-control form-control-sm mb-2" name="notes" placeholder="Inspection notes / document details"><button class="btn btn-sm btn-outline-primary w-100">Save Inspection</button></form><% } %>
<% if(canRelease&&l.status==='QC_INSPECTED_PASS'){ %><form method="post" action="/inventory/quarantine/<%= l.id %>/release" class="border rounded p-2"><label class="small fw-bold">QC Supervisor Release</label><input class="form-control form-control-sm mb-2" name="pin" type="password" placeholder="PIN e-signature" required><input class="form-control form-control-sm mb-2" name="notes" placeholder="Release notes"><button class="btn btn-sm btn-success w-100" onclick="return confirm('Release this lot and add its balance to inventory?');">Approve QC Release</button></form><% } %>
<% if(l.status==='QC_INSPECTED_FAIL'){ %><span class="small text-danger">Lot failed inspection.</span><% } %></td></tr><% }) %>
<% if(!lots.length){ %><tr><td colspan="7" class="text-center text-muted py-4">No goods receipts yet.</td></tr><% } %></tbody></table></div></div>

<!-- Create master materials modal -->
<div class="modal fade" id="materialsMasterModal" tabindex="-1" aria-labelledby="materialsMasterModalLabel" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><form method="post" action="/inventory/materials"><div class="modal-header"><h5 class="modal-title fw-bold" id="materialsMasterModalLabel">Add Material</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="alert alert-info small"></div><div class="row g-3"><div class="col-md-6"><label class="form-label">Material Code *</label><input class="form-control" name="material_code" required maxlength="50"></div><div class="col-md-6"><label class="form-label">Material Name *</label><input class="form-control" name="name" required></div><div class="col-md-6"><label class="form-label">Category *</label><select class="form-select" name="category" required><option value="">Select category</option><option>Raw Material</option><option>Packaging Material</option><option>Consumable</option><option>Spare Part</option><option>Supporting Material</option><option>Equipment / Tool</option><option>Other</option></select></div><div class="col-md-6"><label class="form-label">Unit of Measure (UoM) *</label><input class="form-control" name="uom" placeholder="pcs, vial, kg, mL ..." required></div><div class="col-md-6"><label class="form-label">Material Type *</label><input class="form-control" name="material_type" placeholder="Material type" required></div><div class="col-md-6"><label class="form-label">Minimum Stock</label><input class="form-control" name="min_stock" type="number" min="0" step="0.000001" value="0"></div><div class="col-md-6"><label class="form-label">Storage Location</label><input class="form-control" name="storage_location"></div><div class="col-md-6"><label class="form-label">Specifications / Description</label><input class="form-control" name="material_description"></div></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary"><i class="bi bi-save me-1"></i>Save Inventory Master</button></div></form></div></div></div>

<!-- Goods Receipt modal -->
<div class="modal fade" id="goodsReceiptModal" tabindex="-1" aria-labelledby="goodsReceiptModalLabel" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><form method="post" action="/inventory/goods-receipt" enctype="multipart/form-data"><div class="modal-header"><h5 class="modal-title fw-bold" id="goodsReceiptModalLabel">Goods Receipt — Goods Receipt</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="alert alert-warning small">Received materials are not immediately available. They remain in QUARANTINE until QC passes inspection and a supervisor performs the separate release.</div><div class="mb-3"><label class="form-label">Inventory Master *</label><select class="form-select" name="material_id" required><option value="">Select an active material master</option><% materials.filter(m=>m.is_active!==false).forEach(m=>{ %><option value="<%= m.id %>"><%= m.material_code %> — <%= m.name %></option><% }) %></select></div><div class="row g-3"><div class="col-md-6"><label class="form-label">Batch / Lot No. *</label><input class="form-control" name="batch_number" required></div><div class="col-md-6"><label class="form-label">Analysis No.</label><input class="form-control" name="analysis_no"></div><div class="col-md-6"><label class="form-label">Received Quantity *</label><input class="form-control" name="quantity" type="number" min="0.000001" step="0.000001" required></div><div class="col-md-6"><label class="form-label">Expiry Date *</label><input class="form-control" type="date" name="expiry_date" required></div><div class="col-12"><label class="form-label">Storage Location</label><input class="form-control" name="storage_location"></div><div class="col-md-6"><label class="form-label">Goods Receipt / Delivery Document</label><input type="file" class="form-control" name="gr_document" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg"></div><div class="col-md-6"><label class="form-label">CoA *</label><input type="file" class="form-control" name="coa_document" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg" required><div class="form-text">CoA is required before lot release.</div></div></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary"><i class="bi bi-box-arrow-in-down me-1"></i>Save to Quarantine</button></div></form></div></div></div>

<!-- Per-master batch-detail popups -->
<% materials.forEach(m=>{ const mlots=lots.filter(l=>Number(l.material_id)===Number(m.id)); %><div class="modal fade" id="materialsLots-<%= m.id %>" tabindex="-1" aria-labelledby="materialsLotsLabel-<%= m.id %>" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><div><h5 class="modal-title fw-bold" id="materialsLotsLabel-<%= m.id %>"><%= m.material_code %> — <%= m.name %></h5><div class="small text-muted">Sub-item Register · <%= mlots.length %> lots shown · UoM <%= m.uom||'-' %></div></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="row g-3 mb-3"><div class="col-md-3"><div class="border rounded p-3"><div class="small text-muted">Available</div><div class="fs-4 fw-bold"><%= Number(m.released_stock||0).toLocaleString('en-GB') %> <%= m.uom||'' %></div></div></div><div class="col-md-3"><div class="border rounded p-3"><div class="small text-muted">Minimum Stock</div><div class="fs-4 fw-bold"><%= Number(m.min_stock||0).toLocaleString('en-GB') %></div></div></div><div class="col-md-3"><div class="border rounded p-3"><div class="small text-muted">Category</div><div class="fw-bold"><%= m.category||'-' %></div></div></div><div class="col-md-3"><div class="border rounded p-3"><div class="small text-muted">Master Status</div><span class="badge <%= m.is_active===false?'text-bg-secondary':'text-bg-success' %>"><%= m.is_active===false?'ARCHIVED':'ACTIVE' %></span></div></div></div><div class="table-responsive"><table class="table table-hover align-middle"><thead class="table-light"><tr><th>Batch / Lot</th><th>Analysis No.</th><th>Qty Received</th><th>Current Balance</th><th>Expiry</th><th>Storage</th><th>QC Status</th><th>Actions</th></tr></thead><tbody><% mlots.forEach(l=>{ %><tr><td><strong><%= l.batch_number %></strong></td><td><%= l.analysis_no||'-' %></td><td><%= Number(l.qty||0).toLocaleString('en-GB') %> <%= l.uom||m.uom||'' %></td><td><strong><%= Number(l.qty_remaining??l.qty??0).toLocaleString('en-GB') %> <%= l.uom||m.uom||'' %></strong></td><td><%= l.expiry_date?new Date(l.expiry_date).toLocaleDateString('en-GB'):'-' %></td><td><%= l.storage_location||m.storage_location||'-' %></td><td><span class="badge <%= ['UNRESTRICTED','RELEASED'].includes(l.status)?'text-bg-success':l.status==='QC_INSPECTED_FAIL'?'text-bg-danger':'text-bg-warning' %>"><%= l.status %></span></td><td><div class="d-flex flex-wrap gap-1"><button class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#lotLedger-<%= l.id %>" aria-expanded="false"><i class="bi bi-journal-text me-1"></i>Ledger</button><% if(canSCM&&['UNRESTRICTED','RELEASED'].includes(l.status)){ %><button class="btn btn-sm btn-outline-primary" data-open-after-close="#stockAdjust-<%= l.id %>">Issue / Adjust Stock</button><% }else if(['QUARANTINE','QC_INSPECTED_PASS'].includes(l.status)){ %><span class="small text-muted">Awaiting QC release</span><% } %></div></td></tr><tr class="collapse" id="lotLedger-<%= l.id %>"><td colspan="8"><div class="p-3 rounded-3" style="background:var(--kt-body-bg)"><div class="fw-bold mb-2">Inventory Ledger · <%= l.batch_number %></div><div class="table-responsive"><table class="table table-sm table-hover mb-0"><thead><tr><th>Time</th><th>Movement</th><th>Quantity (+ received / − issued)</th><th>Source / Reference</th><th>Reason</th><th>User</th></tr></thead><tbody><% const lotMovements=(movements||[]).filter(mv=>Number(mv.materials_batch_id)===Number(l.id)); lotMovements.forEach(mv=>{ %><tr><td class="small"><%= new Date(mv.occurred_at).toLocaleString('en-GB') %></td><td><span class="badge text-bg-light border"><%= mv.movement_type %></span></td><td class="fw-bold <%= Number(mv.quantity)>=0?'text-success':'text-danger' %>"><%= Number(mv.quantity)>0?'+':'' %><%= Number(mv.quantity).toLocaleString('en-GB') %> <%= mv.uom||l.uom||'' %></td><td><%= mv.source_type||'-' %> / <%= mv.source_id||'-' %></td><td><%= mv.reason||'-' %></td><td><%= mv.actor_name||'-' %></td></tr><% }) %><% if(!lotMovements.length){ %><tr><td colspan="6" class="text-center text-muted py-3">No stock movements recorded for this lot.</td></tr><% } %></tbody></table></div></div></td></tr><% }) %><% if(!mlots.length){ %><tr><td colspan="8" class="text-center text-muted py-4">No batches or lots exist for this material. Use Goods Receipt to add a lot.</td></tr><% } %></tbody></table></div><div class="alert alert-secondary small mb-0"></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button><% if(canSCM&&m.is_active!==false){ %><button class="btn btn-primary" data-open-after-close="#goodsReceiptModal">New Goods Receipt</button><% } %></div></div></div></div><% }) %>

<!-- Audited manual deduction dialogs per released lot -->
<% if(canSCM){ lots.filter(l=>['UNRESTRICTED','RELEASED'].includes(l.status)).forEach(l=>{ %><div class="modal fade" id="stockAdjust-<%= l.id %>" tabindex="-1" aria-labelledby="stockAdjustLabel-<%= l.id %>" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" action="/inventory/lots/<%= l.id %>/adjust"><div class="modal-header"><h5 class="modal-title fw-bold" id="stockAdjustLabel-<%= l.id %>">Inventory Movement — <%= l.batch_number %></h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><p class="small text-muted"><%= l.material_code %> — <%= l.material_name %><br>Available lot: <strong><%= Number(l.qty_remaining??l.qty??0).toLocaleString('en-GB') %> <%= l.uom||'' %></strong> · Expiry: <%= l.expiry_date?new Date(l.expiry_date).toLocaleDateString('en-GB'):'-' %></p><div class="mb-3"><label class="form-label">Movement Type *</label><select class="form-select" name="movement_type" required><option value="MANUAL_ISSUE">Manual issue</option><option value="ADJUSTMENT_OUT">Adjustment out</option><option value="DAMAGE">Damaged</option><option value="SAMPLE_USE">Sample use</option><option value="WRITE_OFF">Write-off</option><option value="ADJUSTMENT_IN">Adjustment in (correction only)</option></select><div class="form-text">New stock must be received through Goods Receipt, quarantine, and QC.</div></div><div class="mb-3"><label class="form-label">Movement Quantity *</label><input type="number" class="form-control" name="quantity" min="0.000001" step="0.000001" required></div><div class="mb-3"><label class="form-label">Reason *</label><textarea name="reason" class="form-control" rows="3" required placeholder="Usage, waste, or approved correction reason"></textarea></div><div class="mb-2"><label class="form-label">User PIN Confirmation *</label><input type="password" name="pin" class="form-control" inputmode="numeric" required autocomplete="current-password"></div><div class="alert alert-warning small mb-0">This action changes the balance immediately. Confirm the quantity, lot, and approved reason before submitting.</div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" onclick="return confirm('Post movement ke inventory ledger? Saldo akan berubah dan tindakan dicatat dalam audit trail.');">Post Movement</button></div></form></div></div></div><% }) %><% } %>
</main></div>
<script>document.addEventListener('DOMContentLoaded',()=>{const s=document.getElementById('inventorySearch'),f=document.getElementById('inventoryStatus');function applyInventory(){const q=(s?.value||'').toLowerCase().trim(),st=f?.value||'';document.querySelectorAll('#inventoryMasterTable tbody tr[data-inventory-search]').forEach(r=>r.hidden=!(r.dataset.inventorySearch.includes(q)&&(!st||r.dataset.inventoryStatus===st)));}s?.addEventListener('input',applyInventory);f?.addEventListener('change',applyInventory);document.querySelectorAll('[data-open-after-close]').forEach(btn=>btn.addEventListener('click',()=>{const current=btn.closest('.modal');const target=document.querySelector(btn.getAttribute('data-open-after-close'));if(!current||!target)return;current.addEventListener('hidden.bs.modal',()=>bootstrap.Modal.getOrCreateInstance(target).show(),{once:true});bootstrap.Modal.getOrCreateInstance(current).hide();}));});</script>
<%- include('../partials/footer') %>
