<%- include('../partials/header', { title: 'Manufacturing / Production Execution | NUCLEA ERP' }) %>
<%- include('../partials/sidebar', { page: 'roadmap-execution' }) %>
<div class="app-wrapper"><%- include('../partials/headbar') %><main class="app-main">
<div class="mb-4"><h3 class="fw-bold mb-1">Production Execution</h3><div class="text-muted">Batches come from Production Planning. Production enters concentration and material requirements; SCM verifies lots and issues stock.</div></div>
<% if(query.error){ %><div class="alert alert-danger"><%= query.error %></div><% } %>
<div class="row g-3 mb-4"><div class="col-md-3"><div class="card p-3"><div class="small text-muted">Work Order Active</div><div class="fs-3 fw-bold"><%= batches.filter(b=>b.wo_status==='SCHEDULED').length %></div></div></div><div class="col-md-3"><div class="card p-3"><div class="small text-muted">Awaiting SCM Material Review</div><div class="fs-3 fw-bold"><%= batches.filter(b=>b.execution_status==='PARAMETERS_DRAFTED').length %></div></div></div><div class="col-md-3"><div class="card p-3"><div class="small text-muted">Materials Issued</div><div class="fs-3 fw-bold"><%= batches.filter(b=>b.execution_status==='MATERIALS_ISSUED').length %></div></div></div><div class="col-md-3"><div class="card p-3"><div class="small text-muted">Ready Batch Record</div><div class="fs-3 fw-bold"><%= batches.filter(b=>b.execution_status==='EXECUTED').length %></div></div></div></div>
<div class="card"><div class="card-header"><div><strong>Batch Execution Queue</strong><div class="small text-muted">Source of truth: Production Planning · SCM selects materials in Open Execution</div></div><span class="small text-muted">Quick filter</span></div><div class="card-body border-bottom"><div class="row g-2"><div class="col-md-7"><input class="form-control" id="executionSearch" placeholder="Search batch, WO, customer, product…" aria-label="Search batch execution"></div><div class="col-md-5"><select class="form-select" id="executionStatusFilter"><option value="">All statuses</option><option value="PLANNED">PLANNED</option><option value="AWAITING PRODUCTION INPUT">AWAITING PRODUCTION INPUT</option><option value="PARAMETERS_DRAFTED">PARAMETERS_DRAFTED</option><option value="MATERIALS_ISSUED">MATERIALS_ISSUED</option><option value="EXECUTED">EXECUTED</option></select></div></div></div><div class="table-responsive"><table id="executionTable" class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Batch / WO No.</th><th>Customer</th><th>Ordered Activity</th><th>Calibration Time</th><th>Status</th><th>Concentration</th><th>Action</th></tr></thead><tbody>
<% batches.forEach(b=>{ const rowStatus=b.execution_status || (b.production_parameters_complete?'AWAITING PRODUCTION INPUT':'PLANNED'); %><tr data-execution-search="<%= (b.batch_id+' '+b.work_order_no+' '+b.product_name+' '+(b.customer_names||'')).toLowerCase() %>" data-execution-status="<%= rowStatus %>"><td><div class="fw-bold"><%= b.batch_id %></div><div class="small text-muted"><%= b.work_order_no %> · <%= b.product_name %></div></td><td><%= b.customer_names || '-' %></td><td><%= Number(b.ordered_activity||0).toLocaleString('en-GB') %> mCi<div class="small text-muted">Required Production: <%= Number(b.required_activity||0).toLocaleString('en-GB') %> mCi</div></td><td><%= b.calibration_time ? new Date(b.calibration_time).toLocaleString('en-GB') : '-' %></td><td><span class="badge <%= rowStatus==='EXECUTED'?'text-bg-success':rowStatus==='MATERIALS_ISSUED'?'text-bg-info':b.wo_status==='CANCELLED'?'text-bg-danger':'text-bg-warning' %>"><%= rowStatus %></span></td><td><%= b.concentration_mci_ml ?? '-' %> mCi/mL<br><%= b.concentration_mbq_ml ?? '-' %> MBq/mL</td><td><div class="d-flex flex-wrap gap-1"><a class="btn btn-sm btn-primary" href="/erp/labels?batch_id=<%= encodeURIComponent(b.batch_id) %>&label_type=VIAL"><i class="bi bi-upc-scan me-1"></i>Print Vial Label</a><a class="btn btn-sm btn-outline-primary" href="/erp/labels?batch_id=<%= encodeURIComponent(b.batch_id) %>&label_type=LEADPOT"><i class="bi bi-upc me-1"></i>Print Leadpot Label</a><a class="btn btn-sm btn-success" href="/manufacturing/execution/<%= b.id %>"><i class="bi bi-play-circle me-1"></i>Open Execution</a></div></td></tr><% }) %>
<% if(!batches.length){ %><tr><td colspan="7" class="text-center py-5 text-muted">No batches found. Schedule a batch in Production Planning first.</td></tr><% } %>
</tbody></table></div></div>
</main></div><script>document.addEventListener('DOMContentLoaded',()=>{const s=document.getElementById('executionSearch'),f=document.getElementById('executionStatusFilter');function apply(){const q=(s?.value||'').toLowerCase().trim(),st=f?.value||'';document.querySelectorAll('#executionTable tbody tr[data-execution-search]').forEach(r=>r.hidden=!(r.dataset.executionSearch.includes(q)&&(!st||r.dataset.executionStatus===st)));}s?.addEventListener('input',apply);f?.addEventListener('change',apply);});</script><%- include('../partials/footer') %>
