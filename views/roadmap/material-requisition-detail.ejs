<%- include('../partials/header', { title: 'Material Requisition Detail | NUCLEA ERP' }) %>
<%- include('../partials/sidebar', { page }) %>
<div class="app-wrapper"><%- include('../partials/headbar') %><main class="app-main">
<div class="container-fluid px-4 py-4"><a class="btn btn-sm btn-outline-secondary mb-3" href="/material-requisition">← Back to Requests</a><% if(query.success){ %><div class="alert alert-success"><%= query.success %></div><% } %><% if(query.error){ %><div class="alert alert-danger"><%= query.error %></div><% } %><div class="d-flex justify-content-between flex-wrap align-items-center mb-3"><div><h2 class="fw-bold mb-1">Material Requisition</h2><div class="text-muted">Source form: IMS.SC.006-F-01 · Created <%= new Date(request.created_at).toLocaleString('en-GB') %></div></div><span class="badge text-bg-primary"><%= request.status %></span></div>
<div class="card border-0 shadow-sm mb-4"><div class="card-body row g-3"><div class="col-md-3"><div class="text-muted small">Requester</div><b><%= request.requester_name %></b></div><div class="col-md-3"><div class="text-muted small">Position</div><b><%= request.position||'-' %></b></div><div class="col-md-3"><div class="text-muted small">Department</div><b><%= request.department %></b></div><div class="col-md-3"><div class="text-muted small">Request Date</div><b><%= request.request_date?new Date(request.request_date).toLocaleDateString('en-GB'):'-' %></b></div></div></div>
<div class="card border-0 shadow-sm mb-4"><div class="card-header bg-white fw-bold">II. Request Detail & III. Stock Verification</div><div class="table-responsive"><table class="table table-bordered align-middle mb-0"><thead class="table-light"><tr><th>Item Code</th><th>Item Name</th><th>Specification / Principle</th><th>Qty</th><th>UoM</th><th>Justification / Purposes</th><th>Availability</th><th>Location</th><th>Stock / Min</th><th>Action</th></tr></thead><tbody><% items.forEach(i=>{ %><tr><td><%= i.item_code||'-' %></td><td><b><%= i.item_name %></b></td><td><%= i.specification||'-' %></td><td><%= i.quantity %></td><td><%= i.uom %></td><td><%= i.purpose %></td><td><%= i.available===null?'Not checked':i.available?'Yes':'No' %></td><td><%= i.storage_location||'-' %></td><td><%= i.current_stock===null?'-':i.current_stock %> / <%= i.min_stock===null?'-':i.min_stock %></td><td><%= i.scm_action||'-' %></td></tr><% }) %></tbody></table></div></div>
<% if(canSCM&&!['REJECTED','APPROVED','CLOSED','WAITING_EXTERNAL_PURCHASING'].includes(request.status)){ %><div class="card border-0 shadow-sm mb-4" data-modalize-title="SCM Staff — Stock Verification" data-modalize-button="Verify Stock" data-modalize-size="xl"><div class="card-header bg-white fw-bold">SCM Staff — Stock Verification</div><div class="card-body"><form method="post" action="/material-requisition/<%= request.id %>/verify-stock"><div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Item</th><th>Actual Material Code</th><th>Action SCM Supervisor (rekomendasi)</th><th>Notes</th></tr></thead><tbody><% items.forEach(i=>{ %><tr><td><%= i.item_name %><input type="hidden" name="item_id" value="<%= i.id %>"></td><td><input class="form-control form-control-sm" name="item_code_<%= i.id %>" value="<%= i.item_code||'' %>" placeholder="Master code"></td><td><select class="form-select form-select-sm" name="action_<%= i.id %>"><option value="PROCESS_PR" <%= i.scm_action==='PROCESS_PR'?'selected':'' %>>Process PR</option><option value="REJECTED" <%= i.scm_action==='REJECTED'?'selected':'' %>>Rejected</option></select></td><td><input class="form-control form-control-sm" name="note_<%= i.id %>" value="<%= i.scm_note||'' %>"></td></tr><% }) %></tbody></table></div><button class="btn btn-primary">Save Stock Verification</button></form></div></div><% } %>
<% if(canSupervisor&&request.status==='SCM_VERIFIED'){ %><div class="card border-0 shadow-sm mb-4" data-modalize-title="SCM Supervisor — Material Requisition Decision" data-modalize-button="SCM Supervisor Decision" data-modalize-size="lg"><div class="card-header bg-white fw-bold">SCM Supervisor — Request Decision</div><div class="card-body"><form method="post" action="/material-requisition/<%= request.id %>/decision" class="row g-3"><div class="col-md-4"><label class="form-label">Decision *</label><select class="form-select" name="decision"><option value="PROCESS_PR">Process PR</option><option value="REJECTED">Rejected</option></select></div><div class="col-md-4"><label class="form-label">PR Reference (external purchasing system)</label><input class="form-control" name="pr_number" value="<%= request.pr_number||'' %>"></div><div class="col-md-4"><label class="form-label">Estimated Arrival</label><input type="date" class="form-control" name="estimated_arrival" value="<%= request.estimated_arrival?new Date(request.estimated_arrival).toISOString().slice(0,10):'' %>"></div><div class="col-12"><label class="form-label">Notes</label><textarea class="form-control" name="scm_note"><%= request.scm_note||'' %></textarea></div><div class="col-12"><button class="btn btn-primary">Save Decision</button></div></form></div></div><% } %>
<% if(canSupervisor&&request.status==='WAITING_EXTERNAL_PURCHASING'){ %><div class="card border-0 shadow-sm mb-4" data-modalize-title="Plant Manager — Material Requisition Approval" data-modalize-button="Plant Manager Approval" data-modalize-size="lg"><div class="card-header bg-white fw-bold">Plant Manager — approval</div><div class="card-body"><p>PR Reference: <b><%= request.pr_number %></b>, ETA: <b><%= request.estimated_arrival?new Date(request.estimated_arrival).toLocaleDateString('en-GB'):'-' %></b>. Purchase processing remains in the external Purchasing system.</p><form method="post" action="/material-requisition/<%= request.id %>/plant-approval"><label class="form-label">Approval Notes</label><textarea class="form-control mb-3" name="note"></textarea><button class="btn btn-success">Approve MR</button></form></div></div><% } %>
<div class="card border-0 shadow-sm"><div class="card-header bg-white fw-bold">Supporting Documents</div><div class="card-body"><% if(files.length){ files.forEach(f=>{ %><div><a href="/roadmap/files/<%= f.id %>" target="_blank"><%= f.original_name %></a> <span class="text-muted small">(<%= f.document_type %>)</span></div><% }) } else { %><span class="text-muted">No attachments.</span><% } %></div></div></main></div><%- include('../partials/footer') %>
