<%- include('../partials/header', { title: 'Governance / Security Control | NUCLEA ERP' }) %>
<%- include('../partials/sidebar', { page: 'security-control' }) %>
<div class="app-wrapper"><%- include('../partials/headbar') %><main class="app-main">
<div class="page-heading mb-4"><div><div class="eyebrow">Access governance</div><h2 class="fw-bolder mb-1">Security Control</h2><p class="page-subtitle">Manage users, roles, module permissions, and audit events.</p></div><div class="page-action-group d-flex gap-2 flex-wrap"><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createRoleModal"><i class="bi bi-shield-plus me-1"></i>Create Role</button><a class="btn btn-outline-secondary" href="/profile?tab=security"><i class="bi bi-person-lock me-1"></i>Account Security</a></div></div>
<% if(query.success){ %><div class="alert alert-success"><i class="bi bi-check-circle me-2"></i><%= query.success %></div><% } %><% if(query.error){ %><div class="alert alert-danger"><i class="bi bi-exclamation-circle me-2"></i><%= query.error %></div><% } %>
<div class="row g-3 mb-4">
 <div class="col-6 col-xl-3"><div class="card metric-card h-100"><div class="card-body"><div class="d-flex justify-content-between align-items-start"><span class="metric-label">Total users</span><span class="metric-icon"><i class="bi bi-people"></i></span></div><div class="metric-value"><%= users.length %></div><div class="small text-muted">Registered identities</div></div></div></div>
 <div class="col-6 col-xl-3"><div class="card metric-card h-100"><div class="card-body"><div class="d-flex justify-content-between align-items-start"><span class="metric-label">Active users</span><span class="metric-icon"><i class="bi bi-person-check"></i></span></div><div class="metric-value"><%= users.filter(u=>String(u.account_status||'ACTIVE').toUpperCase()==='ACTIVE').length %></div><div class="small text-muted">Accounts with active access</div></div></div></div>
 <div class="col-6 col-xl-3"><div class="card metric-card h-100"><div class="card-body"><div class="d-flex justify-content-between align-items-start"><span class="metric-label">Roles</span><span class="metric-icon"><i class="bi bi-shield-lock"></i></span></div><div class="metric-value"><%= roles.length %></div><div class="small text-muted"><%= roles.filter(r=>r.is_system===false).length %> custom role</div></div></div></div>
 <div class="col-6 col-xl-3"><div class="card metric-card h-100"><div class="card-body"><div class="d-flex justify-content-between align-items-start"><span class="metric-label">Audit events</span><span class="metric-icon"><i class="bi bi-journal-check"></i></span></div><div class="metric-value"><%= events.length %></div><div class="small text-muted">Latest 250 events shown</div></div></div></div>
</div>
<ul class="nav nav-tabs mb-3" role="tablist"><li class="nav-item"><a class="nav-link <%= (query.tab||'users')==='users'?'active':'' %>" href="/security-control?tab=users"><i class="bi bi-people me-1"></i>Users</a></li><li class="nav-item"><a class="nav-link <%= (query.tab||'users')==='roles'?'active':'' %>" href="/security-control?tab=roles"><i class="bi bi-shield-lock me-1"></i>Roles & Permissions</a></li><li class="nav-item"><a class="nav-link <%= (query.tab||'users')==='audit'?'active':'' %>" href="/security-control?tab=audit"><i class="bi bi-journal-text me-1"></i>Audit Trail</a></li></ul>
<% if((query.tab||'users')==='users'){ %>
<div class="card"><div class="card-header"><div><div class="fw-bold">User directory</div><div class="small text-muted">Roles can be assigned from built-in or custom roles. Account status controls login access.</div></div><input id="secUserSearch" class="form-control" style="max-width:300px" placeholder="Search name, email, or department…"></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>User</th><th>Department</th><th>Current Role</th><th>Status</th><th>Signature</th><th>Actions</th></tr></thead><tbody id="secUsersBody"><% users.forEach(u=>{ %><tr data-search="<%= (u.full_name+' '+u.email+' '+(u.department||'')+' '+u.role).toLowerCase() %>"><td><div class="fw-bold"><%= u.full_name %></div><div class="small text-muted"><%= u.email %> · ID <%= u.id %></div></td><td><%= u.department||'-' %></td><td><span class="badge text-bg-light border"><%= u.role %></span></td><td><span class="badge <%= String(u.account_status||'ACTIVE').toUpperCase()==='ACTIVE'?'text-bg-success':'text-bg-secondary' %>"><%= u.account_status||'ACTIVE' %></span></td><td><% if(u.digital_signature_file_id){ %><a class="btn btn-sm btn-outline-secondary" target="_blank" href="/account/digital-signature/<%= u.id %>">View</a><% }else{ %><span class="small text-muted">Not set</span><% } %></td><td><button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#secUser-<%= u.id %>"><i class="bi bi-gear me-1"></i>Manage</button></td></tr><% }) %><% if(!users.length){ %><tr><td colspan="6" class="text-center py-5 text-muted">No users found.</td></tr><% } %></tbody></table></div></div>
<% users.forEach(u=>{ %><div class="modal fade" id="secUser-<%= u.id %>" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div><h5 class="modal-title fw-bold"><%= u.full_name %></h5><div class="small text-muted"><%= u.email %></div></div><button class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="row g-4"><div class="col-md-6"><form method="post" action="/security-control/users/<%= u.id %>/role"><h6 class="fw-bold">Role assignment</h6><label class="form-label">Role</label><select name="role" class="form-select mb-3" required <%= Number(user.id)===Number(u.id)?'disabled':'' %>><% roles.forEach(r=>{ %><option value="<%= r.role_name %>" <%= u.role===r.role_name?'selected':'' %>><%= r.role_name %><%= r.is_system?' · built-in':' · custom' %></option><% }) %></select><button class="btn btn-primary w-100" <%= Number(user.id)===Number(u.id)?'disabled':'' %>>Save Role</button><% if(Number(user.id)===Number(u.id)){ %><div class="form-text">The current session cannot change its own account role.</div><% } %></form></div><div class="col-md-6"><form method="post" action="/security-control/users/<%= u.id %>/status"><h6 class="fw-bold">Account Status</h6><label class="form-label">Status</label><select name="account_status" class="form-select mb-3" required <%= Number(user.id)===Number(u.id)?'disabled':'' %>><option value="ACTIVE" <%= String(u.account_status||'ACTIVE')==='ACTIVE'?'selected':'' %>>ACTIVE</option><option value="INACTIVE" <%= String(u.account_status||'ACTIVE')==='INACTIVE'?'selected':'' %>>INACTIVE</option></select><button class="btn btn-outline-secondary w-100" <%= Number(user.id)===Number(u.id)?'disabled':'' %>>Update Status</button></form></div></div><hr><div class="small text-muted">Created: <%= u.created_at?new Date(u.created_at).toLocaleString('en-GB'):'-' %></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button></div></div></div></div><% }) %>
<% } else if(query.tab==='roles'){ %>
<div class="row g-3"><div class="col-xl-4"><div class="card h-100"><div class="card-header"><strong>Role directory</strong></div><div class="list-group list-group-flush"><% roles.forEach(r=>{ %><a class="list-group-item list-group-item-action d-flex justify-content-between align-items-start <%= String(query.role_id||'')===String(r.id)?'active':'' %>" href="/security-control?tab=roles&role_id=<%= r.id %>"><span><strong><%= r.role_name %></strong><small class="d-block <%= String(query.role_id||'')===String(r.id)?'text-white-50':'text-muted' %>"><%= r.is_system?'Built-in role':'Custom role' %> · <%= r.assigned_users %> user</small></span><i class="bi bi-chevron-right"></i></a><% }) %></div></div></div><div class="col-xl-8"><% const selectedRole=roles.find(r=>String(r.id)===String(query.role_id))||roles.find(r=>!r.is_system)||roles[0]; %><% if(selectedRole){ %><div class="card"><div class="card-header"><div><strong>Permission matrix</strong><div class="small text-muted"><%= selectedRole.role_name %> · <%= selectedRole.is_system?'Built-in role':'Custom role' %></div></div><% if(!selectedRole.is_system){ %><form method="post" action="/security-control/roles/<%= selectedRole.id %>/delete" onsubmit="return confirm('Delete custom role <%= selectedRole.role_name %>? Ensure no users are assigned to this role.');"><input type="hidden" name="reason" value="Admin removed unused custom role"><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete role</button></form><% } %></div><div class="card-body"><% if(selectedRole.is_system){ %><% } else { %><form method="post" action="/security-control/roles/<%= selectedRole.id %>/permissions"><div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Module</th><th class="text-center">View</th><th class="text-center">Create</th><th class="text-center">Edit</th><th class="text-center">Delete</th><th class="text-center">Approve</th></tr></thead><tbody><% modules.forEach(mod=>{ const rp=permissions.find(p=>Number(p.role_id)===Number(selectedRole.id)&&p.module_code===mod[0])||{}; %><tr><td><strong><%= mod[1] %></strong><div class="small text-muted"><%= mod[0] %></div></td><% ['view','create','edit','delete','approve'].forEach(cap=>{ const trackingViewLock=mod[0]==='LIVE_TRACKING'&&cap==='view'; const checked=trackingViewLock?true:rp['can_'+cap]===true; %><td class="text-center"><input class="btn-check permission-toggle-input" type="checkbox" name="perm_<%= mod[0] %>_<%= cap %>" id="perm-<%= mod[0] %>-<%= cap %>" value="1" <%= checked?'checked':'' %> <%= trackingViewLock?'disabled':'' %> autocomplete="off"><label class="btn btn-sm permission-toggle <%= checked?'btn-primary':'btn-outline-secondary' %>" for="perm-<%= mod[0] %>-<%= cap %>"><%= checked?'ON':'OFF' %></label></td><% }) %></tr><% }) %></tbody></table></div><button class="btn btn-primary"><i class="bi bi-save me-1"></i>Save Permission Matrix</button></form><% } %></div></div><% } else { %><div class="card"><div class="card-body text-muted">Create a custom role to configure access.</div></div><% } %></div></div>
<% } else { %>
<div class="card"><div class="card-header"><div><strong>Audit Trail</strong><div class="small text-muted">Recent operational events. Before/after values may contain business data and are restricted to administrators.</div></div><span class="badge text-bg-secondary"><%= events.length %> recent</span></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Time</th><th>Actor</th><th>Role</th><th>Action</th><th>Entity</th><th>Reference</th><th>Reason</th></tr></thead><tbody><% events.forEach(e=>{ %><tr><td class="small"><%= new Date(e.occurred_at).toLocaleString('en-GB') %></td><td><strong><%= e.actor_name||'-' %></strong><div class="small text-muted"><%= e.actor_user_id||'-' %></div></td><td><%= e.actor_role||'-' %></td><td><span class="badge text-bg-light border"><%= e.action %></span></td><td><%= e.entity_type %></td><td><%= e.entity_id %></td><td class="small"><%= e.reason||'-' %></td></tr><% }) %><% if(!events.length){ %><tr><td colspan="7" class="text-center text-muted py-5">No events recorded.</td></tr><% } %></tbody></table></div></div>
<% } %>
<div class="modal fade" id="createRoleModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" action="/security-control/roles/create"><div class="modal-header"><h5 class="modal-title fw-bold">Create Custom Role</h5><button class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="alert alert-info small">New roles start without module access. Assign permissions in Roles & Permissions.</div><label class="form-label">Role Name *</label><input class="form-control mb-3" name="role_name" required minlength="3" maxlength="120" placeholder="Operational Manager"><label class="form-label">Description</label><textarea class="form-control" name="description" rows="3" placeholder="Role responsibilities and access"></textarea></div><div class="modal-footer"><button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary">Create Role</button></div></form></div></div></div>
<script>document.addEventListener('DOMContentLoaded',()=>{const s=document.getElementById('secUserSearch');if(s)s.addEventListener('input',()=>{const q=s.value.toLowerCase().trim();document.querySelectorAll('#secUsersBody tr[data-search]').forEach(r=>r.hidden=!r.dataset.search.includes(q));});});</script>
</main></div><style>.permission-toggle{min-width:52px;border-radius:999px;font-weight:700;font-size:.68rem}.permission-toggle-input:checked + .permission-toggle{background:var(--bs-primary);color:#fff}.permission-toggle-input:not(:checked) + .permission-toggle{background:transparent}</style><script>document.querySelectorAll(".permission-toggle-input").forEach(i=>i.addEventListener("change",()=>{const l=document.querySelector(`label[for="${i.id}"]`);if(!l)return;l.textContent=i.checked?"ON":"OFF";l.classList.toggle("btn-primary",i.checked);l.classList.toggle("btn-outline-secondary",!i.checked);}));</script><%- include('../partials/footer') %>
