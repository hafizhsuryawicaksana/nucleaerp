<%- include('../partials/header', { title: 'Batch Execution Detail | NUCLEA ERP' }) %>
<%- include('../partials/sidebar', { page: 'roadmap-execution' }) %>
<div class="app-wrapper"><%- include('../partials/headbar') %><main class="app-main">
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4"><div><a href="/manufacturing/execution" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Production Execution</a><h3 class="fw-bold mt-2 mb-1"><%= workOrder.batch_id %></h3><div class="text-muted"><%= workOrder.product_name %> · tanggal <%= workOrder.production_date ? new Date(workOrder.production_date).toLocaleDateString('en-GB') : '-' %></div></div><span class="badge text-bg-primary fs-6"><%= execution ? execution.status : 'DRAFT' %></span></div>
<% if(query.error){ %><div class="alert alert-danger"><%= query.error %></div><% } %>
<div class="card"><div class="card-header"><strong>Customer & Ordered Activity</strong></div><div class="table-responsive"><table class="table table-sm table-hover mb-0"><thead class="table-light"><tr><th>Customer</th><th>Calibration Time</th><th>Activity @ Cal</th><th>Required Production Activity</th><th>Customer Qualification</th><th>Delivery / Vehicle</th></tr></thead><tbody><% customers.forEach(c=>{ %><tr><td><%= c.customer_name %><div class="small text-muted"><%= c.customer_code %></div></td><td><%= c.calibration_time ? new Date(c.calibration_time).toLocaleString('en-GB') : '-' %></td><td><%= c.activity_at_cal_mci ?? '-' %> mCi</td><td><%= c.required_production_activity_mci ?? '-' %> mCi</td><td><span class="badge <%= c.qualification_status==='QUALIFIED'?'text-bg-success':'text-bg-warning' %>"><%= c.qualification_status %></span></td><td><%= c.delivery_start_time ? new Date(c.delivery_start_time).toLocaleString('en-GB') : '-' %><br><span class="small text-muted"><%= c.vehicle_no || 'Armada belum ditentukan' %></span></td></tr><% }) %></tbody></table></div></div>
<div class="row g-3"><div class="col-lg-5"><div class="card h-100"><div class="card-header"><strong>Header Batch Record</strong></div><div class="card-body"><div class="row g-3"><div class="col-6"><div class="small text-muted">Concentration</div><div class="fw-bold"><%= execution?.concentration_mci_ml ?? '-' %> mCi/mL</div></div><div class="col-6"><div class="small text-muted">Concentration</div><div class="fw-bold"><%= execution?.concentration_mbq_ml ?? '-' %> MBq/mL</div></div><div class="col-12"><div class="small text-muted">Production Parameters</div><pre class="small bg-light rounded p-2 mb-0" style="white-space:pre-wrap"><%= JSON.stringify(workOrder.production_parameters || {},null,2) %></pre></div></div>
<% if(canProduce && (!execution || !['MATERIALS_ISSUED','EXECUTED'].includes(execution.status))){ %><hr><form method="POST" action="/manufacturing/execution/<%= workOrder.id %>/draft"><h6 class="fw-bold">Input Production Parameters</h6><div class="row g-3"><div class="col-6"><label class="form-label">Concentration (mCi/mL)</label><input name="concentration_mci_ml" type="number" min="0" step="0.000001" class="form-control" value="<%= execution?.concentration_mci_ml ?? '' %>" required></div><div class="col-6"><label class="form-label">Concentration (MBq/mL)</label><input name="concentration_mbq_ml" type="number" min="0" step="0.000001" class="form-control" value="<%= execution?.concentration_mbq_ml ?? '' %>" required></div><div class="col-12"><label class="form-label">Notes Batch</label><textarea name="execution_notes" class="form-control" rows="2"><%= execution?.parameters?.notes || '' %></textarea></div></div><hr><h6 class="fw-bold">Material Requirement</h6><div id="materialsInputs"><div class="row g-2 material-input mb-2"><div class="col-7"><select name="material_id" class="form-select" required><option value="">Select material from Inventory</option><% materials.forEach(m=>{ %><option value="<%= m.id %>"><%= m.material_code %> — <%= m.name %> (released lot: <%= Number(m.released_lot_stock||0) %> <%= m.uom %>)</option><% }) %></select></div><div class="col-3"><input type="number" name="required_qty" step="0.000001" min="0.000001" class="form-control" placeholder="Quantity" required></div><div class="col-2"><input name="material_uom" class="form-control" placeholder="UoM"></div><div class="col-12"><input name="material_note" class="form-control form-control-sm" placeholder="Notes / fungsi material"></div></div></div><button type="button" id="addMaterialLine" class="btn btn-sm btn-outline-secondary mb-3"><i class="bi bi-plus-lg me-1"></i>Add Material</button><button class="btn btn-primary w-100"><i class="bi bi-save me-1"></i>Save Parameters & Material Requirements</button></form><% } %>
</div></div></div>
<div class="col-lg-7"><div class="card h-100"><div class="card-header"><strong>SCM Material Verification & Inventory Issue</strong><span class="small text-muted">SCM pilih lot aktual · RELEASED/UNRESTRICTED · issue atomik</span></div><div class="card-body">
<% if(materialLines.length){ %><div class="table-responsive"><table class="table table-sm table-bordered"><thead class="table-light"><tr><th>Material</th><th>Requested</th><th>Status</th><th>Lot Issue Trace</th></tr></thead><tbody><% materialLines.forEach(m=>{ %><tr><td><%= m.material_code %><br><span class="small"><%= m.material_name %></span></td><td><%= m.requested_qty %> <%= m.uom || m.material_uom %></td><td><span class="badge <%= m.status==='ISSUED'?'text-bg-success':'text-bg-warning' %>"><%= m.status %></span></td><td><% if(m.lot_details && m.lot_details.length){m.lot_details.forEach(l=>{ %><div class="small"><%= l.batch_number %>: <%= l.quantity %> (exp <%= l.expiry_date ? new Date(l.expiry_date).toLocaleDateString('en-GB') : '-' %>)</div><% })}else{%><span class="text-muted small">Not issued</span><%}%></td></tr><% }) %></tbody></table></div><% } else { %><div class="alert alert-info">Production material requirements have not been entered.</div><% } %>
<% if(canSCM && execution?.status==='PARAMETERS_DRAFTED'){ %>
<div class="alert alert-warning small"><strong>SCM checks before issue:</strong> Select actual lots for each production requirement. Total material allocation must match the required quantity exactly. Only unexpired RELEASED/UNRESTRICTED lots with available balances can be selected. Stock is reduced when you submit an issue; the entire transaction rolls back if any validation fails.</div>
<form id="scmIssueForm" method="POST" action="/manufacturing/execution/<%= workOrder.id %>/issue-materials" onsubmit="return confirm('Verifikasi lot dan issue seluruh material yang dialokasikan? Stok akan langsung terpotong dalam satu transaksi.');">
  <% materialLines.forEach(m=>{ const availLots=(eligibleLots||[]).filter(l=>Number(l.material_id)===Number(m.material_id)); %>
  <section class="card mb-3 scm-material-allocation" data-required="<%= Number(m.requested_qty) %>" data-line-id="<%= m.id %>">
    <div class="card-header d-flex align-items-start justify-content-between gap-2"><div><strong><%= m.material_code %> — <%= m.material_name %></strong><div class="small text-muted">Kebutuhan Production: <strong><%= Number(m.requested_qty).toLocaleString('en-GB',{maximumFractionDigits:6}) %> <%= m.uom || m.material_uom %></strong></div></div><span class="badge text-bg-warning">Awaiting Verification</span></div>
    <div class="card-body"><div class="table-responsive"><table class="table table-sm align-middle mb-2"><thead><tr><th style="min-width:240px">Lot / Batch</th><th>Expired Date</th><th>Saldo lot</th><th style="width:160px">Qty issue</th><th style="width:48px"></th></tr></thead><tbody class="allocation-rows">
      <tr class="allocation-row"><td><select class="form-select form-select-sm lot-select" name="lot_id_<%= m.id %>" required><option value="">Select a released lot</option><% availLots.forEach(l=>{ %><option value="<%= l.id %>" data-available="<%= Number(l.qty_available) %>" data-expiry="<%= l.expiry_date ? String(l.expiry_date).slice(0,10) : '' %>"><%= l.batch_number %><%= l.analysis_no ? ' · '+l.analysis_no : '' %> · <%= l.status %></option><% }) %></select></td><td class="lot-expiry small text-muted">—</td><td><span class="lot-available">—</span> <%= m.uom || m.material_uom %></td><td><input class="form-control form-control-sm lot-qty" name="lot_qty_<%= m.id %>" type="number" min="0.000001" step="0.000001" max="" placeholder="Qty" required></td><td><button type="button" class="btn btn-sm btn-outline-danger remove-allocation" title="Delete alokasi" aria-label="Delete alokasi"><i class="bi bi-x-lg"></i></button></td></tr>
    </tbody></table></div>
    <% if(!availLots.length){ %><div class="alert alert-danger py-2 small mb-2">No unexpired released lot with available stock exists for this material. Stock issue is blocked until suitable stock is available.</div><% } %>
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2"><button type="button" class="btn btn-sm btn-outline-primary add-allocation" <%= !availLots.length ? 'disabled' : '' %>><i class="bi bi-plus-lg me-1"></i>Add alokasi lot</button><div class="allocation-total small">Total dialokasikan: <strong>0</strong> / <%= Number(m.requested_qty).toLocaleString('en-GB',{maximumFractionDigits:6}) %> <%= m.uom || m.material_uom %></div></div>
    </div>
  </section>
  <% }) %>
  <button class="btn btn-warning w-100" <%= !materialLines.length || (eligibleLots||[]).length===0 ? 'disabled' : '' %>><i class="bi bi-shield-check me-1"></i>Verifikasi SCM & Issue Inventory</button>
</form>
<% } else if(canSCM && execution?.status==='MATERIALS_ISSUED'){ %><div class="alert alert-success"><i class="bi bi-check-circle me-1"></i>SCM has verified and issued the material. Review the Lot Issue Trace above for the lots used.</div><% } %>
<% if(canProduce && execution?.status==='MATERIALS_ISSUED'){ %><form method="POST" action="/manufacturing/execution/<%= workOrder.id %>/execute" class="mt-3" onsubmit="return confirm('Konfirmasi batch execution? Batch akan muncul pada daftar Batch Record.');"><button class="btn btn-success w-100"><i class="bi bi-play-circle me-1"></i>Execution — Start Batch Record Tracking</button></form><% } %>
<% if(execution?.status==='EXECUTED'){ %><a class="btn btn-success w-100 mt-3" href="/manufacturing/batch-records">Batch Executed · Open Batch Record</a><% } %>
</div></div></div></div>
</main></div>
<script>(function(){
const container=document.getElementById('materialsInputs'),add=document.getElementById('addMaterialLine');if(container&&add)add.addEventListener('click',()=>{const row=container.querySelector('.material-input').cloneNode(true);row.querySelectorAll('input').forEach(i=>i.value='');row.querySelector('select').selectedIndex=0;container.appendChild(row);});
const form=document.getElementById('scmIssueForm');if(!form)return;
function recalc(box){const sum=[...box.querySelectorAll('.lot-qty')].reduce((a,i)=>a+(Number(i.value)||0),0),required=Number(box.dataset.required||0),strong=box.querySelector('.allocation-total strong');if(strong)strong.textContent=sum.toLocaleString('en-GB',{maximumFractionDigits:6});const display=box.querySelector('.allocation-total');if(display){display.classList.toggle('text-success',Math.abs(sum-required)<=0.000001);display.classList.toggle('text-danger',sum>required+0.000001);}}
function updateLot(row){const select=row.querySelector('.lot-select'),opt=select?.selectedOptions[0],exp=row.querySelector('.lot-expiry'),avail=row.querySelector('.lot-available'),qty=row.querySelector('.lot-qty');if(!opt||!opt.value){if(exp)exp.textContent='—';if(avail)avail.textContent='—';if(qty){qty.removeAttribute('max');qty.setCustomValidity('');}return;}if(exp)exp.textContent=opt.dataset.expiry||'Tidak ditentukan';if(avail)avail.textContent=Number(opt.dataset.available||0).toLocaleString('en-GB',{maximumFractionDigits:6});if(qty){qty.max=opt.dataset.available||'';qty.setCustomValidity('');}}
function refreshRows(box){const rows=[...box.querySelectorAll('.allocation-row')];rows.forEach(r=>{const b=r.querySelector('.remove-allocation');if(b)b.disabled=rows.length===1;});recalc(box);}
form.addEventListener('change',e=>{const row=e.target.closest('.allocation-row'),box=e.target.closest('.scm-material-allocation');if(row&&e.target.matches('.lot-select'))updateLot(row);if(box)refreshRows(box);});form.addEventListener('input',e=>{const box=e.target.closest('.scm-material-allocation');if(box)recalc(box);});form.addEventListener('click',e=>{const addBtn=e.target.closest('.add-allocation'),removeBtn=e.target.closest('.remove-allocation');if(addBtn){const box=addBtn.closest('.scm-material-allocation'),tbody=box.querySelector('.allocation-rows'),row=tbody.querySelector('.allocation-row').cloneNode(true);row.querySelectorAll('select').forEach(s=>s.selectedIndex=0);row.querySelectorAll('input').forEach(i=>{i.value='';i.removeAttribute('max');});row.querySelectorAll('.lot-expiry,.lot-available').forEach(n=>n.textContent='—');tbody.appendChild(row);refreshRows(box);}if(removeBtn){const box=removeBtn.closest('.scm-material-allocation');removeBtn.closest('.allocation-row').remove();refreshRows(box);}});
form.querySelectorAll('.scm-material-allocation').forEach(box=>{box.querySelectorAll('.allocation-row').forEach(updateLot);refreshRows(box);});
form.addEventListener('submit',e=>{let ok=true;form.querySelectorAll('.scm-material-allocation').forEach(box=>{const sum=[...box.querySelectorAll('.lot-qty')].reduce((a,i)=>a+(Number(i.value)||0),0),required=Number(box.dataset.required||0);if(Math.abs(sum-required)>0.000001)ok=false;box.classList.toggle('border-danger',Math.abs(sum-required)>0.000001);const rows=[...box.querySelectorAll('.allocation-row')];rows.forEach(row=>{const opt=row.querySelector('.lot-select')?.selectedOptions[0],qty=Number(row.querySelector('.lot-qty')?.value||0);if(!opt?.value||qty<=0||qty>Number(opt.dataset.available||0)+0.000001)ok=false;});});if(!ok){e.preventDefault();alert('Periksa lot dan kuantitas: lot harus dipilih, saldo setiap lot tidak boleh terlampaui, dan total alokasi per material harus sama dengan kebutuhan Production.');}});
})();</script>
<%- include('../partials/footer') %>
