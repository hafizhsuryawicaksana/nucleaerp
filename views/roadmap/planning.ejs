<%- include('../partials/header', { title: 'Manufacturing / Production Planning | NUCLEA ERP' }) %>
<%- include('../partials/sidebar', { page: 'roadmap-planning' }) %>
<div class="app-wrapper"><%- include('../partials/headbar') %><main class="app-main">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4"><div><h3 class="fw-bold mb-1">Production Planning</h3></div><div class="card batch-scheduled-card"><div class="card-body py-2 px-3"><div class="small text-muted">Batch Scheduled</div><div class="fs-4 fw-bold"><%= workOrders.filter(w=>w.status==='SCHEDULED').length %></div></div></div></div>
  <% if(query.error){ %><div class="alert alert-danger"><%= query.error %></div><% } %>
  <div class="card" data-modalize-title="Create Production Batch" data-modalize-button="Add Production Batch" data-modalize-size="xl"><div class="card-header"><strong>Schedule Production Batch</strong></div><div class="card-body">
  <% if(canPlan){ %>
  <form method="POST" action="/manufacturing/planning" id="planningForm">
    <h6 class="text-uppercase fw-bold text-primary mb-3">Product Information</h6>
    <div class="row g-3 mb-3">
      
      <div class="col-md-4"><label class="form-label">Batch ID *</label><input class="form-control" name="batch_id" required placeholder="Enter batch ID"></div>
      <div class="col-md-4"><label class="form-label">Product Name *</label><input class="form-control" name="product_name" list="productNameSuggestions" placeholder="Enter product name" autocomplete="off" required maxlength="255"><datalist id="productNameSuggestions"><% products.forEach(p=>{ %><option value="<%= p.name %>"><%= p.code %></option><% }) %></datalist></div>
      <div class="col-md-4"><label class="form-label">Production Date *</label><input type="date" class="form-control" name="production_date" required></div>
      <div class="col-md-4"><label class="form-label">Work Order Preparation Start Time</label><input type="datetime-local" class="form-control" name="preparation_start"></div>
      
    </div>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2"><h6 class="fw-bold mb-0">Customer Orders & Calibration</h6><button type="button" class="btn btn-outline-primary btn-sm" id="addCustomerRow"><i class="bi bi-plus-circle me-1"></i>Add Customer</button></div>
    <div class="table-responsive"><table class="table table-bordered align-middle" id="customersTable"><thead class="table-light"><tr><th style="min-width:220px">Customer</th><th style="min-width:180px">Calibration Time [A]</th><th>Activity @ Cal (mCi)</th><th>Arrival Time</th><th>Travel (min)</th><th>Max Delay (min)</th><th>Delivery Start</th><th>Dispensing Start [B]</th><th>Vehicle No.</th><th>Required Production Activity (mCi)</th><th></th></tr></thead><tbody>
      <tr class="customer-row"><td><select name="customer_id" class="form-select" required><option value="">Select customer</option><% customers.forEach(c=>{ %><option value="<%= c.id %>" <%= c.qualification_status==='REJECTED'?'disabled':'' %>><%= c.customer_code %> — <%= c.name %> (<%= c.qualification_status %>)</option><% }) %></select></td>
      <td><input type="datetime-local" name="calibration_time" class="form-control"></td><td><input type="number" step="0.001" min="0" name="activity_at_cal_mci" class="form-control"></td><td><input type="datetime-local" name="arrival_time" class="form-control"></td><td><input type="number" min="0" name="travel_time_min" class="form-control"></td><td><input type="number" min="0" name="max_delay_time_min" class="form-control"></td><td><input type="datetime-local" name="delivery_start_time" class="form-control"></td><td><input type="datetime-local" name="dispensing_start_time" class="form-control"></td><td><input name="vehicle_no" class="form-control" placeholder="Vehicle ID"></td><td><input type="number" min="0" step="0.001" name="required_production_activity_mci" class="form-control"></td><td><button type="button" class="btn btn-outline-danger btn-sm remove-row" title="Remove row" disabled><i class="bi bi-x-lg"></i></button></td></tr>
    </tbody></table></div>
    <div class="row g-3 mt-1"><div class="col-md-8"><label class="form-label">Planning Details</label><textarea class="form-control" name="scm_notes" rows="2" placeholder="Optional batch details"></textarea></div><div class="col-md-4 d-flex align-items-end"><button class="btn btn-primary w-100" type="submit"><i class="bi bi-calendar-check me-1"></i>Save & Schedule Batch</button></div></div>
  </form>
  <% } else { %><% } %>
  </div></div>

  <div class="card"><div class="card-header"><div><strong>Production Calendar</strong><div class="small text-muted"></div></div><form class="d-flex gap-2" method="GET"><input class="form-control form-control-sm" name="month" type="month" value="<%= query.month || new Date().toISOString().slice(0,7) %>"><button class="btn btn-sm btn-outline-secondary">Apply</button></form></div><div class="card-body">
    <% const monthValue=(query.month||new Date().toISOString().slice(0,7)).split('-'); const monthDate=new Date(Number(monthValue[0]),Number(monthValue[1])-1,1); const totalDays=new Date(Number(monthValue[0]),Number(monthValue[1]),0).getDate(); const startDow=monthDate.getDay(); const dayLabels=['Sun','Mon','Tue','Wed','Thu','Fri','Sat']; const calendarKey=v=>{if(!v)return '';const z=String(v);if(/^\d{4}-\d{2}-\d{2}/.test(z))return z.slice(0,10);const d=new Date(v);return Number.isNaN(d.getTime())?'':d.toISOString().slice(0,10);}; %>
    <div class="row g-2"><% dayLabels.forEach(d=>{ %><div class="col text-center small fw-bold text-muted"><%= d %></div><% }) %></div>
    <div class="calendar-grid mt-2"><% for(let blank=0;blank<startDow;blank++){ %><div class="calendar-day calendar-empty"></div><% } %><% for(let day=1;day<=totalDays;day++){ const key=`${monthValue[0]}-${monthValue[1]}-${String(day).padStart(2,'0')}`; const events=workOrders.filter(w=>calendarKey(w.production_date)===key && w.status!=='CANCELLED'); %><div class="calendar-day"><div class="fw-bold small mb-1"><%= day %></div><% events.slice(0,3).forEach(ev=>{ %><a class="calendar-event <%= ev.status==='CANCELLED'?'text-decoration-line-through':'' %>" href="#wo-<%= ev.id %>" title="<%= ev.batch_id %>"><%= ev.batch_id %><span class="d-block fw-normal"><%= ev.customer_count %> cust. · <%= Number(ev.ordered_activity||0).toLocaleString('en-GB') %> mCi</span></a><% }) %><% if(events.length>3){ %><span class="text-muted small">+<%= events.length-3 %> batch</span><% } %></div><% } %></div>
  </div></div>

  <div class="card"><div class="card-header"><div><strong>Scheduled Batches</strong></div><span class="badge text-bg-light border">Planning Queue</span></div><div class="card-body border-bottom"><div class="row g-2"><div class="col-md-8"><input class="form-control" id="planningRegisterSearch" placeholder="Search batch, product, or customer…"></div><div class="col-md-4"><select class="form-select" id="planningStatusFilter"><option value="">All statuses</option><option value="SCHEDULED">SCHEDULED</option><option value="CANCELLED">CANCELLED</option><option value="EXECUTED">EXECUTED</option></select></div></div></div><div class="table-responsive"><table id="planningRegisterTable" class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Batch</th><th>Production Date</th><th>Product</th><th>Customer</th><th>Ordered Activity</th><th>Total Production Activity</th><th>Status</th><th style="min-width:330px">Production Parameter / Action</th></tr></thead><tbody>
  <% workOrders.forEach(w=>{ %><tr id="wo-<%= w.id %>" data-wo-search="<%= (w.batch_id+' '+w.product_name+' '+(w.customer_names||'')).toLowerCase() %>" data-wo-status="<%= w.status %>"><td><code class="fw-bold"><%= w.batch_id %></code><div class="small text-muted"><%= w.product_code %></div></td><td><%= w.production_date ? new Date(w.production_date).toLocaleDateString('en-GB') : '-' %></td><td><%= w.product_name %></td><td><%= w.customer_names || '-' %><div class="small text-muted"><%= w.customer_count %> customers</div></td><td><%= Number(w.ordered_activity||0).toLocaleString('en-GB') %> mCi</td><td><%= Number(w.required_activity||0).toLocaleString('en-GB') %> mCi</td><td><span class="badge <%= w.status==='CANCELLED'?'text-bg-danger':w.status==='EXECUTED'?'text-bg-success':'text-bg-primary' %>"><%= w.status %></span><% if(w.production_parameters_complete){ %><div class="small text-success mt-1"><i class="bi bi-check-circle"></i> Production parameters complete</div><% } else { %><div class="small text-warning mt-1">Production parameters pending</div><% } %></td><td>
  <% if(canEnterProduction && w.status==='SCHEDULED'){ %><details><summary class="btn btn-sm btn-outline-primary">Enter Production Parameters</summary><form class="border rounded p-3 mt-2 bg-light" method="POST" action="/manufacturing/planning/<%= w.id %>/production-parameters"><div class="row g-2"><div class="col-6"><label class="small">Synthesis activity buffer (%)</label><input class="form-control form-control-sm" type="number" step="0.1" min="0" name="synthesis_activity_buffer_percent" value="20" required></div><div class="col-6"><label class="small">Target production activity (mCi)</label><input class="form-control form-control-sm" type="number" step="0.001" min="0" name="target_total_production_activity_mci" value="<%= w.required_activity || '' %>" required></div><div class="col-6"><label class="small">Target activity at EOB (mCi)</label><input class="form-control form-control-sm" type="number" step="0.001" min="0" name="target_eob_activity_mci" required></div><div class="col-6"><label class="small">Equipment ID</label><input class="form-control form-control-sm" name="equipment_id"></div><div class="col-6"><label class="small">Beam current (µA)</label><input class="form-control form-control-sm" type="number" step="0.01" name="beam_current_ua"></div><div class="col-6"><label class="small">Beam duration (min)</label><input class="form-control form-control-sm" type="number" step="0.1" name="beam_duration_min"></div><div class="col-6"><label class="small">Room temperature (°C)</label><input class="form-control form-control-sm" type="number" step="0.1" name="room_temperature_c"></div><div class="col-6"><label class="small">Room pressure (Pa)</label><input class="form-control form-control-sm" type="number" step="0.1" name="room_pressure_pa"></div><div class="col-12"><label class="small">Production Notes</label><input class="form-control form-control-sm" name="production_notes"></div><div class="col-12"><button class="btn btn-sm btn-primary w-100">Save Parameters</button></div></div></form></details><% } %>
  <% if(w.status==='SCHEDULED'){ %><details class="mt-2"><summary class="btn btn-sm btn-outline-danger">Cancel Batch</summary><form class="d-flex gap-2 mt-2" method="POST" action="/manufacturing/planning/<%= w.id %>/cancel"><input class="form-control form-control-sm" name="reason" placeholder="Cancellation reason" required><button class="btn btn-sm btn-danger">Confirm Cancellation</button></form></details><% } %>
  <% if(w.status==='EXECUTED'){ %><a class="btn btn-sm btn-success mt-2" href="/manufacturing/batch-records">Open Batch Records</a><% } %>
  </td></tr><% }) %>
  <% if(!workOrders.length){ %><tr><td colspan="8" class="text-center text-muted py-4">No batches scheduled yet.</td></tr><% } %>
  </tbody></table></div></div>
</main></div>
<style>.batch-scheduled-card{min-width:150px;max-width:190px;border:1px solid var(--bs-border-color);box-shadow:none}.calendar-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px}.calendar-day{min-height:100px;border:1px solid var(--bs-border-color);border-radius:8px;padding:7px;background:var(--bs-tertiary-bg);color:var(--bs-body-color)}.calendar-empty{background:var(--bs-secondary-bg)}.calendar-event{display:block;font-size:.72rem;line-height:1.25;border-radius:5px;background:rgba(37,99,235,.09);padding:4px;margin-bottom:4px;color:var(--bs-primary);text-decoration:none;overflow-wrap:anywhere}@media(max-width:768px){.calendar-day{min-height:60px;padding:3px}.calendar-event{font-size:.6rem}.calendar-grid{gap:3px}}</style>
<script>
document.addEventListener('DOMContentLoaded',()=>{const s=document.getElementById('planningRegisterSearch'),f=document.getElementById('planningStatusFilter');function apply(){const q=(s?.value||'').toLowerCase().trim(),st=f?.value||'';document.querySelectorAll('#planningRegisterTable tbody tr[data-wo-search]').forEach(r=>r.hidden=!(r.dataset.woSearch.includes(q)&&(!st||r.dataset.woStatus===st)));}s?.addEventListener('input',apply);f?.addEventListener('change',apply);});
(function(){const table=document.querySelector('#customersTable tbody');const add=document.querySelector('#addCustomerRow');if(!table||!add)return;function refresh(){const rows=[...table.querySelectorAll('.customer-row')];rows.forEach(r=>{const b=r.querySelector('.remove-row');if(b)b.disabled=rows.length===1;});}add.addEventListener('click',()=>{const row=table.querySelector('.customer-row').cloneNode(true);row.querySelectorAll('input').forEach(i=>i.value='');row.querySelector('select').selectedIndex=0;row.querySelector('.remove-row').disabled=false;table.appendChild(row);refresh();});table.addEventListener('click',e=>{const b=e.target.closest('.remove-row');if(b&&!b.disabled){b.closest('tr').remove();refresh();}});refresh();})();
</script>
<%- include('../partials/footer') %>
