<%- include('../partials/header', { title: (partnerType==='CUSTOMER'?'Customer':'Vendor') + ' Management | NUCLEA ERP' }) %>
<%- include('../partials/sidebar', { page: partnerType==='CUSTOMER'?'roadmap-customers':'roadmap-vendors' }) %>
<div class="app-wrapper"><%- include('../partials/headbar') %><main class="app-main">
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4"><div><h3 class="fw-bold mb-1"><%= partnerType==='CUSTOMER'?'Customer Management':'Vendor Management' %></h3><div class="text-muted"><%= partnerType==='CUSTOMER'?'Customer qualification':'Vendor qualification' %></div></div><div class="d-flex gap-2"><span class="badge text-bg-secondary">Registered</span><span class="badge text-bg-success">Qualified</span><span class="badge text-bg-danger">Rejected</span></div></div>
<% if(query.error){ %><div class="alert alert-danger"><%= query.error %></div><% } %><% if(query.success){ %><div class="alert alert-success"><%= query.success %></div><% } %>
<div class="row g-3"><div class="col-12 partner-create-slot"><div class="card" data-modalize-title="Register <%= partnerType==='CUSTOMER'?'Customer':'Vendor' %>" data-modalize-button="Add <%= partnerType==='CUSTOMER'?'Customer':'Vendor' %>" data-modalize-size="xl"><div class="card-header"><strong>Register <%= partnerType==='CUSTOMER'?'Customer':'Vendor' %></strong></div><div class="card-body"><% if(canEdit){ %><form method="POST" action="/<%= partnerType==='CUSTOMER'?'customers':'vendors' %>/create"><% if(partnerType==='CUSTOMER'){ %>
<h6 class="text-primary fw-bold">Customer Data (IMS.QA.019-F-01)</h6><div class="mb-3"><label class="form-label">Customer Code *</label><input class="form-control" name="customer_code" placeholder="Leave blank to auto-generate"></div><div class="mb-3"><label class="form-label">Customer Organization Name *</label><input class="form-control" name="name" required></div><div class="mb-3"><label class="form-label">Category / Class</label><select class="form-select" name="category"><option value="Hospital">Hospital</option><option>Nuclear Medicine Facility</option><option>Authorized Distributor</option><option>Other</option></select></div><div class="mb-3"><label class="form-label">Full Address</label><textarea class="form-control" name="address" rows="2"></textarea></div><div class="row g-2"><div class="col-6"><label class="form-label">Phone Number</label><input class="form-control" name="phone"></div><div class="col-6"><label class="form-label">Fax Number</label><input class="form-control" name="fax"></div><div class="col-12"><label class="form-label">Email</label><input class="form-control" name="email" type="email"></div><div class="col-12"><label class="form-label">Contact Person</label><input class="form-control" name="contact_person"></div></div><hr><h6 class="fw-bold">Responsible Pharmacist (APJ)</h6><div class="mb-2"><label class="form-label">APJ Name</label><input class="form-control" name="apj_name"></div><div class="mb-2"><label class="form-label">APJ Address</label><input class="form-control" name="apj_address"></div><div class="row g-2"><div class="col-7"><label class="form-label">STRA Number</label><input class="form-control" name="apj_stra_no"></div><div class="col-5"><label class="form-label">STRA Expiry Date</label><input class="form-control" type="date" name="apj_stra_expiry"></div><div class="col-7"><label class="form-label">SIPA Number</label><input class="form-control" name="apj_sipa_no"></div><div class="col-5"><label class="form-label">SIPA Expiry Date</label><input class="form-control" type="date" name="apj_sipa_expiry"></div></div><hr><h6 class="fw-bold">Health Facility / Nuclear Medicine Licensing</h6><div class="row g-2"><div class="col-7"><label class="form-label">Operating License No.</label><input class="form-control" name="operating_license_no"></div><div class="col-5"><label class="form-label">Expiry Date</label><input class="form-control" type="date" name="operating_license_expiry"></div><div class="col-6"><label class="form-label">Hospital Class</label><select class="form-select" name="hospital_class"><option value="">—</option><option>A</option><option>B</option><option>C</option><option>D</option></select></div><div class="col-6"><label class="form-label">Accreditation</label><select class="form-select" name="accreditation"><option value="">—</option><option>Dasar</option><option>Intermediate</option><option>Advanced</option><option>Excellent</option></select></div><div class="col-6"><label class="form-label">Accreditation Expiry Date</label><input class="form-control" type="date" name="accreditation_expiry"></div><div class="col-6"><label class="form-label">Radiopharmaceutical Use License No.</label><input class="form-control" name="radiopharmaceutical_license_no"></div></div><hr><h6 class="fw-bold">Tax</h6><div class="row g-2"><div class="col-6"><label class="form-label">Tax ID</label><input class="form-control" name="tax_id"></div><div class="col-6"><label class="form-label">Taxpayer Name</label><input class="form-control" name="taxpayer_name"></div></div>
<% } else { %><div class="mb-3"><label class="form-label">Vendor Code *</label><input class="form-control" name="vendor_code" required></div><div class="mb-3"><label class="form-label">Vendor Name *</label><input class="form-control" name="name" required></div><div class="mb-3"><label class="form-label">Vendor Category</label><select class="form-select" name="vendor_type"><option value="Raw Material">Raw Material</option><option>Packaging Material</option><option>Supporting Material</option><option>Service</option></select></div><div class="mb-3"><label class="form-label">Products / Services / Category</label><input class="form-control" name="category"></div><div class="mb-3"><label class="form-label">Address</label><textarea class="form-control" name="address" rows="2"></textarea></div><div class="row g-2"><div class="col-6"><label class="form-label">Contact Person</label><input class="form-control" name="contact_person"></div><div class="col-6"><label class="form-label">Phone</label><input class="form-control" name="phone"></div><div class="col-6"><label class="form-label">Email</label><input class="form-control" name="email" type="email"></div><div class="col-6"><label class="form-label">Tax ID</label><input class="form-control" name="tax_id"></div></div><div class="alert alert-secondary small mt-3">Document completeness and qualification checklist answers are evaluated by QA through a qualification request.</div><% } %><button class="btn btn-primary w-100 mt-4">Register as Registered</button></form><% } else { %><div class="alert alert-info">Your role cannot add partners.</div><% } %></div></div></div>
<div class="col-12"><div class="card"><div class="card-header"><div><strong><%= partnerType==='CUSTOMER'?'Customer Database':'Vendor Database' %></strong><div class="small text-muted"><%= partners.length %> records · details and qualification are available in each record</div></div><span class="badge text-bg-light border">Master Data</span></div><div class="card-body border-bottom"><div class="row g-2"><div class="col-md-8"><input class="form-control" id="partnerSearch" placeholder="Search code, name, contact, email, or phone…"></div><div class="col-md-4"><select id="partnerStatusFilter" class="form-select"><option value="">All qualification statuses</option><option value="REGISTERED">REGISTERED</option><option value="QUALIFIED">QUALIFIED</option><option value="REJECTED">REJECTED</option></select></div></div></div><div class="table-responsive"><table id="partnerTable" class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Partner</th><th>Contact</th><th>Registration / Qualification</th><th>Documents</th><th>Action</th></tr></thead><tbody><% partners.forEach(p=>{ const q=qualifications.find(x=>Number(x.partner_id)===Number(p.id)); const pfiles=files.filter(f=>f.owner_id===String(p.id)); %><tr data-partner-row="<%= p.id %>" data-partner-search="<%= ((partnerType==='CUSTOMER'?p.customer_code:p.vendor_code)+' '+p.name+' '+(p.contact_person||'')+' '+(p.email||'')+' '+(p.phone||'')).toLowerCase() %>" data-partner-status="<%= p.qualification_status||'REGISTERED' %>"><td><strong><%= partnerType==='CUSTOMER'?p.customer_code:p.vendor_code %></strong><div><%= p.name %></div><div class="small text-muted"><%= partnerType==='CUSTOMER'?(p.category||''):(p.vendor_type||p.category||'') %></div></td><td><%= p.contact_person || '-' %><div class="small text-muted"><%= p.email || '-' %><br><%= p.phone || '-' %></div></td><td><span class="badge text-bg-secondary"><%= p.registration_status || 'REGISTERED' %></span><div class="mt-1"><span class="badge <%= p.qualification_status==='QUALIFIED'?'text-bg-success':p.qualification_status==='REJECTED'?'text-bg-danger':'text-bg-warning' %>"><%= p.qualification_status || 'REGISTERED' %></span></div><div class="mt-1"><span class="badge <%= p.is_active===false?'text-bg-dark':'text-bg-success' %>"><%= p.is_active===false?'ARCHIVED':'ACTIVE' %></span></div></td><td><strong><%= pfiles.length %></strong> file(s)<% pfiles.slice(0,2).forEach(f=>{ %><a class="d-block small" target="_blank" href="/roadmap/files/<%= f.id %>"><%= f.document_type %></a><% }) %></td><td><div class="d-flex flex-wrap gap-1"><% if(partnerType==='CUSTOMER'){ %><button class="btn btn-sm btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#customerPricingModal" data-customer-id="<%= p.id %>" data-customer-name="<%= p.name %>">Pricing</button><% } %><button class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#partner-<%= partnerType %>-<%= p.id %>">Details</button><% if(canEdit){ %><form method="post" action="/<%= partnerType==='CUSTOMER'?'customers':'vendors' %>/<%= p.id %>/archive" onsubmit="return confirm('<%= p.is_active===false?'Reactivate':'Archive this partner? History and documents will be retained.' %>');"><button class="btn btn-sm btn-outline-secondary"><%= p.is_active===false?'Reactivate':'Archive' %></button></form><form method="post" action="/<%= partnerType==='CUSTOMER'?'customers':'vendors' %>/<%= p.id %>/delete" onsubmit="const reason=prompt('Reason for permanent trial data deletion:','Data cleanup');if(!reason)return false;this.querySelector('[name=reason]').value=reason;return confirm('PERMANENTLY DELETE <%= p.name %>? Deletion is blocked when transactions or operational references exist.');"><input type="hidden" name="reason" value="Data cleanup"><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button></form><% } %></div></td></tr>
<tr class="collapse-row" data-partner-detail="<%= p.id %>"><td colspan="5" class="p-0 border-0"><div class="collapse p-3 bg-light" id="partner-<%= partnerType %>-<%= p.id %>"><div class="row g-3"><div class="col-lg-5"><h6 class="fw-bold">Partner Details</h6><dl class="row small mb-3"><dt class="col-5">Address</dt><dd class="col-7"><%= p.address || '-' %></dd><% if(partnerType==='CUSTOMER'){ %><dt class="col-5">APJ</dt><dd class="col-7"><%= p.apj_name || '-' %></dd><dt class="col-5">STRA / Expiry</dt><dd class="col-7"><%= p.apj_stra_no || '-' %> / <%= p.apj_stra_expiry ? new Date(p.apj_stra_expiry).toLocaleDateString('en-GB') : '-' %></dd><dt class="col-5">SIPA / Expiry</dt><dd class="col-7"><%= p.apj_sipa_no || '-' %> / <%= p.apj_sipa_expiry ? new Date(p.apj_sipa_expiry).toLocaleDateString('en-GB') : '-' %></dd><dt class="col-5">Radiopharmaceutical License</dt><dd class="col-7"><%= p.radiopharmaceutical_license_no || '-' %></dd><dt class="col-5">Accreditation</dt><dd class="col-7"><%= p.accreditation || '-' %> · <%= p.accreditation_expiry ? new Date(p.accreditation_expiry).toLocaleDateString('en-GB') : '-' %></dd><dt class="col-5">Tax ID</dt><dd class="col-7"><%= p.tax_id || '-' %> · <%= p.taxpayer_name || '' %></dd><% }else{ %><dt class="col-5">Vendor Type</dt><dd class="col-7"><%= p.vendor_type || '-' %></dd><dt class="col-5">Tax ID</dt><dd class="col-7"><%= p.tax_id || '-' %></dd><% } %></dl>
<% if(partnerType==='CUSTOMER'){ const customerSales=(customerTransactions||[]).filter(t=>Number(t.customer_id)===Number(p.id)); const customerPrices=(customerPricing||[]).filter(x=>Number(x.customer_id)===Number(p.id)); %>
<div class="mt-3"><div class="d-flex justify-content-between align-items-center"><h6 class="fw-bold mb-0">Product Pricing</h6><span class="badge text-bg-light border"><%= customerPrices.length %></span></div>
<div class="table-responsive mt-2"><table class="table table-sm align-middle"><thead><tr><th>Product</th><th>Price Basis</th><th class="text-end">Price</th></tr></thead><tbody><% customerPrices.forEach(cp=>{ %><tr><td><%= cp.product_name %></td><td><%= Number(cp.pricing_quantity).toLocaleString('en-US') %> <%= cp.uom %></td><td class="text-end"><%= Number(cp.price).toLocaleString('en-US',{style:'currency',currency:'IDR',maximumFractionDigits:0}) %></td></tr><% }) %><% if(!customerPrices.length){ %><tr><td colspan="3" class="text-muted small">No pricing set.</td></tr><% } %></tbody></table></div>
<div class="d-flex justify-content-between align-items-center mt-3"><h6 class="fw-bold mb-0">Transaction History</h6><span class="badge text-bg-light border"><%= customerSales.length %></span></div>
<div class="table-responsive mt-2"><table class="table table-sm align-middle"><thead><tr><th>Date</th><th>Product / Batch</th><th>Quantity</th><th>Revenue</th><th>Status</th></tr></thead><tbody><% customerSales.slice(0,10).forEach(t=>{ %><tr><td class="small"><%= t.occurred_at?new Date(t.occurred_at).toLocaleDateString('en-US'):'-' %></td><td><%= t.product_name %><div class="small text-muted"><%= t.batch_id %></div></td><td><%= Number(t.quantity||0).toLocaleString('en-US') %> <%= t.uom %></td><td class="text-end"><%= t.total_amount==null?'—':Number(t.total_amount).toLocaleString('en-US',{style:'currency',currency:'IDR',maximumFractionDigits:0}) %></td><td><span class="badge <%= t.status==='RECOGNIZED'?'text-bg-success':'text-bg-warning' %>"><%= t.status==='RECOGNIZED'?'Recognized':'Pending Pricing' %></span></td></tr><% }) %><% if(!customerSales.length){ %><tr><td colspan="5" class="text-muted small">No transactions yet.</td></tr><% } %></tbody></table></div></div>
<% } %>
<% if(canEdit){ %><form method="POST" enctype="multipart/form-data" action="/<%= partnerType==='CUSTOMER'?'customers':'vendors' %>/<%= p.id %>/documents" class="border rounded p-2 bg-white"><strong class="small">Upload Supporting Documents</strong><label class="form-label small mt-2">Document Type</label><select class="form-select form-select-sm mb-2" name="document_type"><option value="COMPANY_PROFILE">Company Profile</option><option value="COMPANY_REGISTRATION">Deed of Incorporation</option><option value="COMPANY_AMENDMENT">Company Amendment Deed</option><option value="BUSINESS_LICENSE">NIB / SIUP</option><option value="OWNER_ID">Owner ID / KTP</option><option value="OWNER_TAX_ID">Owner Tax ID</option><option value="TAX_DOCUMENT">Company Tax ID / Tax</option><option value="SPPKP">SPPKP / VAT Registration</option><option value="QUALITY_CERTIFICATE">CPOB / GMP / ISO / KAN Certificate</option><option value="COA">Certificate of Analysis (CoA)</option><option value="PRODUCT_SPECIFICATION">Product Specification</option><option value="MSDS_TDS">MSDS / TDS</option><option value="PROCESS_FLOW">Process / Service Flow</option><option value="SYNTHESIS_ROUTE">Synthetic Route</option><option value="CUSTOMER_COMPLAINT_TRENDS">Customer Complaints / Satisfaction Trends</option><option value="PQR">Product Quality Review (PQR)</option><option value="STABILITY_DATA">Product Stability Data</option><option value="RECALL_TRENDS">Product Recall Trends</option><option value="CCP">Critical Control Point (CCP)</option><option value="ANNUAL_INTERNAL_AUDIT">Annual Internal Audit Report</option><option value="REGULATORY_AUDIT_HISTORY">Latest Regulatory Audit History</option><option value="CUSTOMER_LIST">Customer List</option><option value="LICENSE">General License</option><option value="APJ_STRA_SIPA">APJ STRA/SIPA</option><option value="RADIOPHARMACEUTICAL_LICENSE">Radiopharmaceutical License</option><option value="OPERATING_LICENSE">Operating License</option><option value="ACCREDITATION">Accreditation</option><option value="CONTRACT">Contract</option><option value="OTHER">Other / Additional Evidence</option></select><input type="file" name="document" class="form-control form-control-sm mb-2" accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg" required><button class="btn btn-sm btn-outline-primary w-100">Upload (private storage)</button></form><% } %>
<% if(!q && canEdit && p.qualification_status!=='QUALIFIED' && p.qualification_status!=='REJECTED'){ %><form method="POST" action="/<%= partnerType==='CUSTOMER'?'customers':'vendors' %>/<%= p.id %>/request-qualification" class="mt-2"><button class="btn btn-sm btn-warning w-100">Request QA Qualification / Evaluation</button></form><% } else if(q){ %><div class="alert alert-warning small mt-3 mb-0">Qualification request #<%= q.id %> awaiting QA review. Complete the checklist in the panel on the right.</div><% } %>
</div><div class="col-lg-7"><% if(q && canQA){ %><form method="POST" action="/<%= partnerType==='CUSTOMER'?'customers':'vendors' %>/<%= p.id %>/qualification/<%= q.id %>/decision" class="border rounded p-3 bg-white"><h6 class="fw-bold">QA Qualification Checklist (IMS.QA.004-F-02)</h6><div class="small text-muted mb-2">Answer all questions. Relevant qualification documents must be uploaded before a Qualified decision.</div><div class="border rounded p-2 mb-3"><strong class="small">Uploaded Documents</strong><% if(pfiles.length){ %><ul class="small mb-0 mt-1"><% pfiles.forEach(f=>{ %><li><a target="_blank" href="/roadmap/files/<%= f.id %>"><%= f.document_type %> — <%= f.original_name %></a></li><% }) %></ul><% } else { %><div class="small text-danger mt-1">No documents uploaded.</div><% } %></div><% if(partnerType==='VENDOR'){ %><details class="mb-3"><summary class="small fw-bold">Document Completeness Checklist — IMS.QA.004-F-01</summary><div class="table-responsive mt-2" style="max-height:280px;overflow:auto"><table class="table table-sm table-bordered"><tbody><% documentRequirements.forEach(r=>{ %><tr><% r.cells.forEach(c=>{ %><td class="small"><%= c %></td><% }) %></tr><% }) %></tbody></table></div></details><% } %><div style="max-height:520px;overflow:auto"><table class="table table-sm table-bordered align-middle"><thead class="table-light"><tr><th>Question</th><th style="min-width:120px">Answer</th></tr></thead><tbody><% checklist.forEach((item,i)=>{ %><tr><td><span class="small text-muted"><%= item.number %></span><div class="small"><%= item.item %></div></td><td><select name="q_<%= i %>" class="form-select form-select-sm" required><option value="">—</option><option value="YES">Yes</option><option value="NO">No</option><option value="NA">N/A</option></select><input class="form-control form-control-sm mt-1" name="remark_<%= i %>" placeholder="Description"></td></tr><% }) %></tbody></table></div><% if(partnerType==='VENDOR'){ const vt=String(p.vendor_type||'').toLowerCase(); const dc=vt.includes('raw')?2:vt.includes('pack')?3:vt.includes('support')?4:5; %><hr><h6 class="fw-bold">QA Document Completeness Check</h6><div class="small text-muted mb-2">Select Available/Missing/N/A for each requirement applicable to the vendor category. Required source-form documents must be uploaded under the matching document type before Qualified status can be approved.</div><div class="table-responsive" style="max-height:420px;overflow:auto"><table class="table table-sm table-bordered align-middle"><thead class="table-light"><tr><th>Document requirement</th><th>Source</th><th>QA review</th><th>Remark</th></tr></thead><tbody><% documentRequirements.slice(2).forEach((dr,j)=>{ const originalIndex=j+2;const cells=dr.cells||[];const applicability=String(cells[dc]||'').trim();if(!applicability||applicability==='-'||/^n\/a$/i.test(applicability))return; %><tr><td class="small"><%= cells[1]||'' %><% if(applicability.includes('✓')&&!/if needed|bila perlu|jika ada/i.test(applicability)){ %><span class="badge text-bg-danger ms-1">Required</span><% } else { %><span class="badge text-bg-secondary ms-1">Conditional</span><% } %></td><td class="small"><%= applicability %></td><td><select class="form-select form-select-sm" name="doc_<%= originalIndex %>" required><option value="">—</option><option value="AVAILABLE">Available</option><option value="MISSING">Missing</option><option value="NA">N/A</option></select></td><td><input class="form-control form-control-sm" name="doc_remark_<%= originalIndex %>" placeholder="Notes"></td></tr><% }) %></tbody></table></div><% } %><label class="form-label small fw-bold mt-2">QA Evaluation Note</label><textarea name="decision_note" class="form-control form-control-sm mb-2" rows="2" placeholder="Ringkasan evaluasi / tindak lanjut"></textarea><div class="d-flex gap-2"><button class="btn btn-success w-50" name="decision" value="QUALIFIED" onclick="return confirm('Tetapkan partner sebagai QUALIFIED?');">Qualified</button><button class="btn btn-danger w-50" name="decision" value="REJECTED" onclick="return confirm('Tetapkan partner sebagai REJECTED?');">Rejected</button></div></form><% } else if(q && !canQA){ %><div class="alert alert-info">QA request is awaiting review by a QA/QC role.</div><% } else { %><h6 class="fw-bold">Uploaded Documents</h6><% if(pfiles.length){ %><div class="list-group list-group-flush mb-3"><% pfiles.forEach(f=>{ %><a class="list-group-item list-group-item-action py-2" target="_blank" href="/roadmap/files/<%= f.id %>"><i class="bi bi-file-earmark-text me-2"></i><%= f.document_type %> — <%= f.original_name %><span class="d-block small text-muted"><%= new Date(f.uploaded_at).toLocaleString('en-GB') %> · private file</span></a><% }) %></div><% }else{ %><p class="text-muted small">No documents uploaded.</p><% } %><details><summary class="small fw-bold">Document Requirement Reference (IMS.QA.004-F-01)</summary><div style="max-height:300px;overflow:auto" class="mt-2"><table class="table table-sm table-bordered"><tbody><% documentRequirements.forEach(r=>{ %><tr><% r.cells.forEach(c=>{ %><td class="small"><%= c %></td><% }) %></tr><% }) %></tbody></table></div></details><% } %></div></div></div></td></tr><% }) %>
<% if(!partners.length){ %><tr><td colspan="5" class="text-center py-4 text-muted">No partner records yet. Add a Registered record first.</td></tr><% } %></tbody></table></div></div></div></div>
<% if(partnerType==='CUSTOMER' && canEdit){ %>
<div class="modal fade" id="customerPricingModal" tabindex="-1" aria-labelledby="customerPricingModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="POST" id="customerPricingForm" action="/customers/0/pricing"><div class="modal-header"><div><h5 class="modal-title fw-bold" id="customerPricingModalLabel">Product Pricing</h5><div class="small text-muted" id="customerPricingSubtitle"></div></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="mb-3"><label class="form-label">Product Name</label><select class="form-select" name="product_code" required><option value="">Select product</option><% (salesProducts||[]).forEach(sp=>{ %><option value="<%= sp.code %>"><%= sp.name %></option><% }) %></select></div><div class="row g-3"><div class="col-6"><label class="form-label">Quantity</label><input class="form-control" name="quantity" type="number" min="0.000001" step="any" value="1" required></div><div class="col-6"><label class="form-label">UoM</label><select class="form-select" name="uom" required><option value="mCi">mCi</option></select></div><div class="col-12"><label class="form-label">Price (IDR for the quantity above)</label><input class="form-control" name="price" type="number" min="0" step="any" required></div></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary">Save Pricing</button></div></form></div></div></div>
<% } %>
</main></div><script>document.addEventListener('DOMContentLoaded',()=>{const s=document.getElementById('partnerSearch'),f=document.getElementById('partnerStatusFilter');document.getElementById('customerPricingModal')?.addEventListener('show.bs.modal',e=>{const b=e.relatedTarget;if(!b)return;const id=b.dataset.customerId||'0',name=b.dataset.customerName||'';document.getElementById('customerPricingForm').action='/customers/'+id+'/pricing';document.getElementById('customerPricingSubtitle').textContent=name;});function apply(){const q=(s?.value||'').toLowerCase().trim(),st=f?.value||'';document.querySelectorAll('#partnerTable tbody tr[data-partner-row]').forEach(r=>{const show=r.dataset.partnerSearch.includes(q)&&(!st||r.dataset.partnerStatus===st);r.hidden=!show;const detail=document.querySelector('#partnerTable tbody tr[data-partner-detail="'+r.dataset.partnerRow+'"]');if(detail)detail.hidden=!show;});}s?.addEventListener('input',apply);f?.addEventListener('change',apply);});</script><%- include('../partials/footer') %>
