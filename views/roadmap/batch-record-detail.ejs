<%- include('../partials/header', { title: template.title + ' | NUCLEA ERP' }) %>
<%- include('../partials/sidebar', { page: 'roadmap-batch-records' }) %>
<div class="app-wrapper"><%- include('../partials/headbar') %><main class="app-main">
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><a href="/manufacturing/batch-records" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Batch Record List</a><h3 class="fw-bold mt-2 mb-1"><%= template.title %></h3><div class="text-muted">Batch <%= batch.batch_id %></div></div><div class="d-flex gap-2"><span class="badge text-bg-primary align-self-start"><%= record.status %></span><a target="_blank" class="btn btn-outline-secondary btn-sm" href="/manufacturing/batch-records/<%= encodeURIComponent(batch.batch_id) %>/print/<%= record.id %>"><i class="bi bi-printer me-1"></i>Preview / Print</a></div></div>
<% if(query.error){ %><div class="alert alert-danger"><%= query.error %></div><% } %><% if(query.success){ %><div class="alert alert-success"><%= query.success %></div><% } %>
<div class="card"><div class="card-body"><div class="row g-3"><div class="col-md-3"><div class="small text-muted">Product</div><strong><%= batch.product_name %></strong></div><div class="col-md-3"><div class="small text-muted">Production Date</div><strong><%= batch.production_date ? new Date(batch.production_date).toLocaleDateString('en-GB') : '-' %></strong></div><div class="col-md-3"><div class="small text-muted">Calibration Time</div><strong><%= batch.calib_time || '-' %></strong></div></div><hr></div></div>
<% if(['IN_PROGRESS','REWORK_REQUIRED'].includes(record.status)){ %><form method="POST" action="/manufacturing/batch-records/<%= encodeURIComponent(batch.batch_id) %>/save/<%= record.id %>" id="recordForm">
<% const saved=record.data||{}; const totalRows=sections.reduce((s,x)=>s+x.rows.length,0); const doneRows=sections.reduce((n,s)=>n+s.rows.filter(r=>saved[`${s.index}_${r.row}`]&&saved[`${s.index}_${r.row}`].status&&saved[`${s.index}_${r.row}`].status!=='PENDING').length,0); %>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3"><div><strong>Completeness</strong><div class="small text-muted"><%= doneRows %> / <%= totalRows %> completed</div></div><div class="progress flex-grow-1" style="max-width:520px;height:12px"><div class="progress-bar" style="width:<%= totalRows?Math.round(doneRows/totalRows*100):0 %>%"></div></div></div>
<% sections.forEach((section,si)=>{ %><details class="card record-section" <%= si===0?'open':'' %>><summary class="card-header d-flex justify-content-between"><div><strong><%= section.title %></strong><div class="small text-muted"><%= section.rows.length %> items</div></div><span class="badge text-bg-light align-self-start"><%= section.actionable?'Entry required':'Reference' %></span></summary><div class="card-body p-0"><div class="table-responsive"><table class="table table-bordered align-middle mb-0 record-table"><thead class="table-light"><tr><th style="min-width:280px">Parameter / Procedure (source)</th><th style="min-width:100px">Status *</th><th style="min-width:170px">Actual / Result</th><th style="min-width:150px">Date & Time</th><th style="min-width:100px">Initial</th><th style="min-width:190px">Notes / Remark</th></tr></thead><tbody>
<% section.rows.forEach((row,ri)=>{ const k=`${section.index}_${row.row}`; const v=saved[k]||{}; %><tr><td><div class="fw-semibold small"><%= row.cells.join(' · ') %></div></td><td><select class="form-select form-select-sm rec-status" name="f_<%= section.index %>_<%= row.row %>_status" required><option value="PENDING" <%= !v.status||v.status==='PENDING'?'selected':'' %>>Select...</option><option value="PASS" <%= v.status==='PASS'?'selected':'' %>>PASS</option><option value="FAIL" <%= v.status==='FAIL'?'selected':'' %>>FAIL</option><option value="NA" <%= v.status==='NA'?'selected':'' %>>N/A</option></select></td><td><input class="form-control form-control-sm" name="f_<%= section.index %>_<%= row.row %>_actual" value="<%= v.actual||'' %>" placeholder="Actual result"></td><td><input class="form-control form-control-sm" name="f_<%= section.index %>_<%= row.row %>_time" type="datetime-local" value="<%= v.time||'' %>"></td><td><input class="form-control form-control-sm" name="f_<%= section.index %>_<%= row.row %>_initial" value="<%= v.initial||'' %>" placeholder="Initial"></td><td><input class="form-control form-control-sm" name="f_<%= section.index %>_<%= row.row %>_notes" value="<%= v.notes||'' %>" placeholder="Notes / deviation reference"></td></tr><% }) %>
</tbody></table></div></div></details><% }) %>
<div class="card"><div class="card-body d-flex flex-wrap gap-2 justify-content-between"><div class="small text-muted align-self-center">Save Draft does not submit to QA. Submit locks the record for QA review.</div><button type="submit" name="record_action" value="save" class="btn btn-outline-primary"><i class="bi bi-save me-1"></i>Save Draft</button><button type="submit" name="record_action" value="submit" class="btn btn-success" onclick="return confirm('Kirim record ini untuk QA Review? Pastikan seluruh status telah diisi; data akan dikunci.');"><i class="bi bi-send-check me-1"></i>Submit for QA Review</button></div></div>
</form><% } else { %><div class="alert alert-info">Current record status: <strong><%= record.status %></strong>. This record is read-only.</div><% } %>
</main></div>
<style>.record-section summary{cursor:pointer;list-style:none}.record-section summary::-webkit-details-marker{display:none}.record-section[open] summary{border-bottom:1px solid var(--kt-sidebar-border)}.record-table td{vertical-align:top}.record-section{overflow:hidden}.record-section .card-body{padding:0}</style>
<script>document.getElementById('recordForm')?.addEventListener('submit',function(e){const submitter=e.submitter;if(submitter&&submitter.value==='submit'){const selects=[...this.querySelectorAll('.rec-status')];const missing=selects.filter(s=>!s.value||s.value==='PENDING');if(missing.length){e.preventDefault();alert(`${missing.length} items are missing a PASS/FAIL/N/A status. Complete each section or select N/A when not applicable.`);const detail=missing[0].closest('details');if(detail)detail.open=true;missing[0].focus();}}});</script>
<%- include('../partials/footer') %>
