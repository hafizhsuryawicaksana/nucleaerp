<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= template.title %> - <%= batch.batch_id %></title><style>
*{box-sizing:border-box}body{font:10px Arial,sans-serif;color:#111;margin:12mm}h1{font-size:16px;margin:0 0 4px}h2{font-size:12px;border:1px solid #222;background:#eee;padding:5px;margin:18px 0 0;page-break-after:avoid}h3{font-size:10px;margin:12px 0 4px}.doc-head{border:2px solid #222;padding:10px;margin-bottom:10px}.doc-head .sub{display:flex;justify-content:space-between;gap:10px;margin-top:8px}.meta{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin:10px 0}.meta div{border:1px solid #aaa;padding:5px}.meta label{display:block;color:#555;font-size:8px;text-transform:uppercase}.cust-table,.record-table{width:100%;border-collapse:collapse;margin:0 0 8px;table-layout:fixed}.cust-table th,.cust-table td,.record-table th,.record-table td{border:1px solid #555;padding:3px;vertical-align:top;word-wrap:break-word}.cust-table th,.record-table th{background:#eee;font-weight:bold}.section-note{font-size:8px;color:#555;margin:3px 0}.signatures{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:18px}.signature{border:1px solid #555;min-height:90px;padding:6px;text-align:center}.signature img{max-width:120px;max-height:45px;object-fit:contain;display:block;margin:5px auto}.signature .line{margin-top:28px;border-top:1px solid #777;padding-top:3px}@page{size:A4;margin:10mm}@media print{body{margin:0}.no-print{display:none!important}h2{page-break-after:avoid}.record-table tr{page-break-inside:avoid}.section{page-break-inside:auto}.section-title{page-break-after:avoid}}
</style></head><body>
<div class="no-print" style="display:flex;justify-content:space-between;margin-bottom:12px"><strong>Preview / Print — <%= record.record_type %> / <%= batch.batch_id %></strong><button onclick="window.print()">Print / Save as PDF</button></div>
<div class="doc-head"><h1><%= template.title %></h1><div class="sub"><span>NUCLEA ERP · Electronic production record</span><span><strong>Status:</strong> <%= record.status %></span></div></div>
<div class="meta"><div><label>Batch No.</label><strong><%= batch.batch_id %></strong></div><div><label>Product Name</label><strong><%= batch.product_name %></strong></div><div><label>Production Date</label><strong><%= batch.production_date ? new Date(batch.production_date).toLocaleDateString('en-GB') : '-' %></strong></div></div>
<h2>Customer / Calibration Order</h2><table class="cust-table"><thead><tr><th>Customer</th><th>Calibration Time</th><th>Activity @ Calibration (mCi)</th><th>Arrival Time</th><th>Required Production Activity (mCi)</th><th>Vehicle</th></tr></thead><tbody><% customers.forEach(c=>{ %><tr><td><%= c.name %></td><td><%= c.calibration_time || '-' %></td><td><%= c.activity_at_cal_mci ?? '-' %></td><td><%= c.arrival_time || '-' %></td><td><%= c.required_production_activity_mci ?? '-' %></td><td><%= c.vehicle_no || '-' %></td></tr><% }) %></tbody></table>
<% const vals=record.data||{}; sections.forEach(section=>{ %><div class="section"><h2><%= section.title %></h2><% if(section.headers && section.headers.length){ %><div class="section-note">Source fields: <%= section.headers.join(' · ') %></div><% } %><table class="record-table"><thead><tr><th style="width:42%">Source / Parameter / Procedure</th><th style="width:8%">Status</th><th style="width:17%">Actual / Result</th><th style="width:13%">Date & Time</th><th style="width:7%">Initial</th><th style="width:13%">Remark</th></tr></thead><tbody>
<% section.rows.forEach(row=>{const d=vals[`${section.index}_${row.row}`]||{};%><tr><td><%= row.cells.join(' · ') %></td><td><%= d.status==='NA'?'N/A':d.status||'' %></td><td><%= d.actual||'' %></td><td><%= d.time||'' %></td><td><%= d.initial||'' %></td><td><%= d.notes||'' %></td></tr><% }) %>
<% if(!section.rows.length){ %><tr><td colspan="6">(No row defined)</td></tr><% } %></tbody></table></div><% }) %>
<div class="signatures"><div class="signature"><strong>Prepared / Started by</strong><% if(signers.started && signers.started.signature_file_id){ %><img src="/roadmap/files/<%= signers.started.signature_file_id %>" alt="Digital signature"><% } %><div class="line"><%= signers.started?.full_name || '-' %><br><%= signers.started?.role || '' %><br><%= record.started_at ? new Date(record.started_at).toLocaleString('en-GB') : '' %></div></div><div class="signature"><strong>Submitted by</strong><% if(signers.submitted && signers.submitted.signature_file_id){ %><img src="/roadmap/files/<%= signers.submitted.signature_file_id %>" alt="Digital signature"><% } %><div class="line"><%= signers.submitted?.full_name || '-' %><br><%= signers.submitted?.role || '' %><br><%= record.submitted_at ? new Date(record.submitted_at).toLocaleString('en-GB') : '' %></div></div><div class="signature"><strong>QA Review / Approval</strong><% if(signers.reviewed && signers.reviewed.signature_file_id){ %><img src="/roadmap/files/<%= signers.reviewed.signature_file_id %>" alt="Digital signature"><% } %><div class="line"><%= signers.reviewed?.full_name || '-' %><br><%= signers.reviewed?.role || '' %><br><%= record.reviewed_at ? new Date(record.reviewed_at).toLocaleString('en-GB') : '' %></div></div></div>
<p style="margin-top:12px;font-size:8px;color:#555">Generated: <%= new Date().toLocaleString('en-GB') %>. Hash/digital signature authorization and controlled document requirements must be approved by QA. This report is a reconstruction of the supplied form structure.</p>
</body></html>
