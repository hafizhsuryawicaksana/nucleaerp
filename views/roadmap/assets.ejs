<%- include('../partials/header', { title: 'Asset Management | NUCLEA ERP' }) %>
<%- include('../partials/sidebar', { page: 'roadmap-assets' }) %>
<div class="app-wrapper"><%- include('../partials/headbar') %><main class="app-main">
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><div class="text-primary small fw-bold text-uppercase">Assets & Facilities</div><h3 class="fw-bold mb-1">Asset Management</h3><p class="text-muted mb-0">Asset register, department transfers, and controlled disposal.</p></div><div class="d-flex gap-2"><% if(canSCM){ %><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#assetCreateModal"><i class="bi bi-plus-circle me-1"></i>Add Asset</button><% } %></div></div>
<% if(query.success){ %><div class="alert alert-success"><i class="bi bi-check-circle me-2"></i><%= query.success %></div><% } %><% if(query.error){ %><div class="alert alert-danger"><i class="bi bi-exclamation-circle me-2"></i><%= query.error %></div><% } %>
<div class="row g-3 mb-4 align-items-stretch">
  <div class="col-lg-3"><div class="card h-100 border-0" style="background:linear-gradient(140deg,#2357a7,#4e9dda);color:#fff"><div class="card-body d-flex flex-column justify-content-between"><div class="small text-white-50 text-uppercase fw-bold" style="letter-spacing:.12em">Total Asset</div><div class="display-4 fw-bold"><%= assets.filter(a=>a.status!=='DISPOSED'&&a.status!=='ARCHIVED'&&a.is_active!==false).length %></div><div class="small text-white-50"><i class="bi bi-box-seam me-1"></i>Registered active assets</div></div></div></div>
  <div class="col-lg-9"><div class="card h-100"><div class="card-header"><strong>Assets by Department</strong></div><div class="card-body"><% const deptRows=typeof departmentSummary!=='undefined'&&departmentSummary?departmentSummary:[]; const maxDept=Math.max(1,...deptRows.map(d=>Number(d.asset_count||0))); %><% if(deptRows.length){ %><div class="row g-3"><% deptRows.forEach(d=>{ %><div class="col-md-6"><div class="d-flex justify-content-between align-items-center gap-3 mb-2"><span class="fw-semibold"><%= d.department %></span><span class="fw-bold"><%= d.asset_count %></span></div><div class="progress" style="height:7px;background:#eaf0f7"><div class="progress-bar" role="progressbar" style="width:<%= Math.max(3,Number(d.asset_count||0)/maxDept*100) %>%;background:linear-gradient(90deg,#2e70bd,#56a9df)" aria-valuenow="<%= d.asset_count %>" aria-valuemin="0" aria-valuemax="<%= maxDept %>"></div></div></div><% }) %></div><% } else { %><div class="text-muted small py-3">No department data available.</div><% } %></div></div></div>
</div>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3"><h5 class="fw-bold mb-0">Asset Register</h5><div class="d-flex flex-wrap gap-2"><input class="form-control" id="assetSearch" style="min-width:240px;max-width:340px" placeholder="Search code, name, or department..." aria-label="Cari aset"><select class="form-select" id="assetStatusFilter" style="min-width:170px"><option value="">All asset statuses</option><% [...new Set(assets.map(a=>a.status||'AVAILABLE'))].sort().forEach(st=>{ %><option value="<%= st %>"><%= st %></option><% }) %></select></div></div>
<div class="row g-3 mb-4" id="assetCards"><% assets.forEach(a=>{ %><div class="col-xl-3 col-lg-4 col-md-6 asset-card-col" data-search="<%= (a.asset_code+' '+a.name+' '+(a.department||'')+' '+(a.brand||'')).toLowerCase() %>" data-asset-status="<%= a.status||'AVAILABLE' %>"><div class="card h-100 overflow-hidden"><% if(a.photo_doc_id){ %><img src="/roadmap/files/<%= a.photo_doc_id %>" class="asset-photo card-img-top" alt="Photo <%= a.name %>"><% } else { %><div class="asset-photo d-flex align-items-center justify-content-center"><i class="bi bi-box-seam display-3 text-secondary"></i></div><% } %><div class="card-body"><div class="d-flex flex-wrap justify-content-between gap-2"><span class="badge text-bg-light border"><%= a.asset_code %></span><span class="badge <%= a.status==='AVAILABLE'?'text-bg-success':a.status==='DISPOSED'?'text-bg-secondary':a.status==='ARCHIVED'?'text-bg-dark':'text-bg-warning' %>"><%= a.status||'AVAILABLE' %></span></div><h6 class="fw-bold mt-3 mb-1"><%= a.name %></h6><div class="small text-muted"><%= a.brand||'Brand not set' %> · <%= a.asset_type||a.category||'Type not set' %></div><div class="small mt-3"><i class="bi bi-building me-1 text-muted"></i><%= a.department||'-' %></div><div class="small text-muted mt-1">Acquired: <%= a.acquisition_date?new Date(a.acquisition_date).toLocaleDateString('en-GB'):'-' %></div></div><div class="card-footer d-flex flex-wrap gap-2"><button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#assetDetails-<%= a.id %>"><i class="bi bi-eye me-1"></i>Details</button><% if(canSCM&&a.status!=='DISPOSED'&&a.status!=='ARCHIVED'){ %><button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#assetRequest-<%= a.id %>"><i class="bi bi-arrow-left-right me-1"></i>Transfer / Disposal</button><% } %><% if(canSCM&&a.status==='ARCHIVED'){ %><form method="post" action="/assets/<%= a.id %>/restore" onsubmit="return confirm('Reactivate kembali aset ini?');"><button class="btn btn-sm btn-outline-success">Reactivate</button></form><% }else if(canSCM&&a.status!=='DISPOSED'){ %><form method="post" action="/assets/<%= a.id %>/archive" onsubmit="return confirm('Archive this asset? History will be retained.');"><button class="btn btn-sm btn-outline-secondary">Archive</button></form><% } %><% if(canSCM){ %><form method="post" action="/assets/<%= a.id %>/delete" onsubmit="return confirm('PERMANENTLY DELETE asset <%= a.asset_code %> — <%= a.name %>? Deletion is blocked if requests, events, or documents are linked.');"><input type="hidden" name="reason" value="Data cleanup"><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button></form><% } %></div></div></div><% }) %><% if(!assets.length){ %><div class="col-12"><div class="card"><div class="card-body text-center text-muted py-5">No assets registered. Select Add Asset to create one.</div></div></div><% } %></div>
<div class="card"><div class="card-header"><div><strong>Transfer / Disposal Requests</strong><div class="small text-muted">Requests record the requester, reviewer, time, reason, and decision.</div></div><span class="small text-muted"><%= requests.length %> requests</span></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Time</th><th>Asset</th><th>Type</th><th>Details</th><th>Status</th><th>Action</th></tr></thead><tbody><% requests.forEach(r=>{ %><tr><td class="small"><%= new Date(r.requested_at).toLocaleString('en-GB') %></td><td><strong><%= r.asset_code %></strong><div class="small text-muted"><%= r.asset_name %></div></td><td><%= r.request_type==='MUTATION'?'Department Transfer':'Disposal' %></td><td class="small"><%= r.current_department||'-' %> → <%= r.target_department||r.waste_classification||'-' %><div><%= r.reason||'' %></div></td><td><span class="badge <%= r.status==='APPROVED'?'text-bg-success':r.status==='REJECTED'?'text-bg-danger':'text-bg-warning' %>"><%= r.status %></span><% if(r.approval_note){ %><div class="small text-muted mt-1"><%= r.approval_note %></div><% } %></td><td><% if(r.status==='PENDING_APPROVAL'&&canApprove){ %><button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#assetDecision-<%= r.id %>">Review</button><% }else{ %><span class="small text-muted">—</span><% } %></td></tr><% }) %><% if(!requests.length){ %><tr><td colspan="6" class="text-center text-muted py-4">No transfer or disposal requests.</td></tr><% } %></tbody></table></div></div>

<% if(canSCM){ %><div class="modal fade" id="assetCreateModal" tabindex="-1" aria-labelledby="assetCreateModalLabel" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><form method="post" action="/assets/create" enctype="multipart/form-data"><div class="modal-header"><h5 class="modal-title fw-bold" id="assetCreateModalLabel">Add Asset to Catalog</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">Asset Code *</label><input class="form-control" name="asset_code" required maxlength="50"></div><div class="col-md-6"><label class="form-label">Asset Name *</label><input class="form-control" name="name" required></div><div class="col-md-6"><label class="form-label">Category</label><input class="form-control" name="category" placeholder="Machine / Vehicle / IT"></div><div class="col-md-6"><label class="form-label">Department *</label><input class="form-control" name="department" required></div><div class="col-md-6"><label class="form-label">Acquisition Date *</label><input type="date" class="form-control" name="acquisition_date" required></div><div class="col-md-6"><label class="form-label">Brand *</label><input class="form-control" name="brand" required></div><div class="col-md-6"><label class="form-label">Asset Type *</label><input class="form-control" name="asset_type" required></div><div class="col-md-6"><label class="form-label">Serial Number</label><input class="form-control" name="serial_number"></div><div class="col-12"><label class="form-label">Purpose *</label><textarea class="form-control" name="purpose" rows="2" required></textarea></div><div class="col-12"><label class="form-label">Asset Photo *</label><input type="file" class="form-control" name="asset_photo" accept="image/png,image/jpeg,image/webp" required><div class="form-text">PNG/JPG/WebP. Stored as a private application document.</div></div></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary"><i class="bi bi-save me-1"></i>Save Asset</button></div></form></div></div></div><% } %>

<% assets.forEach(a=>{ const relatedRequests=requests.filter(r=>Number(r.asset_id)===Number(a.id)); const relatedEvents=(typeof assetEvents!=='undefined'?assetEvents:[]).filter(e=>Number(e.asset_id)===Number(a.id)); %><div class="modal fade" id="assetDetails-<%= a.id %>" tabindex="-1" aria-labelledby="assetDetailsLabel-<%= a.id %>" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><div><h5 class="modal-title fw-bold" id="assetDetailsLabel-<%= a.id %>"><%= a.asset_code %> — <%= a.name %></h5><div class="small text-muted">Asset detail & change history</div></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-5"><% if(a.photo_doc_id){ %><img src="/roadmap/files/<%= a.photo_doc_id %>" alt="Photo <%= a.name %>" class="img-fluid rounded border w-100" style="max-height:300px;object-fit:contain"><% }else{ %><div class="border rounded text-center p-5"><i class="bi bi-box-seam display-2"></i><p class="small text-muted">No photo</p></div><% } %></div><div class="col-md-7"><div class="d-flex justify-content-between"><span class="badge text-bg-light border"><%= a.asset_code %></span><span class="badge <%= a.status==='AVAILABLE'?'text-bg-success':a.status==='DISPOSED'?'text-bg-secondary':a.status==='ARCHIVED'?'text-bg-dark':'text-bg-warning' %>"><%= a.status %></span></div><dl class="row mt-3 small mb-0"><dt class="col-5">Name</dt><dd class="col-7"><%= a.name %></dd><dt class="col-5">Category</dt><dd class="col-7"><%= a.category||'-' %></dd><dt class="col-5">Department</dt><dd class="col-7"><%= a.department||'-' %></dd><dt class="col-5">Acquisition Date</dt><dd class="col-7"><%= a.acquisition_date?new Date(a.acquisition_date).toLocaleDateString('en-GB'):'-' %></dd><dt class="col-5">Brand / Type</dt><dd class="col-7"><%= a.brand||'-' %> / <%= a.asset_type||'-' %></dd><dt class="col-5">Serial Number</dt><dd class="col-7"><%= a.serial_number||'-' %></dd><dt class="col-5">Current Location</dt><dd class="col-7"><%= a.current_location||'-' %></dd><dt class="col-5">Purpose</dt><dd class="col-7"><%= a.purpose||'-' %></dd><dt class="col-5">Created / Updated</dt><dd class="col-7"><%= a.created_at?new Date(a.created_at).toLocaleString('en-GB'):'-' %><br><%= a.updated_at?new Date(a.updated_at).toLocaleString('en-GB'):'-' %></dd></dl></div></div><hr><h6 class="fw-bold">Request History</h6><% if(relatedRequests.length){ %><div class="table-responsive"><table class="table table-sm"><thead class="table-light"><tr><th>Date</th><th>Type</th><th>Status</th><th>Reason / Decision</th></tr></thead><tbody><% relatedRequests.forEach(r=>{ %><tr><td><%= new Date(r.requested_at).toLocaleDateString('en-GB') %></td><td><%= r.request_type %></td><td><%= r.status %></td><td><%= r.reason||'-' %><% if(r.approval_note){ %><div class="small text-muted"><%= r.approval_note %></div><% } %></td></tr><% }) %></tbody></table></div><% }else{ %><p class="text-muted small">No asset change requests.</p><% } %><h6 class="fw-bold mt-3">Asset History</h6><% if(relatedEvents.length){ %><div class="table-responsive"><table class="table table-sm"><thead class="table-light"><tr><th>Time</th><th>Event</th><th>Actor</th><th>Details</th></tr></thead><tbody><% relatedEvents.forEach(e=>{ %><tr><td class="small"><%= new Date(e.occurred_at).toLocaleString('en-GB') %></td><td><%= e.event_type %></td><td><%= e.actor_name||'-' %></td><td class="small"><%= JSON.stringify(e.event_data||{}) %></td></tr><% }) %></tbody></table></div><% }else{ %><p class="text-muted small">No additional events recorded.</p><% } %></div><div class="modal-footer"><button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button><% if(canSCM&&a.status!=='DISPOSED'&&a.status!=='ARCHIVED'){ %><button class="btn btn-primary" data-bs-dismiss="modal" data-open-after-close="#assetRequest-<%= a.id %>">Request Transfer / Disposal</button><% } %></div></div></div></div>
<% if(canSCM&&a.status!=='DISPOSED'&&a.status!=='ARCHIVED'){ %><div class="modal fade" id="assetRequest-<%= a.id %>" tabindex="-1" aria-labelledby="assetRequestLabel-<%= a.id %>" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><form method="post" action="/assets/<%= a.id %>/request" class="asset-request-form" data-asset-id="<%= a.id %>"><div class="modal-header"><h5 class="modal-title fw-bold" id="assetRequestLabel-<%= a.id %>">Transfer / Disposal Requests — <%= a.asset_code %></h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="mb-3"><label class="form-label">Type requests *</label><select class="form-select asset-request-type" name="request_type" data-asset-id="<%= a.id %>" required><option value="MUTATION">Department Transfer</option><option value="DISPOSAL">Disposal</option></select></div><div id="mutationFields-<%= a.id %>" class="row g-3"><div class="col-md-6"><label class="form-label">Destination Department *</label><input class="form-control" name="target_department" required></div><div class="col-md-6"><label class="form-label">Recipient / Owner *</label><input class="form-control" name="handover_to" required></div></div><div class="mb-3 mt-3"><label class="form-label">Reason / purpose *</label><textarea class="form-control" name="reason" rows="2" required></textarea></div><div class="mb-3"><label class="form-label">Additional details</label><textarea class="form-control" name="purpose" rows="2"></textarea></div><div id="disposalFields-<%= a.id %>" hidden><div class="alert alert-warning small">For disposal, all EHS checklist items must be reviewed. Completing this form does not replace company safety or radiation-protection approvals.</div><h6 class="fw-bold">EHS Disposal Checklist</h6><div class="row g-2"><% [['free_from_b3','Free of Hazardous Materials'],['surface_dose_measured','Surface Dose Measurement'],['free_from_contamination','Free of Contamination'],['free_from_oil_fuel_chemicals','Free of Oil / Fuel / Chemicals'],['free_from_pressurized_gas','Free of Pressurized Gas / Refrigerant'],['data_storage_destroyed','Data Storage Media Destroyed'],['heavy_metals','Heavy Metal Assessment'],['company_identity_removed','Company Identity Removed']].forEach(x=>{ %><div class="col-md-6"><label class="form-label small"><%= x[1] %> *</label><select class="form-select form-select-sm disposal-required" name="<%= x[0] %>"><option value="">Select</option><option value="YES">Yes / clear</option><option value="NO">No / mitigation required</option><option value="NA">Not applicable</option></select></div><% }) %><div class="col-md-6"><label class="form-label small">Surface Dose Rate and Unit *</label><input type="number" step="0.001" class="form-control form-control-sm disposal-required" name="surface_dose_rate"></div><div class="col-md-6"><label class="form-label small">Waste Classification *</label><select class="form-select form-select-sm disposal-required" name="waste_classification"><option value="">Select</option><option value="NON_B3">NON_B3</option><option value="B3">B3</option><option value="RADIOACTIVE">RADIOACTIVE</option></select></div></div></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary"><i class="bi bi-send me-1"></i>Submit Requests</button></div></form></div></div></div><% } %><% }) %>
<% requests.filter(r=>r.status==='PENDING_APPROVAL'&&canApprove).forEach(r=>{ %><div class="modal fade" id="assetDecision-<%= r.id %>" tabindex="-1" aria-labelledby="assetDecisionLabel-<%= r.id %>" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" action="/assets/requests/<%= r.id %>/decision"><div class="modal-header"><h5 class="modal-title fw-bold" id="assetDecisionLabel-<%= r.id %>">Review Asset Requests</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><p><strong><%= r.asset_code %> — <%= r.asset_name %></strong><br><%= r.request_type==='MUTATION'?'Department Transfer':'Disposal' %></p><div class="small text-muted mb-3"><%= r.current_department||'-' %> → <%= r.target_department||r.waste_classification||'-' %><br>Reason: <%= r.reason||'-' %></div><label class="form-label">Decision / rejection reason *</label><textarea class="form-control" name="approval_note" required rows="3"></textarea></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button name="decision" value="REJECT" class="btn btn-outline-danger">Reject</button><button name="decision" value="APPROVE" class="btn btn-success">Approve</button></div></form></div></div></div><% }) %>
</main></div>
<script>
document.addEventListener('DOMContentLoaded',()=>{
 const search=document.getElementById('assetSearch'),status=document.getElementById('assetStatusFilter');const applyAssetFilters=()=>{const q=(search?.value||'').trim().toLowerCase(),st=status?.value||'';document.querySelectorAll('.asset-card-col').forEach(el=>el.hidden=!(el.dataset.search.includes(q)&&(!st||el.dataset.assetStatus===st)));};search?.addEventListener('input',applyAssetFilters);status?.addEventListener('change',applyAssetFilters);
 const setMode=(id,type)=>{const mut=document.getElementById('mutationFields-'+id),dis=document.getElementById('disposalFields-'+id);if(!mut||!dis)return;const isDisposal=type==='DISPOSAL';mut.hidden=isDisposal;dis.hidden=!isDisposal;mut.querySelectorAll('input').forEach(el=>{el.disabled=isDisposal;el.required=!isDisposal;});dis.querySelectorAll('.disposal-required').forEach(el=>{el.disabled=!isDisposal;el.required=isDisposal;});};
 document.querySelectorAll('.asset-request-type').forEach(el=>{const id=el.dataset.assetId;setMode(id,el.value);el.addEventListener('change',()=>setMode(id,el.value));});
 document.querySelectorAll('[data-open-after-close]').forEach(btn=>btn.addEventListener('click',()=>{const current=btn.closest('.modal');const selector=btn.getAttribute('data-open-after-close');const next=document.querySelector(selector);if(!current||!next)return;current.addEventListener('hidden.bs.modal',()=>bootstrap.Modal.getOrCreateInstance(next).show(),{once:true});bootstrap.Modal.getOrCreateInstance(current).hide();}));
});
</script>
<%- include('../partials/footer') %>
