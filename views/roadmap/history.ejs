<%- include('../partials/header', { title: 'Manufacturing / Production History | NUCLEA ERP' }) %>
<%- include('../partials/sidebar', { page: 'roadmap-history' }) %>
<div class="app-wrapper"><%- include('../partials/headbar') %><main class="app-main">
<div class="mb-4"><h3 class="fw-bold mb-1">Production History</h3><div class="text-muted">A batch enters history after e-BMR and e-BPR are submitted for review. Upload the CoA and complete QA review before distribution.</div></div>
<% if(query.error){ %><div class="alert alert-danger"><%= query.error %></div><% } %>
<div class="card"><div class="card-body border-bottom"><input id="historySearch" class="form-control" placeholder="Search batch, product, or customer…"></div><div class="table-responsive"><table id="historyTable" class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Batch / Product</th><th>Production Date</th><th>Customer(s)</th><th>BMR / BPR</th><th>CoA</th><th>QA Disposition</th><th style="min-width:300px">Action / Review</th></tr></thead><tbody>
<% batches.forEach(b=>{ %><tr data-history-search="<%= (b.batch_id+' '+b.work_order_no+' '+b.product_name+' '+(b.customer_names||'')).toLowerCase() %>"><td><div class="fw-bold"><%= b.batch_id %></div><div class="small text-muted"><%= b.product_name %> (<%= b.product_code %>)</div></td><td><%= b.production_date ? new Date(b.production_date).toLocaleDateString('en-GB') : '-' %></td><td><%= b.customer_names || '-' %></td><td><div>BMR: <span class="badge text-bg-light"><%= b.bmr_status || 'Not started' %></span></div><div class="mt-1">BPR: <span class="badge text-bg-light"><%= b.bpr_status || 'Not started' %></span></div><div class="d-flex flex-wrap gap-1 mt-2"><% if(b.bmr_id){ %><a class="btn btn-sm btn-outline-secondary" target="_blank" href="/manufacturing/batch-records/<%= encodeURIComponent(b.batch_id) %>/print/<%= b.bmr_id %>">Print BMR</a><% } %><% if(b.bpr_id){ %><a class="btn btn-sm btn-outline-secondary" target="_blank" href="/manufacturing/batch-records/<%= encodeURIComponent(b.batch_id) %>/print/<%= b.bpr_id %>">Print BPR</a><% } %></div></td><td><% if(Number(b.coa_count)>0){ %><span class="badge text-bg-success"><%= b.coa_count %> file(s)</span><% (b.coa_file_ids||'').split(',').filter(Boolean).forEach(id=>{ %><a class="d-block small" href="/roadmap/files/<%= id %>" target="_blank">Open CoA <%= id %></a><% }) %><% }else{ %><span class="badge text-bg-warning">Missing</span><% } %><% if(b.production_status!=='QA_RELEASED' && b.production_status!=='REJECTED'){ %><form method="POST" enctype="multipart/form-data" action="/manufacturing/history/<%= encodeURIComponent(b.batch_id) %>/coa" class="mt-2" data-popup-form-title="Upload CoA — <%= b.batch_id %>" data-popup-form-button="Upload CoA" data-popup-form-size="md"><input name="coa_document" type="file" class="form-control form-control-sm mb-1" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg" required><button class="btn btn-sm btn-outline-primary">Upload CoA</button></form><% } %></td><td><span class="badge <%= b.qa_disposition==='RELEASED'?'text-bg-success':b.qa_disposition==='REJECTED'?'text-bg-danger':'text-bg-warning' %>"><%= b.qa_disposition || 'PENDING' %></span><div class="small text-muted">Production: <%= b.production_status %></div></td><td>
<% if(canQA && b.bmr_status==='SUBMITTED_FOR_REVIEW' && b.bpr_status==='SUBMITTED_FOR_REVIEW' && Number(b.coa_count)>0){ %><form method="POST" action="/manufacturing/history/<%= encodeURIComponent(b.batch_id) %>/review" class="border rounded p-2" data-popup-form-title="QA Batch Review / Release — <%= b.batch_id %>" data-popup-form-button="QA Review / Release" data-popup-form-size="md"><label class="small fw-bold">QA Batch Review / Release</label><textarea class="form-control form-control-sm mb-2" name="review_note" rows="2" placeholder="QA review notes / deviation reference"></textarea><label class="small fw-bold">PIN re-authentication</label><input type="password" class="form-control form-control-sm mb-2" name="pin" required autocomplete="current-password" placeholder="PIN QA"><div class="d-flex gap-2"><button name="decision" value="APPROVE" class="btn btn-sm btn-success" onclick="return confirm('Approve BMR/BPR and release batch?');">Approve & Release</button><button name="decision" value="REJECT" class="btn btn-sm btn-danger" onclick="return confirm('Return batch for rework?');">Reject / Rework</button></div></form><% } else if(b.production_status==='QA_RELEASED'){ %><span class="text-success small"><i class="bi bi-check-circle-fill me-1"></i>QA released; ready for Distribution.</span><% } else { %><span class="small text-muted">Awaiting two completed records and the CoA for QA review.</span><% } %>
</td></tr><% }) %>
<% if(!batches.length){ %><tr><td colspan="7" class="text-center py-5 text-muted">No batches in history.</td></tr><% } %>
</tbody></table></div></div>

</main></div><script>document.addEventListener('DOMContentLoaded',()=>{const s=document.getElementById('historySearch');s?.addEventListener('input',()=>{const q=s.value.toLowerCase().trim();document.querySelectorAll('#historyTable tbody tr[data-history-search]').forEach(r=>r.hidden=!r.dataset.historySearch.includes(q));});});</script><%- include('../partials/footer') %>
