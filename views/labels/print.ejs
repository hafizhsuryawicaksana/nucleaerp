<% const vial=String(payload.label_type||job.label_type).toUpperCase()==='VIAL'; const esc=v=>String(v??'').trim()||'—'; const dateTime=v=>{if(!v)return '—';const d=new Date(v);return Number.isNaN(d.getTime())?esc(v):d.toLocaleString('en-GB',{day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit',hour12:false});}; const activity=Number(payload.activity_mci||0); const activityMbq=(activity*37).toLocaleString('en-GB',{maximumFractionDigits:0}); const concentration=esc(payload.activity_concentration); const price=payload.het_price_per_vial===null||payload.het_price_per_vial===undefined?'—':new Intl.NumberFormat('en-US',{style:'currency',currency:'IDR',maximumFractionDigits:0}).format(Number(payload.het_price_per_vial)); %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= vial?'Vial Label':'Leadpot Label' %> · <%= payload.batch_id %></title><style>
*{box-sizing:border-box}html,body{margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;color:#182133;background:#f2f5f9}body{padding:18px}.toolbar{max-width:1000px;margin:0 auto 14px;display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:13px}.toolbar .small{color:#64748b;font-size:11px;margin-top:3px}.btn{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:7px;background:#2357a7;color:white;text-decoration:none;font-size:12px;font-weight:700;padding:9px 13px;cursor:pointer}.btn.secondary{background:#526174}.label{background:#fff;border:1px solid #4b4b4b;overflow:hidden;position:relative;margin:0 auto;page-break-inside:avoid}.label.vial{width:75mm;height:25mm;padding:1.35mm 1.5mm;border-radius:0}.label.leadpot{width:160mm;height:60mm;padding:2.4mm;border-radius:2mm}.brand{color:#2756a6;font-weight:800;letter-spacing:-.04em;white-space:nowrap}.vial .brand{font-size:14pt;line-height:1}.leadpot .brand{font-size:22pt;line-height:1.0}.subbrand{color:#5da8e1;font-weight:600}.radio-logo{display:inline-flex;align-items:center;justify-content:center;width:7mm;height:7mm;border-radius:50%;background:#ffeb14;border:1px solid #111;color:#111;font-size:18pt;line-height:1;flex-shrink:0}.kmark{display:inline-flex;align-items:center;justify-content:center;width:7mm;height:7mm;border-radius:50%;background:#d50000;border:1px solid #111;color:#050505;font-size:20pt;font-family:Arial,sans-serif;font-weight:900;line-height:1;flex-shrink:0}.vial-brandline{display:flex;justify-content:space-between;align-items:flex-start;gap:1.5mm}.vial-brandblock{width:44%;}.isotope{font-size:7pt;line-height:1.1;color:#2f5294;margin-top:.5mm}.vial-grid{position:absolute;left:35mm;right:2mm;top:2mm;bottom:6mm;display:grid;grid-template-columns:1fr 1.25fr;grid-template-rows:repeat(4,auto);column-gap:1.5mm;align-content:start;font-size:5.2pt;line-height:1.12}.field{display:grid;grid-template-columns:auto 1fr;gap:.7mm;min-width:0;align-items:baseline;margin:0 0 .55mm}.field b{font-weight:700}.field .value{font-weight:600;min-width:0;overflow-wrap:anywhere}.vial-footer{position:absolute;left:2mm;right:2mm;bottom:1.1mm;display:flex;align-items:flex-end;justify-content:space-between;font-size:5.1pt;line-height:1.05}.vial-moa{max-width:51mm;text-align:center}.vial-symbols{display:flex;gap:1mm;align-items:center}.leadpot-top{display:grid;grid-template-columns:62% 38%;gap:3mm;height:18mm}.leadpot-title{display:flex;align-items:flex-start;gap:1mm}.leadpot-symbols{display:flex;gap:1.5mm;justify-content:flex-end;margin-top:1mm}.leadpot-fields{display:grid;grid-template-columns:1fr 1.2fr;column-gap:4mm;row-gap:.6mm;font-size:7.4pt;line-height:1.05;padding-top:.3mm}.leadpot-fields .field{margin:0;gap:1mm}.leadpot-body{display:grid;grid-template-columns:63% 37%;height:31mm;gap:3mm;margin-top:.8mm}.leadpot-copy{font-size:7pt;line-height:1.12;padding-top:1mm}.leadpot-copy .blue{color:#5fa8e2;font-size:8pt;margin-bottom:.6mm}.leadpot-copy .line{margin:.5mm 0}.leadpot-bottom{display:grid;grid-template-columns:22% 43% 35%;align-items:end;gap:1.5mm;height:8mm;font-size:6.2pt;line-height:1.08}.ims-mark{font-size:23pt;color:#31599e;letter-spacing:-.06em;font-weight:500;line-height:1}.address{font-size:6.3pt;line-height:1.2}.qr{width:17mm;height:17mm;display:flex;align-items:center;justify-content:center}.qr svg{width:100%;height:100%}.warning{font-size:7pt;font-weight:800;text-align:right}.leadpot-right-bottom{display:flex;align-items:end;justify-content:space-between;gap:2mm}.prescription{font-size:7pt;font-weight:800;color:#1e438b;text-align:right;margin-top:1mm}.small-line{font-size:6pt;color:#334155}.print-meta{display:none}
@page vial{size:75mm 25mm;margin:0}@page leadpot{size:160mm 60mm;margin:0}.label.vial{page:vial}.label.leadpot{page:leadpot}
@media print{html,body{background:#fff!important;padding:0;margin:0}.toolbar{display:none}.label{margin:0;border:1px solid #444;box-shadow:none}.label.vial{width:75mm;height:25mm;padding:1.35mm 1.5mm}.label.leadpot{width:160mm;height:60mm;padding:2.4mm}body{padding:0}}
</style></head><body><div class="toolbar"><div><strong><%= vial?'Vial Label':'Leadpot Label' %></strong><div class="small"><%= payload.batch_id %> · <%= payload.entity_id %></div></div><div><button class="btn" onclick="window.print()">Print Label</button> <a class="btn secondary" href="/erp/labels">Back</a></div></div>
<% if(vial){ %>
<div class="label vial"><div class="vial-brandline"><div class="vial-brandblock"><div class="brand"><%= esc(payload.product_name||'IMSCan-GluTrace') %></div><div class="isotope"><%= esc(payload.isotope_name||'¹⁸F-Fludeoxyglucose') %></div></div></div>
<div class="vial-grid">
<div class="field"><b>Batch No.</b><span class="value">: <%= esc(payload.batch_id) %></span></div><div class="field"><b>Customer</b><span class="value">: <%= esc(payload.customer_name) %></span></div>
<div class="field"><b>Activity Conc.</b><span class="value">: <%= concentration %> mCi/mL</span></div><div class="field"><b>Mfg. Date</b><span class="value">: <%= dateTime(payload.manufacture_datetime) %></span></div>
<div class="field"><b>Activity</b><span class="value">: <%= esc(payload.activity_mci) %> mCi</span></div><div class="field"><b>Exp. Date</b><span class="value">: <%= dateTime(payload.expiry_datetime) %></span></div>
<div class="field"><b>Volume</b><span class="value">: <%= esc(payload.volume_ml) %> mL</span></div><div class="field"><b>Synthesis Route</b><span class="value">: <%= esc(payload.synthesis_route) %></span></div>
</div><div class="vial-footer"><div class="vial-moa">Marketing Authorization No.<br><b><%= esc(payload.marketing_authorization_no) %></b><br><span><%= esc(payload.time_reference||'WIB / UTC+7') %></span></div><div class="vial-symbols"><span class="radio-logo">☢</span><span class="kmark">K</span></div></div></div>
<% }else{ %>
<div class="label leadpot"><div class="leadpot-top"><div><div class="leadpot-title"><div><div class="brand"><%= esc(payload.product_name||'IMSCan-GluTrace') %></div><div class="isotope" style="font-size:10pt;margin-top:1mm"><%= esc(payload.isotope_name||'¹⁸F-Fludeoxyglucose') %></div></div></div><div class="small-line" style="margin-top:2mm"><%= esc(payload.pharmaceutical_form||'Injection') %></div></div><div class="leadpot-fields">
<div class="field"><b>Batch No.</b><span class="value">: <%= esc(payload.batch_id) %></span></div><div class="field"><b>Mfg. Date</b><span class="value">: <%= dateTime(payload.manufacture_datetime) %></span></div>
<div class="field"><b>Exp. Date</b><span class="value">: <%= dateTime(payload.expiry_datetime) %></span></div><div class="field"><b>Volume</b><span class="value">: <%= esc(payload.volume_ml) %> mL</span></div>
<div class="field"><b>Activity Conc.</b><span class="value">: <%= concentration %> mCi/mL</span></div><div class="field"><b>Activity</b><span class="value">: <%= esc(payload.activity_mci) %> mCi</span></div>
<div class="field" style="grid-column:1/3"><b>Customer Name</b><span class="value">: <%= esc(payload.customer_name) %></span></div>
</div></div>
<div class="leadpot-body"><div class="leadpot-copy"><div class="blue">Pharmaceutical form: <%= esc(payload.pharmaceutical_form||'Injection') %></div><div><%= esc(payload.pig_lead_statement) %></div><div class="line"><b>Composition:</b> <%= esc(payload.composition) %></div><div class="line"><b>Storage:</b> <%= esc(payload.storage_instruction) %></div></div><div><div style="font-size:7.5pt;font-weight:700;text-align:right;margin-bottom:1.2mm">HET: <%= price %> / Vial</div><div style="font-size:7pt;font-weight:700;text-align:right">DO NOT STORE ABOVE 30°C</div><div style="font-size:7pt;text-align:right;margin-top:1mm">Time Reference<br><b><%= esc(payload.time_reference||'WIB / UTC+7') %></b></div><div class="leadpot-symbols"><span class="radio-logo">☢</span><span class="kmark">K</span></div><div class="warning">Caution: Radioactive Material</div><div class="prescription">HARUS DENGAN RESEP DOKTER</div></div></div>
<div class="leadpot-bottom"><div><div class="ims-mark">IMS</div><div class="small-line" style="font-weight:700">INTERSKALA MEDIKA SOLUSINDO</div></div><div class="address"><b>Registered by <%= esc(payload.registered_by_name||'PT Interskala Medika Solusindo') %></b><br><%= esc(payload.registered_address||'Rukan Crown, Greenlake City B06 Tangerang - Indonesia') %><br><br><b>Manufactured by <%= esc(payload.manufacturer_name||'PT Interskala Medika Solusindo') %></b><br><%= esc(payload.manufacturing_address||'KEK Industri Batang - Indonesia') %></div><div class="leadpot-right-bottom"><div class="qr"><% if(typeof qrSvg!=='undefined'&&qrSvg){ %><%- qrSvg %><% }else{ %><%- barcodeSvg %><% } %></div><div style="flex:1"><div class="address"><b>Product Code</b><br><%= esc(payload.product_code) %></div><div class="small-line" style="margin-top:1mm"><b>Batch:</b> <%= esc(payload.batch_id) %></div></div></div></div>
</div><% } %>
<script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.4/build/qrcode.min.js"></script><script>
(()=>{const el=document.querySelector('.qr');if(!el||!window.QRCode||!window.QRCode.toCanvas)return;const value=JSON.stringify({batch:<%- JSON.stringify(payload.batch_id) %>,code:<%- JSON.stringify(payload.entity_id) %>,type:<%- JSON.stringify(payload.label_type||job.label_type) %>});const canvas=document.createElement('canvas');window.QRCode.toCanvas(canvas,value,{width:160,margin:0,errorCorrectionLevel:'M'},err=>{if(!err){el.replaceChildren(canvas);canvas.style.width='100%';canvas.style.height='100%';}});})();
</script></body></html>
