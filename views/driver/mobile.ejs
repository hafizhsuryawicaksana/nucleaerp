<%- include('../partials/header', { title: 'Distribution / Live Tracking | NUCLEA ERP' }) %>
<%- include('../partials/sidebar', { page: 'driver-mobile' }) %>
<div class="app-wrapper"><%- include('../partials/headbar') %><main class="app-main">
<div class="page-heading mb-4"><div><div class="eyebrow">Driver mobile workspace</div><h2 class="fw-bolder mb-1">Live Tracking</h2><p class="page-subtitle">Monitor active deliveries. Assigned drivers can share GPS from a phone; other ERP users can view position updates while a delivery is IN_TRANSIT.</p></div><div class="page-action-group d-flex gap-2"><span class="badge text-bg-success align-self-start px-3 py-2"><i class="bi bi-broadcast-pin me-1"></i><span id="liveCount"><%= deliveries.length %></span> delivery in transit</span><button id="refreshLive" class="btn btn-outline-secondary"><i class="bi bi-arrow-clockwise me-1"></i>Refresh</button></div></div>

<div class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="card metric-card h-100"><div class="card-body"><div class="metric-label">In transit</div><div class="metric-value" id="kpiTransit"><%= deliveries.length %></div><div class="small text-muted">Active deliveries</div></div></div></div><div class="col-6 col-xl-3"><div class="card metric-card h-100"><div class="card-body"><div class="metric-label">GPS reporting</div><div class="metric-value" id="kpiReporting">0</div><div class="small text-muted">Latest GPS coordinates</div></div></div></div><div class="col-6 col-xl-3"><div class="card metric-card h-100"><div class="card-body"><div class="metric-label">Need GPS</div><div class="metric-value" id="kpiNoGps">0</div><div class="small text-muted">No GPS coordinates</div></div></div></div><div class="col-6 col-xl-3"><div class="card metric-card h-100"><div class="card-body"><div class="metric-label">Your tracking</div><div class="metric-value" id="kpiLocal">Off</div><div class="small text-muted">GPS on this device</div></div></div></div></div>
<div class="row g-3"><div class="col-xl-8"><div class="card h-100"><div class="card-header"><div><strong><i class="bi bi-map me-2 text-primary"></i>Live delivery map</strong><div class="small text-muted">Latest saved driver location</div></div><span class="small text-muted" id="lastRefresh">Loading data…</span></div><div class="card-body p-2"><div id="liveMap" style="height:520px;min-height:320px;border-radius:.7rem;overflow:hidden;background:var(--kt-body-bg)"></div><div class="small text-muted px-2 pt-2" id="mapNote">The map requires an internet connection to load tiles. The delivery list remains available if map tiles fail to load.</div></div></div></div>
<div class="col-xl-4"><div class="card h-100"><div class="card-header"><div><strong><i class="bi bi-truck me-2 text-primary"></i>Delivery Monitor</strong><div class="small text-muted">Select a delivery to center the map</div></div></div><div class="card-body p-0"><div class="list-group list-group-flush" id="liveDeliveryList"><% if(!deliveries.length){ %><div class="text-center text-muted p-5"><i class="bi bi-truck display-6 d-block mb-2"></i>No deliveries in transit.<div class="small mt-2">Create and dispatch a delivery in Distribution to show it here.</div></div><% } %><% deliveries.forEach(d=>{ const canStart=Number(d.driver_user_id)===Number(userId); %><div class="list-group-item p-3" data-delivery-card="<%= d.id %>"><div class="d-flex justify-content-between align-items-start gap-2"><div><div class="fw-bold"><%= d.hospital_name %></div><div class="small text-muted"><%= d.batch_id %> · <%= d.route_code||'Route not set' %></div></div><span class="badge text-bg-success">IN_TRANSIT</span></div><div class="mt-3 d-flex justify-content-between gap-2"><div class="small text-muted"><i class="bi bi-person me-1"></i><%= d.driver_name||('Driver #'+(d.driver_user_id||'Not assigned')) %><div class="mt-1 gps-time" data-gps-time="<%= d.id %>"><%= d.last_location_at?'GPS '+new Date(d.last_location_at).toLocaleTimeString('en-US'):'No GPS yet' %></div></div><div class="d-flex flex-column gap-1 align-items-end"><button class="btn btn-sm btn-outline-primary focus-delivery" data-delivery-id="<%= d.id %>" type="button"><i class="bi bi-crosshair me-1"></i>Locate</button><% if(canStart){ %><button class="btn btn-sm btn-primary start-tracking" data-delivery-id="<%= d.id %>" data-tracking-label="<%= d.hospital_name %> · <%= d.batch_id %>" type="button"><i class="bi bi-broadcast me-1"></i>Start Tracking</button><% } %></div></div></div><% }) %></div></div></div></div></div>
<div class="card mt-3"><div class="card-header"><div><strong><i class="bi bi-activity me-2 text-success"></i>Device GPS Status</strong><div class="small text-muted">Driver location is sent when the assigned user selects Start Tracking</div></div><button class="btn btn-sm btn-outline-secondary" type="button" id="stopTracking"><i class="bi bi-stop-circle me-1"></i>Stop Tracking</button></div><div class="card-body"><div class="fw-bold" id="gpsStatus">GPS is not running</div><div class="text-muted small mt-1" id="gpsDetail">Select Start Tracking on a delivery assigned to this account.</div></div></div>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
(() => {
  const api='/api/live-tracking/active'; const currentUserId=Number(<%- JSON.stringify(userId) %>); const canManageTracking=<%- JSON.stringify(!!isTrackingManager) %>; let map=null, markers=new Map(), refreshTimer=null, watchId=null, selectedDelivery=null, lastSent=0, cached=[];
  const $=id=>document.getElementById(id);
  function setStatus(a,b){$('gpsStatus').textContent=a;$('gpsDetail').textContent=b;$('kpiLocal').textContent=watchId!==null?'On':'Off';}
  function initMap(){if(!window.L){$('mapNote').textContent='Map tiles are unavailable. Check the internet connection; the delivery list and tracking API remain available.';return;}map=L.map('liveMap',{zoomControl:true}).setView([-2.5,117],4);L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'&copy; OpenStreetMap'}).addTo(map);setTimeout(()=>map.invalidateSize(),300);}
  function markerPopup(d){const fix=d.server_received_at?new Date(d.server_received_at).toLocaleString('en-US'):'No location yet';return `<strong>${escapeHtml(d.hospital_name||'Customer')}</strong><br>Batch: ${escapeHtml(d.batch_id||'-')}<br>Driver: ${escapeHtml(d.driver_name||'-')}<br>Last GPS: ${escapeHtml(fix)}`;}
  function escapeHtml(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
  function renderList(ds){const list=$('liveDeliveryList');if(!ds.length){list.innerHTML='<div class="text-center text-muted p-5"><i class="bi bi-truck display-6 d-block mb-2"></i>No deliveries in transit.</div>';return;}list.innerHTML=ds.map(d=>{const has=Number.isFinite(Number(d.latitude))&&Number.isFinite(Number(d.longitude))&&d.latitude!==null&&d.longitude!==null;const age=d.server_received_at?new Date(d.server_received_at).toLocaleTimeString('en-US'):'No GPS yet';const assigned=Number(d.driver_user_id)===currentUserId;const startButton=assigned?`<button class="btn btn-sm btn-primary start-tracking" data-delivery-id="${d.delivery_order_id}" data-tracking-label="${escapeHtml((d.hospital_name||'Customer')+' · '+(d.batch_id||''))}" type="button"><i class="bi bi-broadcast me-1"></i>Start Tracking</button>`:'';return `<div class="list-group-item p-3" data-delivery-card="${d.delivery_order_id}"><div class="d-flex justify-content-between align-items-start gap-2"><div><div class="fw-bold">${escapeHtml(d.hospital_name||'Customer')}</div><div class="small text-muted">${escapeHtml(d.batch_id)} · ${escapeHtml(d.route_code||'Route not set')}</div></div><span class="badge text-bg-success">IN_TRANSIT</span></div><div class="mt-3 d-flex justify-content-between gap-2"><div class="small text-muted"><i class="bi bi-person me-1"></i>${escapeHtml(d.driver_name||'Driver Not assigned')}<div class="mt-1">${has?'GPS '+escapeHtml(age):'No GPS yet'}</div>${has?`<div>${Number(d.latitude).toFixed(5)}, ${Number(d.longitude).toFixed(5)}</div>`:''}</div><div class="d-flex flex-column gap-1 align-items-end"><button class="btn btn-sm btn-outline-primary focus-delivery" data-delivery-id="${d.delivery_order_id}" type="button"><i class="bi bi-crosshair me-1"></i>Locate</button>${startButton}</div></div></div>`;}).join('');}
  function render(ds){cached=ds;const withGps=ds.filter(d=>d.latitude!==null&&d.longitude!==null&&Number.isFinite(Number(d.latitude))&&Number.isFinite(Number(d.longitude)));$('liveCount').textContent=ds.length;$('kpiTransit').textContent=ds.length;$('kpiReporting').textContent=withGps.length;$('kpiNoGps').textContent=ds.length-withGps.length;$('lastRefresh').textContent='Updated '+new Date().toLocaleTimeString('en-US');renderList(ds);if(map){const liveIds=new Set();for(const d of withGps){const id=Number(d.delivery_order_id),lat=Number(d.latitude),lon=Number(d.longitude);if(!Number.isFinite(lat)||!Number.isFinite(lon))continue;liveIds.add(id);if(!markers.has(id)){const m=L.marker([lat,lon]).addTo(map);markers.set(id,m);}const marker=markers.get(id);marker.setLatLng([lat,lon]);marker.bindPopup(markerPopup(d));}for(const [id,m] of markers.entries())if(!liveIds.has(id)){map.removeLayer(m);markers.delete(id);}if(withGps.length&&!map._didFit){map.fitBounds(withGps.map(d=>[Number(d.latitude),Number(d.longitude)]),{padding:[36,36],maxZoom:10});map._didFit=true;}}}
  async function refresh(){try{const r=await fetch(api,{credentials:'same-origin',cache:'no-store'});const j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'Refresh failed');render(j.deliveries||[]);}catch(e){$('lastRefresh').textContent='Refresh failed: '+e.message;}}
  function stopTracking(update=true){if(watchId!==null&&navigator.geolocation)navigator.geolocation.clearWatch(watchId);watchId=null;selectedDelivery=null;if(update)setStatus('GPS stopped','The browser is no longer sending new locations.');}
  function startTracking(id,ref){if(!navigator.geolocation){setStatus('Geolocation is not supported','Use a browser with location services enabled.');return;}stopTracking(false);selectedDelivery=Number(id);lastSent=0;setStatus('Requesting location permission…',ref+' · Allow location access when prompted by the browser.');watchId=navigator.geolocation.watchPosition(async pos=>{const now=Date.now();if(now-lastSent<5000)return;lastSent=now;const data={delivery_order_id:selectedDelivery,latitude:pos.coords.latitude,longitude:pos.coords.longitude,accuracy_m:pos.coords.accuracy,device_recorded_at:new Date(pos.timestamp).toISOString()};try{const r=await fetch('/api/driver/location',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data),credentials:'same-origin'});const j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'Server rejected the location');setStatus('GPS active — '+ref,`Coordinates ${data.latitude.toFixed(6)}, ${data.longitude.toFixed(6)} · accuracy ±${Math.round(data.accuracy_m||0)} m · · saved ${new Date(j.received_at).toLocaleTimeString('en-US')}`);refresh();}catch(e){setStatus('Location not sent',e.message);}},e=>{setStatus('GPS error',e.message);stopTracking(false);},{enableHighAccuracy:true,maximumAge:4000,timeout:15000});$('kpiLocal').textContent='On';}
  document.addEventListener('click',e=>{const start=e.target.closest('.start-tracking');if(start){startTracking(start.dataset.deliveryId,start.dataset.trackingLabel);return;}const focus=e.target.closest('.focus-delivery');if(focus&&map){const d=cached.find(x=>Number(x.delivery_order_id)===Number(focus.dataset.deliveryId));if(d&&d.latitude!==null&&d.longitude!==null){const point=[Number(d.latitude),Number(d.longitude)];map.setView(point,14);const marker=markers.get(Number(d.delivery_order_id));if(marker)marker.openPopup();}else setStatus('No GPS coordinates','The driver has not sent a location for this delivery.');}});
  $('stopTracking').addEventListener('click',()=>stopTracking());$('refreshLive').addEventListener('click',refresh);initMap();refresh();refreshTimer=setInterval(refresh,7000);window.addEventListener('beforeunload',()=>{if(refreshTimer)clearInterval(refreshTimer);stopTracking(false);});
})();
</script>
</main></div><%- include('../partials/footer') %>
