<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>New Dispatch | Nuclea</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow border-0">
                    <div class="card-header bg-success text-white py-3">
                        <h5 class="mb-0">Dispatch Shipment (IMS Logistics)</h5>
                    </div>
                    <div class="card-body p-4">
                        <form action="/add-logistics" method="POST">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Select Production Batch</label>
                                <select name="production_id" class="form-select" required>
                                    <option value="" disabled selected>-- Select Available Batch --</option>
                                    <% batches.forEach(batch => { %>
                                        <option value="<%= batch.id %>">
                                            <%= batch.batch_id %> (Yield: <%= batch.raw_yield_mci %> mCi)
                                        </option>
                                    <% }) %>
                                </select>
                                <div class="form-text">Only completed batches appear here.</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Hospital Destination</label>
                                <select name="hospital_destination" class="form-select" required>
                                    <option value="RS Mitra Plumbon Cirebon">RS Mitra Plumbon Cirebon</option>
                                    <option value="RS Indriati Solo">RS Indriati Solo</option>
                                    <option value="RS Kariadi Semarang">RS Kariadi Semarang</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Leadpot ID</label>
                                <input type="text" name="leadpot_id" class="form-control" placeholder="e.g. LP-IMS-001" required>
                            </div>

                            <div class="d-grid gap-2 mt-4">
                                <button type="submit" class="btn btn-success">Dispatch Now</button>
                                <a href="/logistics" class="btn btn-outline-secondary">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>