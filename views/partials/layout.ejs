<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nuclea ERP | PT IMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        :root { --sidebar-width: 260px; --primary-color: #1a237e; --accent-color: #f59e0b; }
        body { background-color: #f3f4f6; font-family: 'Inter', sans-serif; overflow-x: hidden; }
        
        /* SIDEBAR STYLE */
        .sidebar { width: var(--sidebar-width); height: 100vh; position: fixed; background: #111827; color: white; transition: all 0.3s; z-index: 1000; }
        .sidebar-header { padding: 2rem 1.5rem; border-bottom: 1px solid #1f2937; }
        .nav-link { color: #9ca3af; padding: 0.8rem 1.5rem; transition: 0.2s; display: flex; align-items: center; }
        .nav-link:hover, .nav-link.active { background: #1f2937; color: white; border-left: 4px solid var(--accent-color); }
        .nav-link i { margin-right: 12px; font-size: 1.2rem; }

        /* HEADBAR & CONTENT STYLE */
        .main-content { margin-left: var(--sidebar-width); width: calc(100% - var(--sidebar-width)); }
        .headbar { background: white; padding: 1rem 2rem; border-bottom: 1px solid #e5e7eb; display: flex; justify-content: space-between; align-items: center; }
        .content-area { padding: 2rem; }
        .card { border: none; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-header">
            <h4 class="fw-bold mb-0">NUCLEA <span class="text-warning">ERP</span></h4>
            <small class="text-muted">PT. Inter Medika Solusindo</small>
        </div>
        <nav class="mt-4">
            <a href="/" class="nav-link <%= typeof page !== 'undefined' && page === 'dashboard' ? 'active' : '' %>">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <a href="/production" class="nav-link <%= typeof page !== 'undefined' && page === 'production' ? 'active' : '' %>">
                <i class="bi bi-radioactive"></i> Production
            </a>
            <a href="/logistics" class="nav-link <%= typeof page !== 'undefined' && page === 'logistics' ? 'active' : '' %>">
                <i class="bi bi-truck"></i> Logistics
            </a>
            <a href="/add-material" class="nav-link">
                <i class="bi bi-box-seam"></i> SCM Inventory
            </a>
            <div class="mt-5 px-3">
                <a href="/logout" class="btn btn-outline-danger btn-sm w-100">Logout</a>
            </div>
        </nav>
    </div>

    <div class="main-content">
        <header class="headbar">
            <h5 class="fw-bold mb-0 text-muted">System Management</h5>
            <div class="d-flex align-items-center">
                <div class="text-end me-3">
                    <p class="mb-0 fw-bold small"><%= user.full_name %></p>
                    <p class="mb-0 text-muted small">SCM Supervisor</p>
                </div>
                <img src="https://ui-avatars.com/api/?name=<%= user.full_name %>&background=random" class="rounded-circle" width="40">
            </div>
        </header>

        <main class="content-area">