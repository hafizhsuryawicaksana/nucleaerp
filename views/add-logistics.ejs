<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>New Delivery | Nuclea</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-header bg-success text-white"><h5>Shipment Dispatch</h5></div>
                    <div class="card-body">
                        <form action="/add-logistics" method="POST">
                            <div class="mb-3">
                                <label class="form-label">Select Production Batch</label>
                                <select name="production_id" class="form-select" required>
                                    <% batches.forEach(batch => { %>
                                        <option value="<%= batch.id %>"><%= batch.batch_id %> (Yield: <%= batch.raw_yield_mci %> mCi)</option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Hospital Destination</label>
                                <select name="hospital_destination" class="form-select">
                                    <option value="RS Mitra Plumbon Cirebon">RS Mitra Plumbon Cirebon</option>
                                    <option value="RS Indriati Solo">RS Indriati Solo</option>
                                    <option value="Other Hospital">Other Hospital</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Leadpot ID</label>
                                <input type="text" name="leadpot_id" class="form-control" placeholder="e.g. LP-IMS-001" required>
                            </div>
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-success">Dispatch Shipment</button>
                                <a href="/logistics" class="btn btn-light">Back</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>