<%- include('../partials/header', { title: 'User Role Control | NUCLEA' }) %><%- include('../partials/sidebar', { page }) %><div class="app-wrapper"><%- include('../partials/headbar') %><main class="app-main">
<div class="mb-4"><div class="text-primary fw-bold small text-uppercase">Security / Governance</div><h3 class="fw-bolder mb-1">User Role Control</h3><p class="text-muted mb-0">Self-service signup now creates a Pending User. Only a System Administrator may assign an operational role.</p></div>
<% if(query.error){ %><div class="alert alert-danger"><%= query.error %></div><% } %><% if(query.success){ %><div class="alert alert-success"><%= query.success %></div><% } %>
<div class="alert alert-warning small">Do not share administrator credentials. Role labels enable only application-level routing rules; a validated department-specific access-control matrix and formal access reviews are still required before production.</div>
<div class="card"><div class="card-header"><strong>Registered users</strong><span class="text-muted small"><%= users.length %> accounts</span></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Name</th><th>Email</th><th>Current role</th><th>Department</th><th>Assign role</th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><div class="fw-bold"><%= u.full_name %></div><small class="text-muted">User ID <%= u.id %></small></td><td><%= u.email %></td><td><span class="badge <%= u.role==='Pending User'?'bg-warning text-dark':'bg-light text-dark border' %>"><%= u.role %></span></td><td><%= u.department||'—' %></td><td><% if(Number(u.id)===Number(user.id)){ %><small class="text-muted">Active account (cannot change own role)</small><% } else { %><form method="POST" action="/erp/access-control/<%= u.id %>/role" class="d-flex gap-2"><select name="role" class="form-select form-select-sm" style="min-width:190px"><% ['Pending User','System Administrator','Plant Manager','SCM Supervisor','SCM Staff','Purchasing','Finance Leader','Production Supervisor','Production Operator','QC Analyst','QC Supervisor','QA Supervisor','PPR','PPR Kepala','Driver'].forEach(r=>{ %><option value="<%= r %>" <%= u.role===r?'selected':'' %>><%= r %></option><% }) %></select><button class="btn btn-sm btn-primary">Save</button></form><% } %></td></tr><% }) %></tbody></table></div></div>
</main></div><%- include('../partials/footer') %>
