<%- include('../partials/header', { title: 'BOM & Material Rules | NUCLEA' }) %><%- include('../partials/sidebar', { page }) %>
<div class="app-wrapper"><%- include('../partials/headbar') %><main class="app-main">
<div class="mb-4"><div class="text-primary fw-bold small text-uppercase">Manufacturing / Inventory Integration</div><h3 class="fw-bolder mb-1">BOM & Material Rules</h3><p class="text-muted mb-0">Define material quantity required per production batch. Production start will issue released lots using FEFO inside a database transaction.</p></div>
<% if(query.error){ %><div class="alert alert-danger"><%= query.error %></div><% } %><% if(query.success){ %><div class="alert alert-success"><%= query.success %></div><% } %>
<div class="alert alert-info"><strong>Important:</strong> Product Code must exactly match the <code>item_code</code> on the production Work Order (case-insensitive). Quantity is the total required for one batch, not per vial. Confirm BOM values and UOM with Production/QA before activation.</div>
<div class="card mb-4" data-modalize-title="Add / revisi BOM line" data-modalize-button="Add BOM Material"><div class="card-header"><strong>Add / update BOM line</strong></div><div class="card-body"><form method="POST" action="/erp/bom/save" class="row g-3">
<div class="col-md-4"><label class="form-label">Product Code / Work Order Item Code</label><input name="product_code" class="form-control" list="productCodes" required placeholder="e.g. FDG-18F"><datalist id="productCodes"><% products.forEach(p=>{ %><option value="<%= p.code %>"><%= p.name %></option><% }) %></datalist></div>
<div class="col-md-4"><label class="form-label">Material</label><select name="material_id" class="form-select" required><option value="">Select material</option><% materials.forEach(m=>{ %><option value="<%= m.id %>"><%= m.material_code %> · <%= m.name %> (stock <%= m.current_stock %> <%= m.uom %>)</option><% }) %></select></div>
<div class="col-md-2"><label class="form-label">Qty / batch</label><input type="number" name="quantity_per_batch" step="0.000001" min="0.000001" class="form-control" required></div><div class="col-md-2"><label class="form-label">UOM</label><input name="uom" class="form-control" placeholder="g, mL, pcs"></div><div class="col-12"><button class="btn btn-primary"><i class="bi bi-save me-1"></i>Save BOM line</button></div></form></div></div>
<div class="card"><div class="card-header"><strong>Active BOM matrix</strong><span class="text-muted small"><%= lines.length %> active lines</span></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Product Code</th><th>Material</th><th>Quantity / Batch</th><th>Version</th><th>Action</th></tr></thead><tbody><% if(!lines.length){ %><tr><td colspan="5" class="text-center text-muted py-4">No BOM lines yet. Add the approved recipe above.</td></tr><% } %><% lines.forEach(l=>{ %><tr><td class="fw-bold"><%= l.product_code %></td><td><div class="fw-semibold"><%= l.material_name %></div><small class="text-muted"><%= l.material_code %></small></td><td><%= l.quantity_per_batch %> <%= l.uom||'' %></td><td><span class="badge bg-light text-dark border">v<%= l.version %></span></td><td><form method="POST" action="/erp/bom/deactivate/<%= l.id %>" onsubmit="return confirm('Deactivate this BOM line? It will no longer be used for new starts.');"><button class="btn btn-sm btn-outline-danger">Deactivate</button></form></td></tr><% }) %></tbody></table></div></div>
</main></div><%- include('../partials/footer') %>
