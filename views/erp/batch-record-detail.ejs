<%- include('../partials/header', { title: 'Batch Record Detail | NUCLEA' }) %><%- include('../partials/sidebar', { page }) %>
<div class="app-wrapper"><%- include('../partials/headbar') %><main class="app-main">
<div class="d-flex flex-wrap justify-content-between align-items-start mb-4 gap-3"><div><div class="text-primary fw-bold small text-uppercase">MES / Batch Record</div><h3 class="fw-bolder mb-1"><%= production.batch_id %></h3><p class="text-muted mb-0"><%= production.item_code||'Product not assigned' %> · <%= production.production_date?new Date(production.production_date).toLocaleDateString('en-GB'):'Date not assigned' %></p></div><div class="d-flex gap-2"><a href="/erp/labels" class="btn btn-outline-primary"><i class="bi bi-upc-scan me-1"></i>Label Station</a><a href="/erp/batch-records" class="btn btn-outline-secondary">Back to batch list</a></div></div>
<% if(query.error){ %><div class="alert alert-danger"><%= query.error %></div><% } %><% if(query.success){ %><div class="alert alert-success"><%= query.success %></div><% } %>
<div class="row g-3 mb-4"><div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Execution</div><div class="fs-5 fw-bold"><%= production.status %></div></div></div></div><div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">QA disposition</div><div class="fs-5 fw-bold"><%= production.qa_disposition||'PENDING' %></div></div></div></div><div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Actual activity / yield</div><div class="fs-5 fw-bold"><%= production.raw_yield_mci||'—' %> mCi</div></div></div></div><div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Actual EOB</div><div class="fs-6 fw-bold"><%= production.actual_eob?new Date(production.actual_eob).toLocaleString('en-GB'):'Not recorded' %></div></div></div></div></div>
<div class="card mb-4"><div class="card-header"><strong><i class="bi bi-list-check me-2 text-primary"></i>Sequential e-BMR / e-BPR steps</strong><span class="small text-muted">Server timestamp on start/completion</span></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Sequence</th><th>Document</th><th>Step</th><th>Status</th><th>Start / complete</th><th>Action</th></tr></thead><tbody><% steps.forEach(s=>{ %><tr><td><%= s.sequence_no %></td><td><span class="badge bg-light text-dark border"><%= s.record_type %></span></td><td><div class="fw-semibold"><%= s.step_name %></div><small class="text-muted"><%= s.step_code %> · <%= s.performer_name||'No operator yet' %></small></td><td><span class="badge <%= s.status==='COMPLETED'?'bg-success':s.status==='IN_PROGRESS'?'bg-primary':'bg-secondary' %>"><%= s.status %></span></td><td class="small"><%= s.started_at?new Date(s.started_at).toLocaleString('en-GB'):'—' %><br><%= s.completed_at?new Date(s.completed_at).toLocaleString('en-GB'):'—' %></td><td style="min-width:215px"><% if(s.status==='PENDING'){ %><form method="POST" action="/erp/batch-records/<%= encodeURIComponent(production.batch_id) %>/step/<%= s.step_code %>" class="d-flex gap-1"><input type="hidden" name="action" value="start"><input class="form-control form-control-sm" name="notes" placeholder="Optional note"><button class="btn btn-sm btn-primary">Start</button></form><% } else if(s.status==='IN_PROGRESS'){ %><form method="POST" action="/erp/batch-records/<%= encodeURIComponent(production.batch_id) %>/step/<%= s.step_code %>" class="d-flex gap-1"><input type="hidden" name="action" value="complete"><input class="form-control form-control-sm" name="notes" placeholder="Actual note"><button class="btn btn-sm btn-success">Complete</button></form><% } else { %><span class="text-success small"><i class="bi bi-check-circle me-1"></i>Recorded</span><% } %></td></tr><% }) %></tbody></table></div></div>
<div class="row g-4 mb-4"><div class="col-xl-6"><div class="card h-100"><div class="card-header"><strong><i class="bi bi-clipboard2-pulse me-2 text-primary"></i>Record actual parameter</strong></div><div class="card-body"><form method="POST" action="/erp/batch-records/<%= encodeURIComponent(production.batch_id) %>/parameter" class="row g-3">
<div class="col-md-4"><label class="form-label">Record type</label><select name="record_type" class="form-select"><option>BMR</option><option>BPR</option></select></div><div class="col-md-8"><label class="form-label">Step</label><select name="step_id" class="form-select"><option value="">General batch parameter</option><% steps.forEach(s=>{ %><option value="<%= s.id %>"><%= s.record_type %> · <%= s.step_name %></option><% }) %></select></div>
<div class="col-md-4"><label class="form-label">Parameter code</label><input name="parameter_code" class="form-control" placeholder="e.g. TEMP"></div><div class="col-md-8"><label class="form-label">Parameter name *</label><input name="parameter_name" class="form-control" required placeholder="e.g. Synthesis temperature"></div>
<div class="col-md-4"><label class="form-label">Actual numeric</label><input type="number" step="any" name="actual_numeric" class="form-control"></div><div class="col-md-4"><label class="form-label">Actual text</label><input name="actual_text" class="form-control"></div><div class="col-md-4"><label class="form-label">Unit</label><input name="unit" class="form-control" placeholder="°C, min, MBq/mL"></div>
<div class="col-md-4"><label class="form-label">Target</label><input name="target_value" class="form-control"></div><div class="col-md-4"><label class="form-label">Lower limit</label><input type="number" step="any" name="lower_limit" class="form-control"></div><div class="col-md-4"><label class="form-label">Upper limit</label><input type="number" step="any" name="upper_limit" class="form-control"></div><div class="col-12"><label class="form-label">Reason / note (required for correction context)</label><textarea name="reason" class="form-control" rows="2"></textarea></div><div class="col-12"><button class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Append parameter record</button></div></form></div></div></div>
<div class="col-xl-6"><div class="card h-100"><div class="card-header"><strong><i class="bi bi-eyedropper me-2 text-success"></i>QC result entry</strong></div><div class="card-body"><form method="POST" action="/erp/batch-records/<%= encodeURIComponent(production.batch_id) %>/qc" class="row g-3">
<div class="col-md-8"><label class="form-label">Test name *</label><input name="test_name" class="form-control" required placeholder="pH, radionuclidic identity, radiochemical purity"></div><div class="col-md-4"><label class="form-label">Test code</label><input name="test_code" class="form-control"></div>
<div class="col-md-4"><label class="form-label">Numeric result</label><input type="number" step="any" name="result_numeric" class="form-control"></div><div class="col-md-4"><label class="form-label">Text result</label><input name="result_text" class="form-control"></div><div class="col-md-4"><label class="form-label">Unit</label><input name="unit" class="form-control"></div>
<div class="col-md-4"><label class="form-label">Lower limit</label><input type="number" step="any" name="lower_limit" class="form-control"></div><div class="col-md-4"><label class="form-label">Upper limit</label><input type="number" step="any" name="upper_limit" class="form-control"></div><div class="col-md-4"><label class="form-label">Instrument ID</label><input name="instrument_id" class="form-control"></div>
<div class="col-md-6"><label class="form-label">Acceptance criteria</label><input name="acceptance_criteria" class="form-control"></div><div class="col-md-6"><label class="form-label">Specification version *</label><input name="specification_version" class="form-control" required value="UNCONTROLLED-PENDING-QA"></div>
<div class="col-md-6"><label class="form-label">Outcome for text result</label><select name="outcome" class="form-select"><option value="PENDING_REVIEW">Pending review</option><option value="PASS">PASS</option><option value="FAIL">FAIL</option></select></div><div class="col-md-6 d-flex align-items-end"><button class="btn btn-success w-100"><i class="bi bi-save me-1"></i>Save QC result</button></div></form><div class="alert alert-warning small mt-3 mb-0">Numeric results with limits are evaluated automatically. Text outcomes require analyst judgement. Do not use uncontrolled/default criteria for regulated release; QA must approve specifications and methods.</div></div></div></div></div>
<div class="card mb-4"><div class="card-header"><strong>Recorded parameters</strong><span class="text-muted small"><%= params.length %> entries</span></div><div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead><tr><th>Timestamp</th><th>Type</th><th>Parameter</th><th>Actual</th><th>Limits / target</th><th>Result</th><th>Entered by</th></tr></thead><tbody><% if(!params.length){ %><tr><td colspan="7" class="text-center text-muted py-3">No parameter entries.</td></tr><% } %><% params.forEach(x=>{ %><tr><td class="small"><%= new Date(x.entered_at).toLocaleString('en-GB') %></td><td><%= x.record_type %></td><td><%= x.parameter_name %><small class="d-block text-muted"><%= x.parameter_code||'' %></small></td><td><%= x.actual_numeric!==null?x.actual_numeric:(x.actual_text||'—') %> <%= x.unit||'' %></td><td class="small">Target: <%= x.target_value||'—' %><br><%= x.lower_limit??'—' %> – <%= x.upper_limit??'—' %></td><td><span class="badge <%= x.result_status==='OUT_OF_RANGE'?'bg-danger':'bg-light text-dark border' %>"><%= x.result_status %></span></td><td><%= x.entered_name||'—' %></td></tr><% }) %></tbody></table></div></div>
<div class="card mb-4"><div class="card-header"><strong>QC results & test history</strong><span class="text-muted small"><%= qc.length %> entries</span></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Performed</th><th>Test</th><th>Result</th><th>Limits</th><th>Outcome</th><th>Specification</th><th>Analyst</th></tr></thead><tbody><% if(!qc.length){ %><tr><td colspan="7" class="text-center text-muted py-3">No QC result yet.</td></tr><% } %><% qc.forEach(x=>{ %><tr><td class="small"><%= new Date(x.performed_at).toLocaleString('en-GB') %></td><td><%= x.test_name %></td><td><%= x.result_numeric!==null?x.result_numeric:(x.result_text||'—') %> <%= x.unit||'' %></td><td><%= x.lower_limit??'—' %> – <%= x.upper_limit??'—' %></td><td><span class="badge <%= x.outcome==='PASS'?'bg-success':x.outcome==='FAIL'?'bg-danger':'bg-warning text-dark' %>"><%= x.outcome %></span></td><td class="small"><%= x.specification_version %></td><td><%= x.analyst_name||'—' %><small class="d-block text-muted"><%= x.instrument_id||'' %></small></td></tr><% }) %></tbody></table></div></div>
<div class="card mb-4"><div class="card-header"><strong>Electronic approval & QA disposition</strong><span class="text-muted small">Re-enter your PIN to sign</span></div><div class="card-body"><div class="row g-3"><% [['PRODUCTION_REVIEW','Production Review','Review completeness of e-BMR/e-BPR steps.'],['QC_VERIFICATION','QC Verification','Verifies all recorded QC outcomes are PASS.'],['QA_RELEASE','QA Release','Releases completed batch only when QC checks pass.']].forEach(k=>{ %><div class="col-lg-4"><div class="border rounded p-3 h-100"><div class="fw-bold"><%= k[1] %></div><p class="small text-muted"><%= k[2] %></p><form method="POST" action="/erp/batch-records/<%= encodeURIComponent(production.batch_id) %>/sign"><input type="hidden" name="sign_type" value="<%= k[0] %>"><label class="form-label small">PIN</label><input class="form-control mb-2" name="pin" type="password" required inputmode="numeric"><label class="form-label small">Reason / review note</label><textarea class="form-control mb-2" name="reason" rows="2"></textarea><button class="btn btn-sm btn-dark w-100">Sign & record timestamp</button></form></div></div><% }) %></div>
<hr><h6 class="fw-bold">Recorded signatures</h6><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Time</th><th>Sign type</th><th>Signer</th><th>Role</th><th>Decision</th><th>Document hash</th></tr></thead><tbody><% if(!signatures.length){ %><tr><td colspan="6" class="text-muted">No electronic sign-offs yet.</td></tr><% } %><% signatures.forEach(s=>{ %><tr><td><%= new Date(s.signed_at).toLocaleString('en-GB') %></td><td><%= s.sign_type %></td><td><%= s.signer_name %></td><td><%= s.signer_role %></td><td><%= s.decision %></td><td><code><%= s.document_hash.slice(0,16) %>…</code></td></tr><% }) %></tbody></table></div></div></div>
<div class="alert alert-warning small"><strong>Important:</strong> Application PIN approval records signer, timestamp and document hash; it is not a certified legal digital signature by itself. Release controls and testing specifications require formal QA/QC validation.</div>
</main></div><%- include('../partials/footer') %>
