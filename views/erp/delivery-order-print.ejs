<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Delivery Order</title><style>
*{box-sizing:border-box}body{font:11px Arial,sans-serif;color:#111;margin:12mm}.toolbar{display:flex;justify-content:space-between;gap:12px;margin-bottom:12px}.top{border:2px solid #111;padding:12px;margin-bottom:12px}.brand{font-size:9px;text-transform:uppercase;letter-spacing:1px;color:#555}.title{font-size:20px;font-weight:800;margin:4px 0}.ref{font-weight:700;font-size:12px}.meta{width:100%;border-collapse:collapse;margin:10px 0 18px}.meta td{border:1px solid #555;padding:7px;width:33.33%;vertical-align:top}.meta label{display:block;text-transform:uppercase;color:#555;font-size:8px;margin-bottom:5px}.goods{width:100%;border-collapse:collapse;table-layout:fixed}.goods th,.goods td{border:1px solid #333;padding:7px 5px;vertical-align:top;overflow-wrap:anywhere}.goods th{background:#eee;font-size:9px}.section{font-size:12px;font-weight:bold;margin:18px 0 6px}.transport{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}.transport div{border:1px solid #555;padding:8px}.transport label{font-size:8px;color:#555;display:block;text-transform:uppercase}.signs{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:35px}.sign{height:80px;border-bottom:1px solid #333;text-align:center;padding-top:4px}.note{margin-top:16px;border:1px solid #aaa;background:#f7f7f7;padding:8px;font-size:9px}.foot{margin-top:18px;display:flex;justify-content:space-between;color:#555;font-size:8px}@page{size:A4 portrait;margin:10mm}@media print{body{margin:0}.toolbar{display:none}.top{break-inside:avoid}.goods tr{break-inside:avoid}}
</style></head><body>
<div class="toolbar"><strong>Print preview — Delivery Order controlled-form reconstruction</strong><button onclick="window.print()">Print / Save as PDF</button></div>
<div class="top"><div class="brand">PT IMS · Supply Chain / Distribution</div><div class="title">DELIVERY ORDER</div><div style="margin-top:6px">Source form: IMS.SC.007-F-03 · Delivery status: <strong><%= delivery.status %></strong></div></div>
<table class="meta"><tr><td><label>Batch</label><strong><%= delivery.batch_id %></strong></td><td><label>Customer / Delivery To</label><strong><%= delivery.hospital_name %></strong></td><td><label>Assigned Driver</label><strong><%= delivery.driver_name||'—' %></strong></td></tr><tr><td><label>Vehicle Plate</label><strong><%= delivery.vehicle_code||'—' %></strong></td><td><label>Route</label><strong><%= delivery.route_code||'—' %></strong></td><td><label>Leadpot Code</label><strong><%= delivery.leadpot_code||'—' %></strong></td></tr></table>
<div class="section">Product / Radiation Transport Details</div><table class="goods"><thead><tr><th style="width:16%">Product Name</th><th style="width:10%">Product Code</th><th style="width:14%">Calibration Date & Time</th><th style="width:14%">Expired Date & Time</th><th style="width:10%">Activity Order (mCi)</th><th style="width:13%">Packaging Category</th><th style="width:11%">Surface Dose Rate</th><th style="width:7%">Leadpot No.</th><th style="width:5%">UN No.</th></tr></thead><tbody><tr><td><%= delivery.product_name||'18F-FDG Injection' %></td><td><%= delivery.product_code||delivery.item_code||'—' %></td><td><%= delivery.payload&&delivery.payload.calibration_datetime||[delivery.production_date?new Date(delivery.production_date).toLocaleDateString('en-GB'):'',delivery.calib_time||''].filter(Boolean).join(' ')||'—' %></td><td><%= delivery.payload&&delivery.payload.expiry_datetime||'—' %></td><td><%= (delivery.allocated_mci ?? (delivery.payload && delivery.payload.allocated_mci)) ?? '—' %></td><td><%= delivery.payload&&delivery.payload.packaging_category||'II-Yellow' %></td><td><%= delivery.surface_dose_rate!==''&&delivery.surface_dose_rate!==undefined?delivery.surface_dose_rate+(measurement?' '+measurement.unit:''):'—' %></td><td><%= delivery.leadpot_code||'—' %></td><td>UN 2915</td></tr></tbody></table>
<div class="transport"><div><label>Transport Index (TI)</label><strong><%= delivery.payload&&delivery.payload.transport_index||'Not recorded' %></strong></div><div><label>Radiation instrument</label><strong><%= measurement&&measurement.instrument_id||'Not recorded' %></strong></div><div><label>Radiation check timestamp</label><strong><%= measurement?new Date(measurement.measured_at).toLocaleString('en-GB'):'Not recorded' %></strong></div></div>
<div class="section">Shipping / Control Notes</div><div class="note">Delivery may proceed only after QA batch release, complete internal product handover checklist (IMS.SC.007-F-02), passed fleet and driver readiness checklist, calibrated dosimeter, radiation measurement independently verified, and approved site-specific radiation transport assessment. Transport Index and packaging category must be confirmed by authorized radiation-safety personnel; the ERP does not automatically classify radioactive packages.</div>
<div class="signs"><div><div class="sign"></div><div style="text-align:center;margin-top:5px"><strong>Prepared by</strong><br><%= user&&user.full_name||'SCM / Distribution' %></div></div><div><div class="sign"></div><div style="text-align:center;margin-top:5px"><strong>Checked by</strong><br>SCM / PPR / Authorized role</div></div><div><div class="sign"></div><div style="text-align:center;margin-top:5px"><strong>Received by Customer</strong><br>To be completed on receipt / e-POD</div></div></div>
<div class="foot"><span>System generated · <%= new Date().toLocaleString('en-GB') %></span><span>Reconstruction for QA approval before controlled use</span></div>
</body></html>
