<%- include('../partials/header', { title: 'Digital Batch Records | NUCLEA' }) %><%- include('../partials/sidebar', { page }) %>
<div class="app-wrapper"><%- include('../partials/headbar') %><main class="app-main">
<div class="mb-4"><div class="text-primary fw-bold small text-uppercase">MES / LIMS / QMS</div><h3 class="fw-bolder mb-1">Digital Batch Records</h3><p class="text-muted mb-0">Real-time batch timeline, e-BMR/e-BPR parameters, QC testing and electronic sign-off.</p></div>
<% if(query.error){ %><div class="alert alert-danger"><%= query.error %></div><% } %><% if(query.success){ %><div class="alert alert-success"><%= query.success %></div><% } %>
<div class="card"><div class="card-header"><strong>Batch register</strong><span class="text-muted small">Open a batch to record operations</span></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Batch</th><th>Product / Leadpot</th><th>Production date</th><th>Execution status</th><th>QA disposition</th><th>Parameters</th><th>QC tests</th><th></th></tr></thead><tbody><% if(!batches.length){ %><tr><td colspan="8" class="text-center text-muted py-4">No production Work Orders found. Create a batch in Production Schedule first.</td></tr><% } %><% batches.forEach(b=>{ %><tr><td class="fw-bold"><%= b.batch_id %></td><td><%= b.item_code||'—' %><small class="d-block text-muted"><%= b.leadpot||'' %></small></td><td><%= b.production_date?new Date(b.production_date).toLocaleDateString('en-GB'):'—' %></td><td><span class="badge bg-light text-dark border"><%= b.status %></span></td><td><span class="badge <%= b.qa_disposition==='RELEASED'?'bg-success':b.qa_disposition==='ON_HOLD'?'bg-danger':'bg-warning text-dark' %>"><%= b.qa_disposition||'PENDING' %></span></td><td><%= b.parameter_count %></td><td><%= b.qc_count %></td><td><a class="btn btn-sm btn-primary" href="/erp/batch-records/<%= encodeURIComponent(b.batch_id) %>">Open record <i class="bi bi-arrow-right"></i></a></td></tr><% }) %></tbody></table></div></div>

</main></div><%- include('../partials/footer') %>
