<%- include('../partials/header', { title: 'Label Station | NUCLEA ERP' }) %>
<%- include('../partials/sidebar', { page }) %><div class="app-wrapper"><%- include('../partials/headbar') %><main class="app-main">
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><h3 class="fw-bold mb-1">Label Station</h3><p class="text-muted mb-0">Vial · 75 × 25 mm  |  Leadpot · 160 × 60 mm</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#labelCreateModal"><i class="bi bi-printer me-1"></i>Create Label</button></div>
<% if(query.error){ %><div class="alert alert-danger"><%= query.error %></div><% } %>
<div class="row g-3 mb-4"><div class="col-md-6"><div class="card h-100"><div class="card-body d-flex align-items-center gap-3"><div class="rounded-3 p-3" style="background:#e8f3ff;color:#2357a7"><i class="bi bi-upc-scan fs-4"></i></div><div><div class="fw-bold">Vial Label</div><div class="small text-muted">75 × 25 mm · Marketing Authorization Number</div></div></div></div></div><div class="col-md-6"><div class="card h-100"><div class="card-body d-flex align-items-center gap-3"><div class="rounded-3 p-3" style="background:#eaf8f4;color:#208575"><i class="bi bi-shield-check fs-4"></i></div><div><div class="fw-bold">Leadpot Label</div><div class="small text-muted">160 × 60 mm · Composition, manufacturer, address, and QR code</div></div></div></div></div></div>
<div class="modal fade" id="labelCreateModal" tabindex="-1" aria-labelledby="labelCreateLabel" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><form method="POST" action="/erp/labels/create" id="labelCreateForm"><div class="modal-header"><h5 class="modal-title fw-bold" id="labelCreateLabel">Create Label</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="row g-3">
<div class="col-md-4"><label class="form-label">Label Type *</label><select name="label_type" id="labelTypeSelect" class="form-select" required><option value="VIAL" <%= String(query.label_type||'VIAL').toUpperCase()==='VIAL'?'selected':'' %>>Vial Label</option><option value="LEADPOT" <%= String(query.label_type||'').toUpperCase()==='LEADPOT'?'selected':'' %>>Leadpot Label</option></select></div>
<div class="col-md-4"><label class="form-label">Production Batch *</label><select name="batch_id" id="labelBatchSelect" class="form-select" required><option value="">Select batch</option><% batches.forEach(b=>{ %><option value="<%= b.batch_id %>" data-product-code="<%= b.item_code||'' %>" data-manufacture="<%= b.production_date?new Date(b.production_date).toISOString().slice(0,16):'' %>" data-activity="<%= b.raw_yield_mci||'' %>" <%= String(query.batch_id||'')===String(b.batch_id)?'selected':'' %>><%= b.batch_id %> · <%= b.item_code||'Product' %> · <%= b.qa_disposition||b.status||'' %></option><% }) %></select></div>
<div class="col-md-4"><label class="form-label" id="labelCodeText">Vial Code *</label><input name="entity_id" id="labelEntityCode" class="form-control" required placeholder="Enter Vial Code" list="assetCodes"><datalist id="assetCodes"><% assets.forEach(a=>{ %><option value="<%= a.asset_code %>"><%= a.name %> · <%= a.status %></option><% }) %></datalist></div>
<div class="col-md-6"><label class="form-label">Product / Brand Name *</label><input name="product_name" class="form-control" value="IMSCan-GluTrace" required></div>
<div class="col-md-6"><label class="form-label">Radionuclide / Drug Name *</label><input name="isotope_name" class="form-control" value="¹⁸F-Fludeoxyglucose" required></div>
<div class="col-md-6"><label class="form-label">Customer Name *</label><input name="customer_name" id="labelCustomerName" class="form-control" required placeholder="Customer / hospital"></div>
<div class="col-md-4"><label class="form-label">Manufacturing Date/Time *</label><input type="datetime-local" name="manufacture_datetime" id="manufactureDateTime" class="form-control" required></div>
<div class="col-md-4"><label class="form-label">Expiry Date/Time *</label><input type="datetime-local" name="expiry_datetime" class="form-control" required></div>
<div class="col-md-4"><label class="form-label">Time Reference *</label><input name="time_reference" class="form-control" value="WIB / UTC+7" required></div>
<div class="col-md-4"><label class="form-label">Activity Concentration (mCi/mL) *</label><input type="number" step="0.001" min="0.001" name="activity_concentration" id="activityConcentration" class="form-control" required></div>
<div class="col-md-4"><label class="form-label">Activity (mCi) *</label><input type="number" step="0.001" min="0" name="activity_mci" id="activityMci" class="form-control" required></div>
<div class="col-md-4"><label class="form-label">Volume (mL) *</label><input type="number" step="0.01" min="0.01" name="volume_ml" class="form-control" required></div>
<div class="col-12"><label class="form-label">Synthesis Route</label><input name="synthesis_route" class="form-control" value="2-deoxy-2-[18F] fluoro-D-glucose (nucleophilic)" id="synthesisRoute"></div>
<div class="col-md-6 vial-only"><label class="form-label">Marketing Authorization Number *</label><input name="marketing_authorization_no" id="marketingAuthorization" class="form-control" placeholder="e.g. DKL1111111111A1"></div>
<div class="col-md-6 leadpot-only"><label class="form-label">Pharmaceutical Form *</label><input name="pharmaceutical_form" class="form-control" value="Injection"></div>
<div class="col-md-6 leadpot-only"><label class="form-label">Composition *</label><textarea name="composition" class="form-control" rows="2" placeholder="Active ingredient and composition"></textarea></div>
<div class="col-md-6 leadpot-only"><label class="form-label">Pig Lead / Dispensing Statement</label><textarea name="pig_lead_statement" class="form-control" rows="2" placeholder="Pig lead and dispensing activity statement"></textarea></div>
<div class="col-md-6 leadpot-only"><label class="form-label">Storage Instruction *</label><textarea name="storage_instruction" class="form-control" rows="2" required>Store upright in a lead-shield container below 30°C, with a shelf life of 12 hours after dispensing starts.</textarea></div>
<div class="col-md-6 leadpot-only"><label class="form-label">HET Price per Vial (IDR)</label><input type="number" min="0" step="1" name="het_price_per_vial" class="form-control" placeholder="Enter HET price"></div>
<div class="col-md-6 leadpot-only"><label class="form-label">Registered By</label><input name="registered_by_name" class="form-control" value="PT Interskala Medika Solusindo"></div>
<div class="col-md-6 leadpot-only"><label class="form-label">Registered Address</label><input name="registered_address" class="form-control" value="Rukan Crown, Greenlake City B06 Tangerang - Indonesia"></div>
<div class="col-md-6 leadpot-only"><label class="form-label">Manufacturer</label><input name="manufacturer_name" class="form-control" value="PT Interskala Medika Solusindo"></div>
<div class="col-md-6 leadpot-only"><label class="form-label">Manufacturing Address</label><input name="manufacturing_address" class="form-control" value="KEK Industri Batang - Indonesia"></div>
</div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary"><i class="bi bi-printer me-1"></i>Generate and Print</button></div></form></div></div></div>
<div class="card"><div class="card-header"><strong>Recent Labels</strong></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Created</th><th>Type</th><th>Label Code</th><th>Batch</th><th>QA Status</th><th></th></tr></thead><tbody><% if(!jobs.length){ %><tr><td colspan="6" class="text-center text-muted py-4">No labels created yet.</td></tr><% } %><% jobs.forEach(j=>{ %><tr><td><%= new Date(j.printed_at).toLocaleString('en-GB') %></td><td><span class="badge text-bg-light border"><%= j.label_type %></span></td><td><code><%= j.entity_id %></code></td><td><code><%= j.batch_id %></code></td><td><span class="badge <%= j.payload.qa_disposition==='RELEASED'?'bg-success':'bg-warning text-dark' %>"><%= j.payload.qa_disposition||'PENDING' %></span></td><td><a href="/erp/labels/print/<%= j.id %>" class="btn btn-sm btn-outline-primary">Open Label</a></td></tr><% }) %></tbody></table></div></div>
<script>
document.addEventListener('DOMContentLoaded',()=>{
 const type=document.getElementById('labelTypeSelect'),codeLabel=document.getElementById('labelCodeText'),codeInput=document.getElementById('labelEntityCode'),auth=document.getElementById('marketingAuthorization'),route=document.getElementById('synthesisRoute');
 const setType=()=>{const vial=type.value==='VIAL';document.querySelectorAll('.vial-only').forEach(el=>{el.hidden=!vial;el.querySelectorAll('input,textarea').forEach(input=>{input.disabled=!vial;input.required=vial&&input.id==='marketingAuthorization';});});document.querySelectorAll('.leadpot-only').forEach(el=>{el.hidden=vial;el.querySelectorAll('input,textarea').forEach(input=>{input.disabled=vial;input.required=!vial&&input.name!=='pig_lead_statement'&&input.name!=='het_price_per_vial';});});codeLabel.textContent=vial?'Vial Code *':'Leadpot Code *';codeInput.placeholder=vial?'Enter Vial Code':'Enter Leadpot Code';route.required=vial;};
 type.addEventListener('change',setType);setType();
 const batch=document.getElementById('labelBatchSelect');batch.addEventListener('change',()=>{const option=batch.selectedOptions[0];if(!option)return;const m=document.getElementById('manufactureDateTime'),a=document.getElementById('activityMci');if(option.dataset.manufacture&&!m.value)m.value=option.dataset.manufacture;if(option.dataset.activity&&!a.value)a.value=option.dataset.activity;});
 const customer=document.getElementById('labelCustomerName');const initialBatch=batch.selectedOptions[0];if(initialBatch?.dataset.manufacture)document.getElementById('manufactureDateTime').value=initialBatch.dataset.manufacture;
});
</script>
</main></div><%- include('../partials/footer') %>
