<%- include('../partials/header', { title: 'Distribution | NUCLEA ERP' }) %><%- include('../partials/sidebar', { page }) %><div class="app-wrapper"><%- include('../partials/headbar') %><main class="app-main">
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h3 class="fw-bold mb-1">Distribution</h3><p class="text-muted mb-0">Delivery Action, fleet readiness, radiation checks, dispatch, tracking, delivery confirmation, and leadpot returns.</p></div><a href="/driver/mobile" class="btn btn-outline-primary"><i class="bi bi-broadcast-pin me-1"></i>Live Tracking</a></div>
<% if(query.error){ %><div class="alert alert-danger"><%= query.error %></div><% } %><% if(query.success){ %><div class="alert alert-success"><%= query.success %></div><% } %>
<div class="card mb-4"><div class="card-header"><div><strong>Delivery Action</strong><div class="small text-muted"></div></div><span class="badge text-bg-light border"><%= plans.length %> actions</span></div><div class="card-body border-bottom"><input id="distributionPlanSearch" class="form-control" placeholder="Search customer or batch…"></div><div class="table-responsive"><table id="distributionPlanTable" class="table table-hover align-middle mb-0"><thead><tr><th>Customer</th><th>Batch</th><th>Leadpot Code</th><th>Activity</th><th>Status</th><th>Action</th></tr></thead><tbody><% if(!plans.length){ %><tr><td colspan="6" class="text-center text-muted py-4">No delivery actions available.</td></tr><% } %><% plans.forEach(p=>{ %><tr data-plan-search="<%= ((p.hospital_name||'')+' '+(p.production_batch_id||'')).toLowerCase() %>"><td><%= p.hospital_name %></td><td><code><%= p.production_batch_id||'—' %></code></td><td><%= p.asset_code||'Not assigned' %></td><td><%= p.allocated_mci||'—' %> mCi</td><td><span class="badge bg-light text-dark border"><%= p.status %></span></td><td><button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createDoModal-<%= p.id %>"><i class="bi bi-truck me-1"></i>Create Delivery</button></td></tr><% }) %></tbody></table></div></div>
<% plans.forEach(p=>{ %><div class="modal fade" id="createDoModal-<%= p.id %>" tabindex="-1" aria-labelledby="createDoModalLabel-<%= p.id %>" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><form method="POST" action="/erp/distribution/create-do"><div class="modal-header"><h5 class="modal-title fw-bold" id="createDoModalLabel-<%= p.id %>">Create Delivery</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><input type="hidden" name="dispatch_plan_id" value="<%= p.id %>"><div class="row g-3"><div class="col-md-6"><label class="form-label">Leadpot Code *</label><input name="leadpot_code" class="form-control" list="leadpotCodes-<%= p.id %>" value="<%= p.asset_code||'' %>" placeholder="Enter Leadpot Code" required><datalist id="leadpotCodes-<%= p.id %>"><% assets.forEach(a=>{ %><option value="<%= a.asset_code %>"><%= a.name %> · <%= a.status %></option><% }) %></datalist></div><div class="col-md-6"><label class="form-label">Driver</label><select name="driver_user_id" class="form-select"><option value="">Assign later</option><% users.forEach(u=>{ %><option value="<%= u.id %>"><%= u.full_name %> · <%= u.role %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Vehicle ID</label><input name="vehicle_code" class="form-control" placeholder="Vehicle ID"></div><div class="col-md-6"><label class="form-label">Route</label><input name="route_code" class="form-control" placeholder="Route name"></div><div class="col-md-6"><label class="form-label">Calibration Date/Time</label><input type="datetime-local" name="calibration_datetime" class="form-control"></div><div class="col-md-6"><label class="form-label">Expiry Date/Time</label><input type="datetime-local" name="expiry_datetime" class="form-control"></div><div class="col-md-4"><label class="form-label">Packaging Category</label><select name="packaging_category" class="form-select"><option>I-White</option><option selected>II-Yellow</option><option>III-Yellow</option></select></div><div class="col-md-4"><label class="form-label">Transport Index (TI)</label><input name="transport_index" class="form-control" inputmode="decimal"></div><div class="col-md-4"><label class="form-label">Surface Dose Rate</label><input name="surface_dose_rate" class="form-control" inputmode="decimal"></div></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>Save Delivery</button></div></form></div></div></div><% }) %>
<div class="card mb-4"><div class="card-header"><div><strong>Delivery Register</strong><div class="small text-muted"><%= deliveries.length %> records · </div></div><span class="badge text-bg-light border">Delivery Workflow</span></div><div class="card-body border-bottom"><div class="row g-2"><div class="col-md-8"><input id="distributionDoSearch" class="form-control" placeholder="Search batch, customer, driver, or vehicle…"></div><div class="col-md-4"><select id="distributionDoStatus" class="form-select"><option value="">All statuses</option><% [...new Set(deliveries.map(d=>d.status))].sort().forEach(st=>{ %><option value="<%= st %>"><%= st %></option><% }) %></select></div></div></div><div class="table-responsive"><table id="distributionDoTable" class="table table-hover align-middle mb-0"><thead><tr><th>Customer / Created</th><th>Batch</th><th>Leadpot / Vehicle</th><th>Driver / Route</th><th>Seal</th><th>Status</th><th>Action</th></tr></thead><tbody><% if(!deliveries.length){ %><tr><td colspan="7" class="text-center text-muted py-4">No deliveries created yet.</td></tr><% } %><% deliveries.forEach(d=>{ %><tr data-do-search="<%= (d.do_number+' '+d.batch_id+' '+d.hospital_name+' '+d.leadpot_code+' '+(d.vehicle_code||'')+' '+((users.find(u=>Number(u.id)===Number(d.driver_user_id))||{}).full_name||'')).toLowerCase() %>" data-do-status="<%= d.status %>"><td><div class="fw-semibold"><%= d.hospital_name %></div><small class="text-muted"><%= new Date(d.created_at).toLocaleString('en-GB') %></small><a class="d-block small" target="_blank" href="/erp/distribution/<%= d.id %>/print">Print Delivery Details</a></td><td><code><%= d.batch_id %></code></td><td><%= d.leadpot_code %><small class="d-block text-muted"><%= d.vehicle_code||'Vehicle not assigned' %></small></td><td><%= (users.find(u=>Number(u.id)===Number(d.driver_user_id))||{}).full_name||'Unassigned' %><small class="d-block text-muted"><%= d.route_code||'—' %></small></td><td><%= d.seal_number||'—' %></td><td><span class="badge <%= d.status==='CLOSED'?'bg-success':d.status==='IN_TRANSIT'?'bg-primary':d.status==='DELIVERED'?'bg-info text-dark':d.status==='RADIATION_CHECK'?'bg-warning text-dark':'bg-secondary' %>"><%= d.status %></span><small class="d-block text-muted mt-1">Fleet: <%= d.readiness_status||'NOT_RECORDED' %></small></td><td style="min-width:300px">
<% if(['DRAFT','RADIATION_CHECK'].includes(d.status)){ %>
<details class="mb-2"><summary class="small fw-bold text-success">Internal Product Handover</summary><form method="POST" action="/erp/distribution/<%= d.id %>/handover" class="border rounded p-2 mt-2"><div class="small text-muted mb-2">Complete all handover checks before dispatch.</div><% [['product_in_primary_shield','Product is secured inside the primary radiation-shielding container'],['shield_condition_good','Radiation-shielding package is intact and undamaged'],['shielding_lid_secure','Close wadah pelindung radiasi terpasang rapat']].forEach(x=>{ %><div class="form-check"><input class="form-check-input" type="checkbox" name="<%= x[0] %>" id="hand_<%= d.id %>_<%= x[0] %>" <%= d.payload&&d.payload.internal_handover&&d.payload.internal_handover[x[0]]?'checked':'' %>><label class="form-check-label small" for="hand_<%= d.id %>_<%= x[0] %>"><%= x[1] %></label></div><% }) %><button class="btn btn-sm btn-success mt-2">Save handover check</button></form></details>
<details class="mb-2"><summary class="small fw-bold text-warning">Pre-departure fleet & driver checklist</summary><form method="POST" action="/erp/distribution/<%= d.id %>/readiness" class="border rounded p-2 mt-2"><div class="row g-2"><div class="col-12"><label class="form-label small">Assigned driver *</label><select name="driver_user_id" class="form-select form-select-sm" required><option value="">Choose driver</option><% users.forEach(u=>{ %><option value="<%= u.id %>" <%= Number(u.id)===Number(d.driver_user_id)?'selected':'' %>><%= u.full_name %> · <%= u.role %></option><% }) %></select></div><div class="col-6"><label class="form-label small">Vehicle ID *</label><input name="vehicle_code" class="form-control form-control-sm" value="<%= d.vehicle_code||'' %>" required></div><div class="col-6"><label class="form-label small">Route *</label><input name="route_code" class="form-control form-control-sm" value="<%= d.route_code||'' %>" placeholder="Route 1/2/3" required></div><div class="col-6"><label class="form-label small">Personal dosimeter ID *</label><input name="dosimeter_id" class="form-control form-control-sm" value="<%= d.dosimeter_id||'' %>" required></div><div class="col-6"><label class="form-label small">Dosimeter calibration due *</label><input type="date" name="dosimeter_calibration_due" class="form-control form-control-sm" value="<%= d.dosimeter_calibration_due?String(d.dosimeter_calibration_due).slice(0,10):'' %>" required></div><div class="col-12 small text-muted">All pre-departure items must pass before dispatch.</div><% [['brakes','Fungsi rem depan dan belakang'],['tire_pressure','Main and spare tire pressure'],['lights','Headlights, brake lights, and turn signals'],['fuel','Fuel is sufficient for the assigned route'],['ac_cargo','Cabin and cargo AC is functional'],['cargo_cleanliness','Rear cargo area is clean'],['double_lock','Cargo door double-lock system works'],['cargo_seatbelt','Cargo seat belt is available and serviceable'],['gps','Location tracking device is active'],['apar','Fire extinguisher is ready for use'],['first_aid','First-aid kit is available'],['spill_kit','Radiation spill kit is complete'],['dosimeter','Driver pocket dosimeter is worn and active']].forEach(x=>{ %><div class="col-6"><div class="form-check"><input class="form-check-input" type="checkbox" name="check_<%= x[0] %>" id="fleet_<%= d.id %>_<%= x[0] %>"><label class="form-check-label small" for="fleet_<%= d.id %>_<%= x[0] %>"><%= x[1] %></label></div></div><% }) %><div class="col-12"><textarea name="review_note" class="form-control form-control-sm" placeholder="Inspection note / exception"></textarea></div><div class="col-12"><button class="btn btn-sm btn-warning">Save pre-departure checklist</button></div></div></form></details>
<details class="mb-2"><summary class="small fw-bold text-primary">Record Radiation Measurement</summary><form method="POST" action="/erp/distribution/<%= d.id %>/measurement" class="border rounded p-2 mt-2"><div class="row g-2"><div class="col-8"><label class="form-label small">Survey meter ID</label><input name="instrument_id" class="form-control form-control-sm" required></div><div class="col-4"><label class="form-label small">Unit</label><select name="unit" class="form-select form-select-sm" required><option value="µSv/h">µSv/h</option><option value="mSv/h">mSv/h</option><option value="other">Other</option></select></div><div class="col-6"><label class="form-label small">Calibration due</label><input type="date" name="calibration_due" class="form-control form-control-sm" required></div><% [['background_rate','Background'],['surface_front','Surface front'],['surface_back','Surface back'],['surface_left','Surface left'],['surface_right','Surface right'],['rate_at_one_meter','Rate at 1 m']].forEach(f=>{ %><div class="col-6"><label class="form-label small"><%= f[1] %></label><input type="number" step="any" min="0" name="<%= f[0] %>" class="form-control form-control-sm" required></div><% }) %><div class="col-12"><textarea name="notes" class="form-control form-control-sm" placeholder="Measurement context / survey reference"></textarea></div></div><button class="btn btn-sm btn-outline-primary mt-2">Save measurement</button></form></details>
<details class="mb-2"><summary class="small fw-bold text-warning">Verify latest measurement (different user)</summary><form method="POST" action="/erp/distribution/<%= d.id %>/verify-measurement" class="border rounded p-2 mt-2"><label class="form-label small">Verifier PIN</label><input type="password" name="pin" class="form-control form-control-sm mb-2" required><button class="btn btn-sm btn-warning">Verify measurement</button></form></details>
<details><summary class="small fw-bold text-success">Dispatch / record seal</summary><form method="POST" action="/erp/distribution/<%= d.id %>/dispatch" class="border rounded p-2 mt-2"><label class="form-label small">Tamper-evident seal number</label><input name="seal_number" class="form-control form-control-sm mb-2" required><button class="btn btn-sm btn-success">Dispatch (hard-gated)</button></form></details>
<% } else if(d.status==='IN_TRANSIT'){ %><details class="mb-2"><summary class="small fw-bold text-success">Proof of delivery</summary><form method="POST" action="/erp/distribution/<%= d.id %>/pod" class="border rounded p-2 mt-2"><label class="form-label small">Receiver Name</label><input name="receiver_name" class="form-control form-control-sm mb-2" required><label class="form-label small">Receiver Role</label><input name="receiver_role" class="form-control form-control-sm mb-2"><label class="form-label small">Delivery Outcome</label><select name="outcome" class="form-select form-select-sm mb-2"><option value="DELIVERED">Delivered intact</option><option value="PARTIAL">Partial delivery</option><option value="DAMAGED">Damaged / exception</option></select><label class="form-label small">Receiver Acknowledgement</label><input name="receiver_signature_text" class="form-control form-control-sm mb-2" placeholder="Receiver typed name / approved acknowledgement ref" required><textarea name="notes" class="form-control form-control-sm mb-2" placeholder="Delivery Notes"></textarea><button class="btn btn-sm btn-success">Confirm Delivery</button></form></details><a class="btn btn-sm btn-outline-primary" href="/driver/mobile">Live Tracking App</a>
<% } else if(['DELIVERED','DELIVERY_EXCEPTION','RETURN_PENDING'].includes(d.status)){ %><details><summary class="small fw-bold text-primary">Leadpot Return</summary><form method="POST" action="/erp/distribution/<%= d.id %>/return" class="border rounded p-2 mt-2"><label class="form-label small">Returned Leadpot Code</label><input name="item_code" class="form-control form-control-sm mb-2" value="<%= d.leadpot_code %>" required><label class="form-label small">Condition</label><select name="condition_status" class="form-select form-select-sm mb-2"><option value="GOOD">GOOD — return to available</option><option value="INSPECT">INSPECT — maintenance review</option><option value="QUARANTINE">QUARANTINE</option><option value="DAMAGED">DAMAGED</option></select><textarea name="notes" class="form-control form-control-sm mb-2" placeholder="Inspection / return notes"></textarea><button class="btn btn-sm btn-primary">Record Return</button></form></details><% } else { %><span class="text-muted small">No action required.</span><% } %>
</td></tr><% }) %></tbody></table></div></div>
<div class="row g-4"><div class="col-xl-6"><div class="card h-100"><div class="card-header"><strong>Latest driver locations</strong><a class="btn btn-sm btn-outline-primary" href="/driver/mobile">Open Live Tracking</a></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Customer / Batch</th><th>Coordinates</th><th>Accuracy</th><th>Last Updated</th></tr></thead><tbody><% if(!locations.length){ %><tr><td colspan="4" class="text-muted text-center py-3">No GPS data yet. The assigned driver must start location sharing on a phone.</td></tr><% } %><% locations.forEach(l=>{ %><tr><td><%= l.hospital_name %><small class="d-block text-muted"><%= l.batch_id %></small></td><td><a target="_blank" href="https://maps.google.com/?q=<%= l.latitude %>,<%= l.longitude %>"><%= l.latitude %>, <%= l.longitude %></a></td><td><%= l.accuracy_m||'—' %> m</td><td><%= new Date(l.server_received_at).toLocaleString('en-GB') %></td></tr><% }) %></tbody></table></div></div></div>
<div class="col-xl-6"><div class="card h-100"><div class="card-header"><strong>Recent Verified Radiation Measurements</strong></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Customer / Batch</th><th>Meter</th><th>1m rate</th><th>Status</th><th>Verifier</th></tr></thead><tbody><% if(!measurements.length){ %><tr><td colspan="5" class="text-muted text-center py-3">No measurements recorded.</td></tr><% } %><% measurements.forEach(m=>{ %><tr><td><%= m.hospital_name %><small class="d-block text-muted"><%= m.batch_id %></small></td><td><%= m.instrument_id %><small class="d-block text-muted">Cal due: <%= m.calibration_due||'Not entered' %></small></td><td><%= m.rate_at_one_meter %> <%= m.unit %></td><td><span class="badge <%= m.status==='VERIFIED'?'bg-success':'bg-warning text-dark' %>"><%= m.status %></span></td><td><%= m.verified_by||'Awaiting verifier' %></td></tr><% }) %></tbody></table></div></div></div></div>
<div class="card mt-4"><div class="card-header"><strong>Delivery Confirmation & Return History</strong></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Customer / Batch</th><th>Receiver</th><th>Received at</th><th>Outcome</th><th>Return item</th><th>Return condition</th></tr></thead><tbody><% if(!pod.length&&!returns.length){ %><tr><td colspan="6" class="text-center text-muted py-3">No delivery confirmations or returns recorded.</td></tr><% } %><% pod.forEach(p=>{const rr=returns.filter(r=>Number(r.delivery_order_id)===Number(p.delivery_order_id));const related=deliveries.find(d=>Number(d.id)===Number(p.delivery_order_id)); %><tr><td><%= related?related.hospital_name:"—" %><small class="d-block text-muted"><%= related?related.batch_id:"—" %></small></td><td><%= p.receiver_name %><small class="d-block text-muted"><%= p.receiver_role||'' %></small></td><td><%= new Date(p.received_at).toLocaleString('en-GB') %></td><td><%= p.outcome %></td><td><%= rr.map(r=>r.item_code).join(', ')||'Pending' %></td><td><%= rr.map(r=>r.condition_status).join(', ')||'—' %></td></tr><% }) %></tbody></table></div></div>
</main></div><script>document.addEventListener('DOMContentLoaded',()=>{const ps=document.getElementById('distributionPlanSearch');ps?.addEventListener('input',()=>{const q=ps.value.toLowerCase().trim();document.querySelectorAll('#distributionPlanTable tbody tr[data-plan-search]').forEach(r=>r.hidden=!r.dataset.planSearch.includes(q));});const s=document.getElementById('distributionDoSearch'),f=document.getElementById('distributionDoStatus');function apply(){const q=(s?.value||'').toLowerCase().trim(),st=f?.value||'';document.querySelectorAll('#distributionDoTable tbody tr[data-do-search]').forEach(r=>r.hidden=!(r.dataset.doSearch.includes(q)&&(!st||r.dataset.doStatus===st)));}s?.addEventListener('input',apply);f?.addEventListener('change',apply);});</script><%- include('../partials/footer') %>
